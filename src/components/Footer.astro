---
import Button from './Button.astro';
import NapBlock from './NapBlock.astro';
import { business } from '../config/business';
import { serviceLinks, primaryNav, areaLinks, CTA_LABEL } from '../config/nav';

const year = 2026;
---

<footer class="bg-espresso text-porcelain">
  <div class="wrap grid gap-14 pt-[112px] pb-16 md:grid-cols-[1.2fr_1fr_1fr_1fr] md:pt-[176px]">
    <div>
      <p class="font-display text-[1.5rem] uppercase tracking-[0.14em]">{business.shortName}</p>
      <Button href={business.bookingUrl} external class="mt-9">{CTA_LABEL}</Button>
    </div>

    <div>
      <p class="t-eyebrow text-porcelain/60">Visit</p>
      <div class="mt-5">
        <NapBlock tone="dark" showCancellation />
      </div>
    </div>

    <div>
      <p class="t-eyebrow text-porcelain/60">Treatments</p>
      <ul class="m-0 mt-5 list-none p-0">
        {
          serviceLinks.map((t) => (
            <li>
              <a href={t.href} class="t-body block py-1 hover:text-blush">
                {t.label}
              </a>
            </li>
          ))
        }
      </ul>

      <p class="t-eyebrow mt-10 text-porcelain/60">More</p>
      <ul class="m-0 mt-5 list-none p-0">
        {
          primaryNav.map((n) => (
            <li>
              <a href={n.href} class="t-body block py-1 hover:text-blush">
                {n.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={business.instagram.url}
            target="_blank"
            rel="noopener"
            class="t-body block py-1 hover:text-blush"
          >
            Instagram {business.instagram.handle}
          </a>
        </li>
      </ul>
    </div>

    <div>
      <p class="t-eyebrow text-porcelain/60">Areas we serve</p>
      <ul class="m-0 mt-5 list-none p-0">
        <li>
          <a href="/service-areas/" class="t-body block py-1 hover:text-blush font-medium">
            All areas in San Diego County
          </a>
        </li>
        {
          areaLinks.map((a) => (
            <li>
              <a href={a.href} class="t-body block py-1 hover:text-blush">
                {a.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="wrap border-t border-porcelain/15 py-8 pb-[76px] sm:pb-8">
    <p class="t-meta text-porcelain/50">
      © {year} {business.name} · Black-owned, {business.address.neighborhood}, San Diego
    </p>
    {/* The legal row. The reference site ends its footer the same way — a
        disclosure block, then privacy, terms and a sitemap link. Ours carries
        the studio's scope of practice rather than a referral disclaimer,
        because the thing a reader actually needs to know before booking is
        that this is a facial spa and not a medical practice. */}
    <p class="t-body mt-5 max-w-[64ch] text-[0.9375rem] text-porcelain/70">
      KIAMO Skin is a facial spa, not a medical practice. Every treatment is
      performed by {business.ownerName}, a California licensed esthetician. Booking is a
      request — appointments are confirmed by the studio rather than held automatically.
    </p>
    <p class="t-meta mt-5 text-porcelain/50">
      <a href="/privacy/" class="transition-colors hover:text-porcelain">Privacy</a>
      <span aria-hidden="true" class="mx-2">·</span>
      <a href="/terms/" class="transition-colors hover:text-porcelain">Terms</a>
    </p>
  </div>
</footer>
