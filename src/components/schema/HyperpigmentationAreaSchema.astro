---
import type { HyperpigmentationArea } from '../../data/hyperpigmentation-areas';
import { business } from '../../config/business';

interface Props {
  area: HyperpigmentationArea;
}

const { area } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${Astro.site}hyperpigmentation-treatment/${area.slug}/#local-business`,
  name: business.name,
  url: `${Astro.site}hyperpigmentation-treatment/${area.slug}/`,
  logo: `${Astro.site}logo.png`,
  image: [
    `${Astro.site}studio-interior-1x1.jpg`,
    `${Astro.site}studio-interior-4x3.jpg`,
    `${Astro.site}studio-interior-16x9.jpg`,
  ],
  description: area.schemaDescription,
  telephone: business.phone.href.replace('tel:', ''),
  email: business.email,
  priceRange: business.priceRange,
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.address.street,
    addressLocality: business.address.city,
    addressRegion: business.address.region,
    postalCode: business.address.postalCode,
    addressCountry: business.address.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: business.geo.latitude,
    longitude: business.geo.longitude,
  },
  areaServed: {
    '@type': 'GeoCircle',
    geoMidpoint: {
      '@type': 'GeoCoordinates',
      latitude: area.geo.latitude,
      longitude: area.geo.longitude,
    },
    geoRadius: area.geoRadius,
    name: `${area.name}, San Diego, CA`,
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'San Diego',
      addressRegion: 'CA',
      postalCode: area.postalCodes.join(', '),
      addressCountry: 'US',
    },
  },
  hasMap: `https://maps.google.com/?cid=${business.gbpPlaceId}`,
  sameAs: [
    business.instagram.url,
    business.yelpUrl,
    business.bookingUrl,
  ],
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
    opens: '09:00',
    closes: '18:00',
  },
  currenciesAccepted: 'USD',
  paymentAccepted: 'Cash, Credit Card, Debit Card',
  founder: {
    '@type': 'Person',
    '@id': `${Astro.site}#founder`,
    name: business.ownerName,
    jobTitle: 'Licensed Esthetician',
    hasCredential: {
      '@type': 'EducationalOccupationalCredential',
      credentialCategory: 'license',
      name: 'California Licensed Esthetician',
      recognizedBy: {
        '@type': 'Organization',
        name: 'California Board of Barbering & Cosmetology',
      },
    },
    knowsAbout: [
      'Hyperpigmentation correction',
      'Melasma treatment',
      'Post-inflammatory hyperpigmentation',
      'Chemical peels for all skin types',
      'Microchanneling',
      'Corrective skin treatments',
    ],
  },
  knowsAbout: [
    'Hyperpigmentation treatment',
    'Melasma correction',
    'Dark spot removal',
    'Chemical peels',
    'Microchanneling',
    'Fitzpatrick typing',
    'Progressive pigmentation protocols',
  ],
  makesOffer: {
    '@type': 'Offer',
    itemOffered: {
      '@type': 'Service',
      name: `Hyperpigmentation Treatment in ${area.name}`,
      description: area.schemaDescription,
      provider: {
        '@id': `${Astro.site}hyperpigmentation-treatment/${area.slug}/#local-business`,
      },
      areaServed: {
        '@type': 'City',
        name: area.name,
        containedIn: {
          '@type': 'City',
          name: 'San Diego',
          containedIn: 'California',
        },
      },
      serviceType: 'Hyperpigmentation Treatment',
    },
    priceRange: '$199-$475',
    priceCurrency: 'USD',
  },
  potentialAction: {
    '@type': 'ReserveAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: business.bookingUrl,
      inLanguage: 'en-US',
      actionPlatform: [
        'http://schema.org/DesktopWebPlatform',
        'http://schema.org/IOSPlatform',
        'http://schema.org/AndroidPlatform',
      ],
    },
    result: {
      '@type': 'Reservation',
      name: `Hyperpigmentation Treatment Appointment in ${area.name}`,
    },
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
