---
import { business, verifiedPrices } from '../../config/business';
import { absolute, businessId, websiteId, gbpListingUrl } from '../../config/urls';
import ogImage from '../../assets/studio-interior.jpg';

const site = Astro.site;
const entityId = businessId(site);
const home = absolute('/', site);

/** Every service carries a price except DMK Level 2 & 3, which is prescribed at
    consultation. It is still listed so the catalogue is complete. */
const services = [
  { name: 'First-Time Client Treatment', url: 'treatments/hydrafacial', priced: 'first-time-client' },
  { name: 'HydraFacial Treatment', url: 'treatments/hydrafacial', priced: 'hydrafacial' },
  { name: 'Dermaplane Facial', url: 'treatments/dermaplaning', priced: 'dermaplane-facial' },
  { name: 'DMK Level 1 Enzyme Treatment', url: 'treatments/dmk-enzyme-therapy', priced: 'dmk-enzyme-1' },
  { name: 'LIRA Gentle Renewal Peel', url: 'treatments/lira-peels', priced: 'lira-light-peel' },
  { name: 'Keravive Scalp Treatment', url: 'treatments/keravive-scalp', priced: 'keravive-scalp' },
  { name: 'Procell Microchanneling', url: 'treatments/procell-microchanneling', priced: 'procell' },
  { name: 'LIRA Advanced Peel', url: 'treatments/lira-peels', priced: 'lira-advanced-peel' },
  { name: 'DMK Level 2 & 3 Enzyme Treatment', url: 'treatments/dmk-enzyme-therapy', priced: null },
] as const;

const schema = {
  '@context': 'https://schema.org',
  // MedicalBusiness dropped per schema-blocks.md: a licensed esthetician is not
  // a medical provider, and the mis-type invites YMYL scrutiny. LocalBusiness is
  // kept as the supertype the guard suite asserts on.
  '@type': ['LocalBusiness', 'HealthAndBeautyBusiness', 'DaySpa'],
  '@id': entityId,
  name: business.name,
  description:
    'Corrective facials and scalp therapy for acne, scarring and pigmentation, specialising in melanin-rich skin and barrier health.',
  url: home,
  image: new URL(ogImage.src, site).href,
  telephone: business.phone.display,
  email: business.email,
  priceRange: business.priceRange,
  currenciesAccepted: 'USD',
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.address.street,
    addressLocality: business.address.city,
    addressRegion: business.address.region,
    postalCode: business.address.postalCode,
    addressCountry: business.address.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: business.geo.latitude,
    longitude: business.geo.longitude,
  },
  // Ties the on-site entity to the Google Business Profile that ranks in the
  // local pack. Both resolve to the same verified place ID.
  hasMap: gbpListingUrl(business.gbpPlaceId),
  slogan: 'Strategy, correction, intention.',
  // Topics the studio is actually qualified on — the services it performs and
  // the conditions it treats. Nothing here is a claim the site does not already
  // make in prose.
  knowsAbout: [
    'Corrective facials',
    'HydraFacial',
    'HydraFacial Keravive scalp therapy',
    'DMK enzyme therapy',
    'Procell microchanneling',
    'Chemical peels',
    'Dermaplaning',
    'Acne treatment',
    'Acne scarring',
    'Hyperpigmentation',
    'Melasma',
    'Post-inflammatory hyperpigmentation',
    'Skin barrier repair',
    'Melanin-rich skin',
  ],
  founder: {
    '@type': 'Person',
    // First name only, and no pronouns anywhere: a surname was never verified
    // and the guard suite fails the build on either.
    name: business.ownerName,
    jobTitle: 'Licensed Esthetician',
    worksFor: { '@id': entityId },
  },
  areaServed: business.areaServed.map((name) => ({ '@type': 'Place', name })),
  // Vagaro is request-based; this is the request entry point, not instant booking.
  potentialAction: {
    '@type': 'ReserveAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: business.bookingUrl,
      actionPlatform: [
        'http://schema.org/DesktopWebPlatform',
        'http://schema.org/MobileWebPlatform',
      ],
    },
    result: { '@type': 'Reservation', name: 'Appointment request' },
  },
  sameAs: [
    business.instagram.url,
    business.bookingUrl,
    business.yelpUrl,
    gbpListingUrl(business.gbpPlaceId),
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Treatments',
    itemListElement: services.map((s) => {
      const itemOffered = {
        '@type': 'Service',
        name: s.name,
        url: absolute(s.url, site),
        provider: { '@id': entityId },
      };
      if (!s.priced) return { '@type': 'Offer', itemOffered };
      return {
        '@type': 'Offer',
        price: verifiedPrices[s.priced].replace('$', ''),
        priceCurrency: 'USD',
        itemOffered,
      };
    }),
  },
  // NOTE: no aggregateRating (spec §2), no openingHoursSpecification (unverified).
};

/**
 * Separate block, not an @graph: the guard suite parses each JSON-LD script's
 * top-level @type to verify the NAP, and wrapping these in a graph would hide it.
 * No SearchAction — the site has no search endpoint and declaring one is a lie.
 */
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': websiteId(site),
  url: home,
  name: business.name,
  description: 'Corrective facials and scalp therapy in Mission Hills, San Diego.',
  publisher: { '@id': entityId },
  inLanguage: 'en-US',
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(website)} />
