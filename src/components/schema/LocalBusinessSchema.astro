---
import { business, verifiedPrices } from '../../config/business';
import { absolute, businessId, websiteId, gbpListingUrl, servicePath } from '../../config/urls';
import { services } from '../../data/services';
import ogImage from '../../assets/kiamo-skin-studio-mission-hills-san-diego.jpg';

const site = Astro.site;
const entityId = businessId(site);
const home = absolute('/', site);

/**
 * Every service carries a price except DMK Level 2 & 3, which is prescribed at
 * consultation. It is still listed so the catalogue is complete.
 *
 * The prices come from `verifiedPrices` and the URLs from the service
 * registry, so the catalogue cannot drift from the pages it describes.
 */
const catalogue = [
  { name: 'First-Time Client Treatment', service: 'hydrafacial', priced: 'first-time-client' },
  { name: 'HydraFacial Treatment', service: 'hydrafacial', priced: 'hydrafacial' },
  { name: 'Dermaplane Facial', service: 'dermaplaning', priced: 'dermaplane-facial' },
  { name: 'DMK Level 1 Enzyme Treatment', service: 'dmk-enzyme-therapy', priced: 'dmk-enzyme-1' },
  { name: 'LIRA Gentle Renewal Peel', service: 'chemical-peel', priced: 'lira-light-peel' },
  { name: 'Keravive Scalp Treatment', service: 'scalp-therapy', priced: 'keravive-scalp' },
  { name: 'Procell Microchanneling', service: 'microneedling', priced: 'procell' },
  { name: 'LIRA Advanced Peel', service: 'chemical-peel', priced: 'lira-advanced-peel' },
  { name: 'DMK Level 2 & 3 Enzyme Treatment', service: 'dmk-enzyme-therapy', priced: null },
  /** Package totals for the series of three, not per-session rates. */
  { name: 'Procell Microchanneling — Series of Three', service: 'microneedling', priced: 'procell-series' },
  { name: 'Keravive Scalp Treatment — Series of Three', service: 'scalp-therapy', priced: 'keravive-scalp-series' },
] as const;

/**
 * The service → body-location map.
 *
 * A HydraFacial for the scalp is a different treatment from one for the face,
 * and the schema says so. Everything else is a facial.
 */
const bodyLocation: Record<string, string> = {
  'scalp-therapy': 'Scalp',
};

const serviceUrl = (slug: string) => absolute(servicePath(slug), site);

const schema = {
  '@context': 'https://schema.org',
  /**
   * HealthAndBeautyBusiness + DaySpa — the brief's central entity type.
   *
   * There is deliberately no `MedicalBusiness` here, and no
   * `medicalSpecialty`. The site brief rules both out by name, because the
   * studio holds no medical status: it is an esthetician studio, and its own
   * footer says so in as many words. Claiming `medicalSpecialty: Dermatology`
   * on a node whose visible copy says "not a medical practice" is the
   * structured-data/visible-content mismatch the LRA spec warns against, and
   * it is the same "med spa" framing the keyword strategy deliberately left
   * alone.
   *
   * `LocalBusiness` is kept alongside the two subtypes because it is their
   * common parent and the guard suite looks for it.
   */
  '@type': ['LocalBusiness', 'HealthAndBeautyBusiness', 'DaySpa'],
  '@id': entityId,
  name: business.name,
  additionalType: 'https://en.wikipedia.org/wiki/Day_spa',
  description:
    'Corrective facial spa in San Diego — expert facials, chemical peels, microchanneling, enzyme therapy and scalp treatments for pigmentation, melasma, acne scarring and barrier damage, safe for all skin tones including melanin-rich skin.',
  url: home,
  image: new URL(ogImage.src, site).href,
  telephone: business.phone.display,
  email: business.email,
  priceRange: business.priceRange,
  currenciesAccepted: 'USD',
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.address.street,
    addressLocality: business.address.city,
    addressRegion: business.address.region,
    postalCode: business.address.postalCode,
    addressCountry: business.address.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: business.geo.latitude,
    longitude: business.geo.longitude,
  },
  // Ties the on-site entity to the Google Business Profile that ranks in the
  // local pack. Both resolve to the same verified place ID.
  hasMap: gbpListingUrl(business.gbpPlaceId),
  slogan: 'Strategy, correction, intention.',
  // Topics the studio is actually qualified on — the services it performs and
  // the conditions it treats. Nothing here is a claim the site does not already
  // make in prose.
  knowsAbout: [
    'Corrective facials',
    'HydraFacial',
    'HydraFacial Syndeo',
    'HydraFacial Keravive scalp therapy',
    'DMK enzyme therapy',
    'Procell microchanneling',
    'Procell Therapies microchanneling',
    'Chemical peels',
    'LIRA Clinical peels',
    'Dermaplaning',
    'Acne treatment',
    'Acne scarring',
    'Hyperpigmentation',
    'Melasma',
    'Post-inflammatory hyperpigmentation',
    'Skin barrier repair',
    'Melanin-rich skin',
    'Fitzpatrick skin typing',
    'Transepidermal water loss',
  ],
  founder: {
    '@type': 'Person',
    // First name only, and no pronouns anywhere: a surname was never verified
    // and the guard suite fails the build on either.
    name: business.ownerName,
    jobTitle: 'Licensed Esthetician',
    worksFor: { '@id': entityId },
    knowsAbout: [
      'Corrective facials',
      'Melanin-rich skin treatment',
      'Hyperpigmentation',
      'Post-inflammatory hyperpigmentation',
      'Fitzpatrick skin typing',
      'HydraFacial',
      'Procell Therapies microchanneling',
      'LIRA Clinical peels',
      'DMK enzyme therapy',
    ],
    hasCredential: {
      '@type': 'EducationalOccupationalCredential',
      credentialCategory: 'license',
      name: business.ownerCredential,
      // Naming the board that issued the licence is what makes the credential
      // checkable rather than decorative — a prospect can look it up.
      recognizedBy: {
        '@type': 'Organization',
        name: 'California Board of Barbering & Cosmetology',
      },
    },
  },
  /**
   * The studio's own licence, at business level. A licence is a property of
   * the business as well as of the person holding it — a studio can operate
   * under someone else's licence, and the two are not the same claim.
   */
  hasCredential: [
    {
      '@type': 'EducationalOccupationalCredential',
      credentialCategory: 'license',
      name: 'Licensed Esthetician',
      recognizedBy: {
        '@type': 'Organization',
        name: 'California Board of Barbering & Cosmetology',
      },
    },
  ],
  areaServed: business.schemaAreaServed.map((name) => ({ '@type': 'Place', name })),
  // Vagaro is request-based; this is the request entry point, not instant booking.
  potentialAction: {
    '@type': 'ReserveAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: business.bookingUrl,
      actionPlatform: [
        'http://schema.org/DesktopWebPlatform',
        'http://schema.org/IOSPlatform',
        'http://schema.org/AndroidPlatform',
      ],
    },
    result: { '@type': 'Reservation', name: 'Appointment request' },
  },
  sameAs: [
    business.instagram.url,
    business.bookingUrl,
    business.yelpUrl,
    gbpListingUrl(business.gbpPlaceId),
    'https://en.wikipedia.org/wiki/Day_spa',
  ],
  amenityFeature: [
    { '@type': 'LocationFeatureSpecification', name: 'Free parking', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'By appointment only', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Private studio', value: true },
  ],
  availableService: services.map((service) => ({
    '@type': 'MedicalProcedure',
    name: service.name,
    url: serviceUrl(service.slug),
    procedureType: 'https://schema.org/NoninvasiveProcedure',
    medicineSystem: 'https://schema.org/WesternConventional',
    bodyLocation: bodyLocation[service.slug] ?? 'Face',
    followup: service.note ?? 'Treatment plan customized at consultation',
  })),
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Treatments',
    itemListElement: catalogue.map((entry) => {
      const itemOffered = {
        '@type': 'Service',
        name: entry.name,
        url: serviceUrl(entry.service),
        provider: { '@id': entityId },
      };
      if (!entry.priced) return { '@type': 'Offer', itemOffered };
      return {
        '@type': 'Offer',
        price: verifiedPrices[entry.priced].replace('$', ''),
        priceCurrency: 'USD',
        itemOffered,
      };
    }),
  },
  makesOffer: [
    {
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: 'Hyperpigmentation Treatment',
        description:
          'Professional treatment for melasma, dark spots, and post-inflammatory hyperpigmentation using chemical peels, microchanneling, and corrective facials.',
        areaServed: business.schemaAreaServed.map((name) => ({ '@type': 'City', name })),
        provider: { '@id': entityId },
      },
      eligibleRegion: { '@type': 'State', name: 'California' },
    },
    {
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: 'Melasma Treatment',
        description:
          'Advanced melasma treatment safe for all skin tones, including melanin-rich skin. Specialized protocols for Fitzpatrick Types IV-VI.',
        areaServed: business.schemaAreaServed.map((name) => ({ '@type': 'City', name })),
        provider: { '@id': entityId },
      },
      eligibleRegion: { '@type': 'State', name: 'California' },
    },
    {
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: 'Corrective Scalp Treatment',
        description:
          'Clinical scalp therapy for dryness, irritation, and scalp health using Keravive technology. Addresses hard water buildup common in San Diego.',
        areaServed: business.schemaAreaServed.map((name) => ({ '@type': 'City', name })),
        provider: { '@id': entityId },
      },
      eligibleRegion: { '@type': 'State', name: 'California' },
    },
    {
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: 'Acne Scarring Treatment',
        description:
          'Procell microchanneling and chemical peels for acne scar correction and texture improvement. Safe protocols for melanin-rich skin.',
        areaServed: business.schemaAreaServed.map((name) => ({ '@type': 'City', name })),
        provider: { '@id': entityId },
      },
      eligibleRegion: { '@type': 'State', name: 'California' },
    },
  ],
  // NOTE: no aggregateRating (spec §2), no openingHoursSpecification (unverified).
};

/**
 * Separate block, not an @graph: the guard suite parses each JSON-LD script's
 * top-level @type to verify the NAP, and wrapping these in a graph would hide it.
 * No SearchAction — the site has no search endpoint and declaring one is a lie.
 */
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': websiteId(site),
  url: home,
  name: business.name,
  description: 'Corrective facials and scalp therapy in Mission Hills, San Diego.',
  publisher: { '@id': entityId },
  inLanguage: 'en-US',
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
<script type="application/ld+json" is:inline set:html={JSON.stringify(website)} />
