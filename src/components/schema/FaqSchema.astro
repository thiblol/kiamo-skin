---
import { faqs as homepageFaqs } from '../../data/faqs';
import type { Faq } from '../../data/faqs';

interface Props {
  /** Defaults to the shared homepage set; treatment pages pass their own. */
  faqs?: Faq[];
}

const { faqs = homepageFaqs } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
