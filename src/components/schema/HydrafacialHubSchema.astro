---
/**
 * HydrafacialHubSchema
 *
 * LocalBusiness schema for the /hydrafacial/ parent hub. Models KIAMO Skin as the
 * canonical provider and uses hasOfferCatalog to enumerate every neighborhood
 * subpage as a referenced child Service. This turns the hub into a knowledge-graph
 * root for AI citation systems (ChatGPT, Perplexity, Google AI Overview).
 *
 * Mirrors the structure of HydrafacialAreaSchema so reviewers can diff them line
 * for line; the differences are intentional:
 *   - url / @id anchor to /hydrafacial/ (the hub), not to a single area
 *   - areaServed is an array of every neighborhood served, not a single GeoCircle
 *   - hasOfferCatalog lists all eight subpages as child Services
 */
import { hydrafacialAreas } from '../../data/hydrafacial-areas';
import { business } from '../../config/business';

const site = Astro.site;

const neighborhoods = hydrafacialAreas.map((a) => a.name);
const schemaDescription =
  'HydraFacial treatments across San Diego from KIAMO Skin in Mission Hills. ' +
  'HydraFacial Syndeo device, 45-minute sessions, safe for all Fitzpatrick I-VI skin tones. ' +
  'Licensed esthetician. Same-day appointments often available.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${site}hydrafacial/#local-business`,
  name: business.name,
  url: `${site}hydrafacial/`,
  logo: `${site}logo.png`,
  image: [
    `${site}studio-interior-1x1.jpg`,
    `${site}studio-interior-4x3.jpg`,
    `${site}studio-interior-16x9.jpg`,
  ],
  description: schemaDescription,
  telephone: business.phone.href.replace('tel:', ''),
  email: business.email,
  priceRange: business.priceRange,
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.address.street,
    addressLocality: business.address.city,
    addressRegion: business.address.region,
    postalCode: business.address.postalCode,
    addressCountry: business.address.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: business.geo.latitude,
    longitude: business.geo.longitude,
  },
  areaServed: [
    ...business.schemaAreaServed.map((name) => ({
      '@type': 'City',
      name: `${name}, San Diego, CA`,
    })),
    ...neighborhoods
      .filter((name) => !business.schemaAreaServed.includes(name))
      .map((name) => ({ '@type': 'City', name: `${name}, San Diego, CA` })),
  ],
  hasMap: `https://maps.google.com/?cid=${business.gbpPlaceId}`,
  sameAs: [business.instagram.url, business.yelpUrl, business.bookingUrl],
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
    opens: '09:00',
    closes: '18:00',
  },
  currenciesAccepted: 'USD',
  paymentAccepted: 'Cash, Credit Card, Debit Card',
  founder: {
    '@type': 'Person',
    '@id': `${site}#founder`,
    name: business.ownerName,
    jobTitle: 'Licensed Esthetician',
    hasCredential: {
      '@type': 'EducationalOccupationalCredential',
      credentialCategory: 'license',
      name: 'California Licensed Esthetician',
      recognizedBy: {
        '@type': 'Organization',
        name: 'California Board of Barbering & Cosmetology',
      },
    },
    knowsAbout: [
      'HydraFacial treatments',
      'Melanin-rich skin care',
      'Corrective skin treatments',
      'Chemical peels',
      'Microchanneling',
    ],
  },
  knowsAbout: [
    'HydraFacial Syndeo',
    'Vortex-Fusion extraction',
    'Melanin-rich skin treatments',
    'Hyperpigmentation correction',
    'Barrier repair',
    'Coastal skin care',
    'Fitzpatrick skin typing I-VI',
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'HydraFacial across San Diego neighborhoods',
    itemListElement: hydrafacialAreas.map((area) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        '@id': `${site}hydrafacial/${area.slug}/#service`,
        name: `HydraFacial in ${area.name}`,
        url: `${site}hydrafacial/${area.slug}/`,
        areaServed: {
          '@type': 'City',
          name: `${area.name}, San Diego, CA`,
          containedIn: { '@type': 'City', name: 'San Diego', containedIn: 'California' },
        },
        provider: { '@id': `${site}hydrafacial/#local-business` },
        serviceType: 'HydraFacial Treatment',
      },
      price: '259',
      priceCurrency: 'USD',
    })),
  },
  potentialAction: {
    '@type': 'ReserveAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: business.bookingUrl,
      inLanguage: 'en-US',
      actionPlatform: [
        'http://schema.org/DesktopWebPlatform',
        'http://schema.org/IOSPlatform',
        'http://schema.org/AndroidPlatform',
      ],
    },
    result: {
      '@type': 'Reservation',
      name: 'HydraFacial Appointment in San Diego',
    },
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />