---
/**
 * HyperpigmentationHubSchema
 *
 * LocalBusiness schema for the /hyperpigmentation-treatment/ parent hub.
 * Same knowledge-graph-root pattern as HydrafacialHubSchema: hasOfferCatalog
 * enumerates the seven neighborhood subpages as child Services so AI systems
 * (ChatGPT, Perplexity, Google AI Overview) can extract the hub-and-spoke
 * relationship and cite the hub as the topical authority.
 *
 * Mirrors HyperpigmentationAreaSchema so reviewers can diff them. Differences:
 *   - url / @id anchor to /hyperpigmentation-treatment/ (the hub)
 *   - areaServed is an array of every neighborhood served
 *   - hasOfferCatalog lists all seven subpages as child Services
 *   - description summarizes hyperpigmentation as a category, not a single area
 */
import { hyperpigmentationAreas } from '../../data/hyperpigmentation-areas';
import { business } from '../../config/business';

const site = Astro.site;

const neighborhoods = hyperpigmentationAreas.map((a) => a.name);
const schemaDescription =
  'Hyperpigmentation treatment across San Diego from KIAMO Skin in Mission Hills. ' +
  'Corrective protocols for melasma, post-inflammatory hyperpigmentation (PIH), and dark spots. ' +
  'Safe for all Fitzpatrick I-VI skin tones. Licensed esthetician.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${site}hyperpigmentation-treatment/#local-business`,
  name: business.name,
  url: `${site}hyperpigmentation-treatment/`,
  logo: `${site}logo.png`,
  image: [
    `${site}studio-interior-1x1.jpg`,
    `${site}studio-interior-4x3.jpg`,
    `${site}studio-interior-16x9.jpg`,
  ],
  description: schemaDescription,
  telephone: business.phone.href.replace('tel:', ''),
  email: business.email,
  priceRange: business.priceRange,
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.address.street,
    addressLocality: business.address.city,
    addressRegion: business.address.region,
    postalCode: business.address.postalCode,
    addressCountry: business.address.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: business.geo.latitude,
    longitude: business.geo.longitude,
  },
  areaServed: [
    ...business.schemaAreaServed.map((name) => ({
      '@type': 'City',
      name: `${name}, San Diego, CA`,
    })),
    ...neighborhoods
      .filter((name) => !business.schemaAreaServed.includes(name))
      .map((name) => ({ '@type': 'City', name: `${name}, San Diego, CA` })),
  ],
  hasMap: `https://maps.google.com/?cid=${business.gbpPlaceId}`,
  sameAs: [business.instagram.url, business.yelpUrl, business.bookingUrl],
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
    opens: '09:00',
    closes: '18:00',
  },
  currenciesAccepted: 'USD',
  paymentAccepted: 'Cash, Credit Card, Debit Card',
  founder: {
    '@type': 'Person',
    '@id': `${site}#founder`,
    name: business.ownerName,
    jobTitle: 'Licensed Esthetician',
    hasCredential: {
      '@type': 'EducationalOccupationalCredential',
      credentialCategory: 'license',
      name: 'California Licensed Esthetician',
      recognizedBy: {
        '@type': 'Organization',
        name: 'California Board of Barbering & Cosmetology',
      },
    },
    knowsAbout: [
      'Hyperpigmentation correction',
      'Melasma treatment',
      'Post-inflammatory hyperpigmentation',
      'Chemical peels for all skin types',
      'Microchanneling',
      'Corrective skin treatments',
    ],
  },
  knowsAbout: [
    'Hyperpigmentation treatment',
    'Melasma correction',
    'Dark spot removal',
    'Chemical peels',
    'Microchanneling',
    'Fitzpatrick typing',
    'Progressive pigmentation protocols',
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Hyperpigmentation treatment across San Diego neighborhoods',
    itemListElement: hyperpigmentationAreas.map((area) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        '@id': `${site}hyperpigmentation-treatment/${area.slug}/#service`,
        name: `Hyperpigmentation Treatment in ${area.name}`,
        url: `${site}hyperpigmentation-treatment/${area.slug}/`,
        areaServed: {
          '@type': 'City',
          name: `${area.name}, San Diego, CA`,
          containedIn: { '@type': 'City', name: 'San Diego', containedIn: 'California' },
        },
        provider: { '@id': `${site}hyperpigmentation-treatment/#local-business` },
        serviceType: 'Hyperpigmentation Treatment',
      },
      priceRange: '$199-$475',
      priceCurrency: 'USD',
    })),
  },
  potentialAction: {
    '@type': 'ReserveAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: business.bookingUrl,
      inLanguage: 'en-US',
      actionPlatform: [
        'http://schema.org/DesktopWebPlatform',
        'http://schema.org/IOSPlatform',
        'http://schema.org/AndroidPlatform',
      ],
    },
    result: {
      '@type': 'Reservation',
      name: 'Hyperpigmentation Treatment Appointment in San Diego',
    },
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />