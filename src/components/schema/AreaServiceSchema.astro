---
/**
 * Page-level Service node for an area hub.
 *
 * `/service-areas/{area}/` — "Facials in Carlsbad".
 *
 * Deliberately NOT a LocalBusiness. One studio, one business entity, mounted
 * once through BaseLayout. A second business node per area would create one
 * entity per area, which is the shape Google treats as location spam — the
 * exact reason the old cluster's area schemas were deleted.
 *
 * The node is a Service scoped to the city it targets, with an offer
 * catalogue enumerating the treatments available there. That is what lets a
 * crawler read the page as "this treatment, for this place, from this studio".
 */
import { absolute, businessId, areaPath, areaServicePath } from '../../config/urls';
import { business } from '../../config/business';
import type { AreaShell } from '../../data/service-area-types';
import { getServiceAreasForArea } from '../../data/service-areas-index';
import { services } from '../../data/services';

interface Props {
  shell: AreaShell;
}

const { shell } = Astro.props;
const site = Astro.site;
const url = absolute(areaPath(shell.slug), site);

const rows = getServiceAreasForArea(shell.slug);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${url}#service`,
  name: `Corrective facials in ${shell.name}`,
  serviceType: 'Corrective facial treatment',
  category: 'Corrective skin and scalp treatment',
  description: shell.schemaDescription,
  url,
  provider: { '@id': businessId(site) },
  areaServed: { '@type': 'Place', name: `${shell.name}, San Diego County, CA` },
  ...(rows.length > 0 && {
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: `Treatments available to ${shell.name} clients`,
      itemListElement: rows.map((record) => {
        const service = services.find((s) => s.slug === record.service);
        const price = record.pricing?.[0];
        return {
          '@type': 'Offer',
          ...(price && Number(price.price.replace(/[$,]/g, '')) > 0
            ? {
                price: price.price.replace(/[$,]/g, ''),
                priceCurrency: 'USD',
              }
            : {}),
          itemOffered: {
            '@type': 'Service',
            name: `${service?.name ?? record.service} in ${shell.name}`,
            url: absolute(areaServicePath(record.area, record.service), site),
            provider: { '@id': businessId(site) },
          },
        };
      }),
    },
  }),
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
