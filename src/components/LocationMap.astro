---
import { business } from '../config/business';

interface Props {
  /**
   * A place clients travel from, e.g. "La Jolla". Renders a route to the studio
   * instead of a pin on it. Omit for the plain place map.
   */
  origin?: string;
  aspect?: string;
  class?: string;
}

const { origin, aspect = 'aspect-4/3', class: className = '' } = Astro.props;

/* Lives in the tag, so the guard suite's tag-stripped text never sees it. A
   visible caption naming both an area and the studio would trip the Del Mar
   proximity check in test/guards.test.js. */
const title = origin
  ? `Google Map showing the route from ${origin} to ${business.name}, ${business.address.full}`
  : `Google Map showing ${business.name} at ${business.address.full}`;
---

<iframe
  id="location-map"
  src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3356.0660583279664!2d-117.17220122448629!3d32.737436573680235!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x80dc09e2032e67a3%3A0x643cf88d90708b08!2sKIAMO%20Skin%20%E2%80%93%20HydraFacial%20%26%20Scalp%20Treatments!5e0!3m2!1sen!2sin!4v1788190893814!5m2!1sen!2sin"
  title={title}
  loading="lazy"
  allowfullscreen=""
  referrerpolicy="strict-origin-when-cross-origin"
  class={`w-full border border-line ${aspect} ${className}`}></iframe>
