---
/**
 * Renders the markdown content of a GeoArticle
 *
 * This component handles the body content between the Quick Answer block
 * and the FAQ section. Content is stored as markdown strings.
 */

interface Props {
  content: string;
}

const { content } = Astro.props;
---

<div class="prose" set:html={content} />

<style>
  .prose {
    /* Base typography */
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-ink);
  }

  .prose h2 {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.3;
    margin-top: 3rem;
    margin-bottom: 1.25rem;
    color: var(--color-ink);
  }

  .prose h3 {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.4;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: var(--color-ink);
  }

  .prose p {
    margin-bottom: 1.5rem;
  }

  .prose a {
    color: var(--color-ink);
    border-bottom: 1px solid rgba(0, 0, 0, 0.3);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .prose a:hover {
    color: var(--color-rose);
    border-bottom-color: var(--color-rose);
  }

  .prose ul,
  .prose ol {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .prose li {
    margin-bottom: 0.5rem;
  }

  .prose strong {
    font-weight: 600;
  }

  .prose em {
    font-style: italic;
  }

  @media (min-width: 768px) {
    .prose {
      font-size: 1.0625rem;
    }

    .prose h2 {
      font-size: 1.75rem;
    }

    .prose h3 {
      font-size: 1.375rem;
    }
  }
</style>
