---
/**
 * VerifiedRating
 * --------------
 * The one objective signal the studio can publish: the Google Business
 * Profile rating, the review count, and the date the listing was last read.
 *
 * Why it is visible HTML and not schema:
 *   Google treats a business republishing its own reviews as self-serving,
 *   and the guard suite forbids an `aggregateRating` node outright. The
 *   figure therefore appears as text and links straight to the listing, so a
 *   reader can check every number on it by opening the profile. The count
 *   comes from the same Business Profile pull that produces the review list
 *   on /reviews, so the two cannot disagree.
 *
 * The five stars are inline SVG rather than a rating widget: no third-party
 * script, no image request, and the numeral stays readable to a screen
 * reader rather than being locked inside a graphic.
 */
import { reviewStats } from '../data/review-stats';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div
  aria-label="Google reviews"
  class={`flex flex-col items-start gap-4 rounded-lg border border-line bg-ivory p-6 ${className}`}
>
  <div class="flex items-center gap-1 text-rose" aria-hidden="true">
    {
      Array.from({ length: 5 }).map(() => (
        <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor">
          <path d="M10 1.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L10 14.9l-5.3 2.7 1-5.8L1.5 7.7l5.9-.9L10 1.5z" />
        </svg>
      ))
    }
  </div>

  <div class="flex-1">
    <p class="t-body text-[1.0625rem] font-medium leading-[1.4] text-ink">
      <span class="sr-only">Rated {reviewStats.rating} out of 5 stars.</span>
      <span aria-hidden="true" class="text-ink">{reviewStats.rating}.0</span>
      {' '}—{' '}
      <a
        href={reviewStats.reviewsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="border-b border-ink/40 pb-0.5 hover:border-rose hover:text-rose"
      >
        {reviewStats.count} five-star Google reviews
      </a>
    </p>
    <p class="t-meta mt-2 text-ink-soft">
      Verified on {reviewStats.lastVerified} · Independent of KIAMO Skin
    </p>
  </div>
</div>
