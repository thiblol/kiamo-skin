---
/**
 * The shared body of the two service page types.
 *
 *   mode="service" → /services/{service}/            "HydraFacial"
 *   mode="area"    → /service-areas/{area}/{service}/ "HydraFacial in Carlsbad"
 *
 * Why one component: the two pages answer the same question at different
 * resolutions. A service page says what the treatment is and whether it is
 * right for a client; a service-and-city page says what it is, why the drive is
 * worth it, and what the local skin concern is. Nearly every section is the
 * same section at a different resolution, and splitting them was how the four
 * old geo clusters ended up as four near-duplicate templates.
 *
 * The section order follows the reference site's anatomy — offer, proof,
 * what it addresses, what happens in the room, what it costs, questions,
 * action — with the city detail folded into each step rather than bolted on
 * as a separate block.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Reveal from './Reveal.astro';
import Button from './Button.astro';
import NapBlock from './NapBlock.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import ServiceHero from './ServiceHero.astro';
import QuickAnswer from './QuickAnswer.astro';
import FaqList from './FaqList.astro';
import PriceAnchor from './PriceAnchor.astro';
import TrustBar from './TrustBar.astro';
import ProofQuote from './ProofQuote.astro';
import TreatmentProof from './TreatmentProof.astro';
import LocationMap from './LocationMap.astro';
import { business, PRICE_ON_CONSULTATION } from '../config/business';
import { CTA_LABEL } from '../config/nav';
import { treatmentTrust } from '../data/treatment-trust';
import { getAreaTestimonials, getServiceTestimonials } from '../data/testimonials';
import { getReadingLinks } from '../data/service-reading';
import { CONTENT_REVISED, formatReviewDate } from '../data/page-dates';
import VerifiedProof from './VerifiedProof.astro';
import VerifiedRating from './VerifiedRating.astro';
import RequestBand from './sections/RequestBand.astro';
interface Crumb {
  name: string;
  path: string;
}

interface Props {
  mode: 'service' | 'area';
  title: string;
  description: string;
  h1: string;
  /** The deck under the H1. */
  opener: string;
  /** The short AI-liftable answer. */
  quickAnswer?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  resultImage?: ImageMetadata;
  resultImageAlt?: string;
  resultCaption?: string;
  /** What the service addresses. */
  concerns?: string[];
  /** The plan's steps. */
  steps?: { step: string; description?: string; body?: string }[];
  /** The pricing table. */
  pricing?: { label: string; price: string; description?: string }[];
  /**
   * The published San Diego market rate for this modality, and where this
   * studio's price sits against it.
   *
   * A price on its own is a transaction. A price placed against the
   * published rate for the same treatment in the same city is a fact, and
   * facts are what an answer engine cites.
   */
  marketRate?: {
    label: string;
    low: string;
    high: string;
    unit: string;
    position: string;
  };
  /**
   * The plan's components, for a concern page.
   *
   * A concern page — melasma, hyperpigmentation — has no single price,
   * because the plan is assembled from several modalities. It lists the
   * modalities instead. Those members were in the data all along and were
   * never rendered, which is why the two highest-volume pages on the site
   * (melasma at 60,000/mo and hyperpigmentation at 165,000/mo) carried no
   * pricing table at all.
   */
  planMembers?: { name: string; description: string; price?: string; href: string }[];
  /** The city-specific blocks. */
  authority?: { heading: string; body: string };
  uniqueness?: { heading: string; body: string; bullets: string[] };
  depth?: { heading: string; body: string };
  intent?: { heading: string; body: string };
  localConcern?: { heading: string; body: string };
  /**
   * The landmarks of the area this page is about.
   *
   * They are the real nouns of the neighbourhood — the cove, the
   * university, the village street — and they are what makes a page read as
   * being about a place rather than about a treatment with a place stapled
   * to it.
   */
  landmarks?: string[];
  /**
   * The heading over the directions block.
   *
   * "How to reach us from {city}" is the right heading when the city is
   * somewhere the reader has to drive to. It is the wrong heading for the
   * city the studio is in, where the block is about finding the door.
   */
  gettingHereHeading?: string;
  /**
   * The map to embed.
   *
   * The neighbourhood pages embed their own neighbourhood — a La Jolla page
   * with a map of La Jolla. The San Diego pages omit it and get the studio's
   * own map, because there the studio is the place.
   */
  mapPlace?: string;
  /** The long-form body. */
  body?: string;
  faqs: { question: string; answer: string }[];
  /**
   * The related guide for this treatment.
   *
   * This lived in the data file and was never rendered, so every service page
   * carried a link to a supporting article that no visitor and no crawler
   * could reach. Rendering it is what puts the service page and the journal
   * into the same cluster.
   */
  guide?: { label: string; href: string; lead: string };
  /** The trust data key — a service slug. */
  trustSlug: string;
  /** Breadcrumb trail, outermost first. */
  ancestors: Crumb[];
  current: string;
  /** The city name, for the "in {city}" headings on a service-and-city page. */
  cityName?: string;
  /** The city's slug, so the page can pull reviews attributed to that city. */
  areaSlug?: string;
  /** The sibling service pages in the same city. */
  siblingServices?: { name: string; href: string; note: string }[];
  /**
   * The clinically adjacent services, linked sideways.
   *
   * The lateral edge of the service tree. Before this, a service page only
   * linked down to its own city pages — so the eleven treatments never
   * referenced each other, and the cluster a search engine reads as
   * "this site knows corrective skin work" was never assembled anywhere a
   * reader could walk it.
   */
  relatedServices?: { name: string; href: string; note: string; price: string }[];
  /** The hero block, assembled by the page that renders this component. */
  hero: {
    eyebrow: string;
    serviceName: string;
    cityName?: string;
    claim: string;
    paragraph: string;
    image?: ImageMetadata;
    imageAlt?: string;
    price?: { label: string; price: string };
    trust: { label: string; detail?: string }[];
  };
  /** The same service in the other cities that offer it. */
  siblingCities?: { name: string; href: string; note: string }[];
}

const {
  mode,
  title,
  description,
  h1,
  opener,
  quickAnswer,
  image,
  imageAlt,
  resultImage,
  resultImageAlt,
  resultCaption,
  concerns,
  steps,
  pricing,
  marketRate,
  planMembers,
  authority,
  uniqueness,
  depth,
  intent,
  localConcern,
  landmarks,
  gettingHereHeading,
  mapPlace,
  body,
  faqs,
  guide,
  trustSlug,
  ancestors,
  current,
  cityName,
  areaSlug,
  siblingServices,
  relatedServices,
  siblingCities,
  hero,
} = Astro.props;

const isArea = mode === 'area';

/**
 * The trust claims for this service. Every service has an entry — a missed
 * one would render an empty band, which is why the guard suite checks the
 * key set against the service registry.
 */
const trust = treatmentTrust[trustSlug];

/**
 * The client voices in the trust band.
 *
 * A service-and-city page uses reviews attributed to that city, so a reader
 * in Encinitas meets an Encinitas client rather than a generic one. A
 * national service page has no city to attribute to, so it takes two general
 * reviews chosen by the service slug — which also stops eleven service pages
 * arguing for the studio in one identical voice.
 */
const proofQuotes = isArea && areaSlug ? getAreaTestimonials(areaSlug) : getServiceTestimonials(trustSlug);

/**
 * The reading this treatment raises — the comparison pieces and the notes
 * behind them. Every article on the site appears in at least one of these
 * lists, so nothing in the journal is left outside the cluster.
 */
const readingLinks = getReadingLinks(trustSlug);

/**
 * The date this page's prices and protocols were last reviewed.
 *
 * The same date the page's schema carries, so the visible claim and the
 * machine-readable one cannot drift apart.
 */
const reviewedOn = CONTENT_REVISED;

/**
 * The price rows, from whichever source this page has.
 *
 * A modality page has `pricing`. A concern page has `planMembers` instead,
 * because its plan is assembled from several modalities. Their prices may be
 * a single figure, a range, or absent — a plan with no single price reads
 * "Pricing at consultation.", which is what the site brief prescribes.
 *
 * Before this, the concern pages had a `planMembers` record and no pricing
 * section at all: the melasma page (60,000/mo) and the hyperpigmentation
 * page (165,000/mo) showed a reader no prices at all.
 */
const priceRows = pricing?.length
  ? pricing.map((row) => ({
      label: row.label,
      price: row.price,
      description: row.description,
      href: undefined as string | undefined,
    }))
  : (planMembers?.map((member) => ({
      label: member.name,
      price: member.price ?? PRICE_ON_CONSULTATION,
      description: member.description,
      href: member.href,
    })) ?? []);

/**
 * The heading on the request band.
 *
 * The band names what the page is about, so a reader who scrolls to the
 * bottom of a service-and-city page knows which treatment and which city
 * they are requesting.
 */
const bandHeading =
  isArea && cityName
    ? `${hero.serviceName} in ${cityName} — with the price before a booking is made.`
    : `${hero.serviceName} in San Diego — with the price before a booking is made.`;
---

<article>
  <ServiceHero
    eyebrow={hero.eyebrow}
    serviceName={hero.serviceName}
    cityName={hero.cityName}
    claim={hero.claim}
    paragraph={hero.paragraph}
    image={hero.image}
    imageAlt={hero.imageAlt}
    price={hero.price}
    trust={hero.trust}
  />

  {/* The trust band, directly under the hero. The hero is the offer; this is
      the reason to believe it. Keeping them apart is also what lets the hero
      fit the fold.

      The claims sit on their own full-width row, because they are three
      independent reasons and the row is what says so. The proof sits beneath
      them: the rating card, then the clients. Before, both were the studio's
      own voice — three claims and the same single quote on all forty-six of
      these pages, with the rating and the review count nowhere on them. */}
  <section class="bg-porcelain py-12 md:py-14">
    <div class="wrap">
      {trust && <TrustBar items={trust.claims} heading="Why this studio" />}
      <div class="mt-10 border-t border-line pt-9 md:mt-12 md:pt-10">
        <div class="grid gap-10 md:grid-cols-[19rem_1fr] md:items-start md:gap-14">
          <VerifiedRating />
          <VerifiedProof quotes={proofQuotes} areaName={isArea ? cityName : undefined} withRating={false} />
        </div>
      </div>
    </div>
  </section>

  {quickAnswer && (
    <section class="bg-porcelain pb-16 md:pb-20">
      <div class="wrap">
        <div class="max-w-[68ch]">
          <QuickAnswer content={quickAnswer} />
        </div>
      </div>
    </section>
  )}

  {authority && (
    <section class="bg-ivory py-20 md:py-28">
      <div class="wrap">
        <div class="max-w-[68ch]">
          <Reveal>
            <p class="t-eyebrow text-ink-soft">The approach</p>
            <h2 class="t-h2 mt-4">{authority.heading}</h2>
            <p class="t-body mt-6 leading-relaxed">{authority.body}</p>
          </Reveal>
        </div>
      </div>
    </section>
  )}

  {localConcern && (
    <section class="bg-porcelain py-20 md:py-28">
      <div class="wrap grid items-center gap-12 md:grid-cols-[1fr_0.85fr] md:gap-20">
        <div>
          <Reveal>
            <p class="t-eyebrow text-ink-soft">The local concern</p>
            <h2 class="t-h2 mt-4">{localConcern.heading}</h2>
            <p class="t-body mt-6 leading-relaxed">{localConcern.body}</p>
          </Reveal>
          {/* The landmarks. They are the real nouns of the neighbourhood, and
              they are what makes a page read as being about a place rather
              than about a treatment with a place stapled to it. */}
          {landmarks && landmarks.length > 0 && (
            <Reveal>
              <p class="t-eyebrow mt-10 text-ink-soft">
                {gettingHereHeading ?? 'Around this area'}
              </p>
              <ul class="t-body m-0 mt-4 list-none space-y-2 p-0">
                {landmarks.slice(0, 8).map((landmark) => (
                  <li class="flex gap-4">
                    <span aria-hidden="true" class="text-rose">
                      —
                    </span>
                    <span>{landmark}</span>
                  </li>
                ))}
              </ul>
            </Reveal>
          )}
        </div>
        {
          resultImage ? (
            <Reveal>
              <Image
                src={resultImage}
                alt={resultImageAlt ?? ''}
                widths={[400, 800, 1200]}
                sizes="(min-width: 840px) 40vw, 90vw"
                loading="lazy"
                class="aspect-[0.92] w-full rounded-lg object-cover"
              />
              {resultCaption && <p class="t-meta mt-4">{resultCaption}</p>}
            </Reveal>
          ) : (
            /* The area's own map, beside the local concern it explains.
               On a national service page there is no local concern and so no
               map — the treatment page is not about a place. */
            mapPlace && (
              <Reveal>
                <LocationMap place={mapPlace} id="route-map" />
              </Reveal>
            )
          )
        }
      </div>
    </section>
  )}

  {uniqueness && (
    <section class="bg-porcelain py-20 md:py-28">
      <div class="wrap">
        <div class="max-w-[68ch]">
          <Reveal>
            <p class="t-eyebrow text-ink-soft">What sets it apart</p>
            <h2 class="t-h2 mt-4">{uniqueness.heading}</h2>
            <p class="t-body mt-6 leading-relaxed">{uniqueness.body}</p>
          </Reveal>
          <ul class="t-body mt-9 m-0 list-none space-y-3 p-0">
            {
              uniqueness.bullets.map((bullet) => (
                <li class="flex gap-4">
                  <span aria-hidden="true" class="text-rose">
                    —
                  </span>
                  <span>{bullet}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>
  )}

  {depth && steps && steps.length > 0 && (
    <section class="bg-ivory py-20 md:py-28">
      <div class="wrap">
        <div class="max-w-[68ch]">
          <Reveal>
            <p class="t-eyebrow text-ink-soft">The process</p>
            <h2 class="t-h2 mt-4">{depth.heading}</h2>
            <p class="t-body mt-6 leading-relaxed">{depth.body}</p>
          </Reveal>
          <ol class="mt-12 m-0 list-none space-y-9 p-0">
            {
              steps.map((step, i) => (
                <Reveal>
                  <li class="border-t border-line pt-7">
                    <p class="t-meta text-rose">{String(i + 1).padStart(2, '0')}</p>
                    <h3 class="t-service mt-3 text-[1.125rem] md:text-[1.3125rem]">{step.step}</h3>
                    <p class="t-body mt-3 text-[0.9375rem]">
                      {step.description ?? step.body}
                    </p>
                  </li>
                </Reveal>
              ))
            }
          </ol>
        </div>
      </div>
    </section>
  )}

  {concerns && concerns.length > 0 && (
    <section class="bg-porcelain py-20 md:py-28">
      <div class="wrap">
        <div class="max-w-[68ch]">
          <Reveal>
            <p class="t-eyebrow text-ink-soft">What it addresses</p>
            <h2 class="t-h2 mt-4">
              {isArea && cityName
                ? `What clients book ${current.toLowerCase()} for in ${cityName}`
                : 'What clients book this for'}
            </h2>
            <ul class="t-body mt-7 m-0 list-none space-y-3 p-0">
              {
                concerns.map((concern) => (
                  <li class="flex gap-4">
                    <span aria-hidden="true" class="text-rose">
                      —
                    </span>
                    <span>{concern}</span>
                  </li>
                ))
              }
            </ul>
          </Reveal>
        </div>
      </div>
    </section>
  )}

  {/* The long-form body. Five of the pages carry one — the geo articles the
      old cluster published, now folded into the page they belong to rather
      than sitting on a URL of their own. */}
  {body && (
    <section class="bg-porcelain py-16 md:py-20">
      <div class="wrap">
        <div class="mx-auto max-w-[46rem]">
          <div class="article-content" set:html={body} />
        </div>
      </div>
    </section>
  )}

  {intent && (
    <section class="bg-ivory py-20 md:py-28">
      <div class="wrap">
        <div class="max-w-[68ch]">
          <Reveal>
            <p class="t-eyebrow text-ink-soft">Who books this</p>
            <h2 class="t-h2 mt-4">{intent.heading}</h2>
            <p class="t-body mt-6 leading-relaxed">{intent.body}</p>
          </Reveal>
        </div>
      </div>
    </section>
  )}

  {priceRows.length > 0 && (
    <section class="bg-porcelain py-20 md:py-28">
      <div class="wrap grid gap-12 md:grid-cols-[1fr_0.8fr] md:gap-16">
        <div>
          <h2 class="t-h2" id="pricing">
            Pricing in San Diego
          </h2>
          <p class="t-body mt-6 max-w-[58ch] leading-relaxed">
            Every price below is published before a booking is made. Nothing is quoted at the door, and the
            first visit includes the consultation that decides the plan.
          </p>
          {/* The market rate.
              A price on its own is a transaction. The same price placed
              against the published rate for the same treatment in the same
              city is a fact, and a fact is what an answer engine cites.

              The range is a third-party figure, so it carries the same
              attribution the guard suite checks everywhere else: the source
              it was read from, and the date it was read. A reader who clicks
              through lands on the directory the figure came from rather than
              on a claim this site made about itself. */}
          {marketRate && (
            <div class="mt-8 border-t border-line pt-8">
              <p class="t-service text-[1rem]">
                {marketRate.label} cost in San Diego
              </p>
              <p class="t-body mt-3 text-[0.9375rem] leading-relaxed">
                Published market rates put {marketRate.label.toLowerCase()} in San Diego at{' '}
                <span
                  data-fact-source="market-facial-rates"
                  data-fact="price"
                  data-fact-value={marketRate.low}
                >
                  {marketRate.low}
                </span>
                –<span
                  data-fact-source="market-facial-rates"
                  data-fact="price"
                  data-fact-value={marketRate.high}
                >
                  {marketRate.high}
                </span>{' '}
                {marketRate.unit}. {marketRate.position}
              </p>
              <p class="t-meta mt-4 text-ink-soft">
                Market rates published by No BS Med Spa Reviews, read 9 November 2026.{' '}
                <a
                  href="https://www.nobsmedspareviews.com/treatment/facials-in-san-diego"
                  rel="noopener"
                  target="_blank"
                  class="border-b border-ink/40 transition-colors hover:border-rose hover:text-rose"
                >
                  See the source
                </a>
              </p>
            </div>
          )}          {/* The review date.
              A published price is only worth something if somebody checked it.
              This is the date the prices, the protocols and the city detail on
              this page were last reviewed — the same date the page carries in
              its schema, so what a reader reads and what a crawler reads are
              the same claim. */}
          <p class="t-meta mt-5 text-ink-soft">
            Prices and protocols last reviewed {formatReviewDate(reviewedOn)}.
          </p>
        </div>
        <div class="border border-line bg-ivory p-8">
          <dl class="mt-0 m-0 space-y-6">
            {
              priceRows.map((row) => (
                <div class="border-b border-line pb-6 last:border-0 last:pb-0">
                  <dt class="t-service text-[1rem]">
                    {row.href ? (
                      /* A plan member links to the modality that treats it.
                         The anchor is the bare name — geo-modified anchors
                         belong on hub pages, and this is a link into the
                         service tree rather than an editorial choice. */
                      <a href={row.href} class="hover:text-rose">
                        {row.label}
                      </a>
                    ) : (
                      row.label
                    )}
                  </dt>
                  <dd class="t-price m-0 mt-2">{row.price}</dd>
                  {row.description && (
                    <dd class="t-body m-0 mt-3 text-[0.875rem] text-ink-soft">{row.description}</dd>
                  )}
                </div>
              ))
            }
          </dl>
          <div class="mt-8">
            <Button
              href={business.bookingUrl}
              external
              class="w-full"
              trackEvent="booking_click"
              eventLabel={isArea ? 'area_pricing' : 'service_pricing'}
            >
              {CTA_LABEL}
            </Button>
          </div>

          {/* On a plan page the prices above are the prices of the
              components the plan is built from. The plan itself — which
              treatments, how many sessions, how far apart — is what the
              consultation decides, and saying so keeps the page honest
              beside a list of published figures. */}
          {!pricing?.length && planMembers?.length && (
            <p class="t-body mt-6 text-[0.875rem] text-ink-soft">
              Each price above is for one treatment. The plan itself — which treatments, how many
              sessions, and how far apart — is set at consultation.
            </p>
          )}
        </div>
      </div>
    </section>
  )}

  {relatedServices && relatedServices.length > 0 && (
    <section class="bg-ivory py-20 md:py-28">
      <div class="wrap">
        <div class="max-w-[68ch]">
          <Reveal>
            <p class="t-eyebrow text-ink-soft">Also consider</p>
            <h2 class="t-h2 mt-4">Other treatments</h2>
            <p class="t-body mt-5 max-w-[58ch] leading-relaxed">
              These overlap with {hero.serviceName} often enough that a reader weighing one
              against another should see them side by side, with the price beside each one. Which
              one fits is decided at the consultation, not here.
            </p>
          </Reveal>
        </div>

        {/* A comparison table rather than a list of links. The treatment
            cluster had no table on any of its forty-six pages, and the
            table is the format an answer engine lifts cleanly: treatment,
            what it is for, price. */}
        <div class="mt-10 overflow-x-auto">
          <table class="w-full border-collapse text-left">
            <thead>
              <tr class="border-b border-line">
                <th class="t-eyebrow py-4 pr-6 align-bottom text-ink-soft">Treatment</th>
                <th class="t-eyebrow py-4 pr-6 align-bottom text-ink-soft">What it is for</th>
                <th class="t-eyebrow py-4 align-bottom text-ink-soft">Price</th>
              </tr>
            </thead>
            <tbody>
              {relatedServices.map((link) => (
                <tr class="border-b border-line align-top">
                  <td class="py-5 pr-6">
                    <a
                      href={link.href}
                      class="t-service text-[1rem] transition-colors duration-300 hover:text-rose"
                    >
                      {link.name}
                    </a>
                  </td>
                  <td class="t-body py-5 pr-6 text-[0.9375rem] text-ink-soft">{link.note}</td>
                  <td class="t-price py-5 whitespace-nowrap text-rose">{link.price}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  )}

  {/* The route prose is gone.
      It used to sit here: seventy-one words per area of turn-by-turn
      directions, headed "How to reach us from {city}", with a map that
      showed the studio pin. Three things were wrong with it at once.

      It contradicted itself — the section was about reaching the studio
      while the heading named the reader's own city, and the map beside it
      showed the studio rather than the area. It was redundant, because the
      NAP block on every page carries the address and the free parking and
      the footer carries a Google Maps directions link — so the journey was
      described three times and useful in none. And it was the wrong content
      for the page: per the GEO playbook, what an answer engine quotes is a
      self-contained answer carrying a brand and a specific fact, and
      navigation instructions give it nothing to attribute.

      The map and the landmarks moved up into the local-concern section,
      where they describe the same place the copy does, and the distance
      stays as one fact in the area's facts table. The client gets a map
      that shows their own neighbourhood and a link that opens the route.

      The route copy itself is still in the shell data — it was written for
      this and it may be wanted again — but it is no longer rendered. */}

  {/* The proof. Quick answer, published case, client quote and the risk
      reversal together, so a reader has met the studio before the questions
      and the booking form. */}
  <section class="bg-porcelain py-20 md:py-28">
    <div class="wrap">
      <div class="mx-auto max-w-[68ch]">
        <TreatmentProof slug={trustSlug} />
      </div>
    </div>
  </section>

  {faqs.length > 0 && (
    <section class="bg-ivory py-20 md:py-28">
      <div class="wrap section-y">
        <div class="max-w-[68ch]">
          <Reveal>
            <p class="t-eyebrow text-ink-soft">Before a booking is made</p>
            <h2 class="t-h2 mt-5">
              {isArea && cityName
                ? `${current} questions, answered`
                : 'Questions, answered'}
            </h2>
          </Reveal>
          {/* The questions. The first three answer in full on the page — what
              it costs, what happens, how long it takes — because they are the
              ones that stop a booking, and a reader who never clicks a
              disclosure triangle still has to meet them. The rest open on
              click, and every answer stays in the HTML and in the schema
              either way, so nothing is lost to crawlers. */}
          <div class="mt-12">
            <FaqList faqs={faqs} openFirst={3} />
          </div>
        </div>
      </div>
    </section>
  )}

  {/* The reading.

      A service page that never links out of itself is a dead end for a
      crawler and for a reader deciding whether this is the right treatment.
      It used to carry ONE hand-picked article. That is not a topic cluster —
      and it left the articles a reader actually opens next (the cost of a
      peel, the difference between a peel and microchanneling, how to tell
      one kind of dark mark from another) with nothing on the commercial half
      of the site pointing at them.

      Now it carries the reading the treatment genuinely raises: the
      comparison pieces first, because those are the pages an AI answer
      engine cites for a "best X" query, and then the notes behind them. */}
  {(readingLinks.length > 0 || guide) && (
    <section class="bg-ivory py-16 md:py-20">
      <div class="wrap">
        <div class="max-w-[68ch]">
          <Reveal>
            <p class="t-eyebrow text-ink-soft">Read next</p>
            <h2 class="t-h2 mt-4">
              {isArea && cityName
                ? `What to read before booking ${hero.serviceName}`
                : 'What to read before a booking is made'}
            </h2>
          </Reveal>

          <ul class="m-0 mt-10 grid list-none gap-x-10 gap-y-0 p-0 md:grid-cols-2">
            {readingLinks.map((link) => (
              <li class="border-b border-line">
                <a href={link.href} class="group block py-6">
                  <h3 class="t-service text-[1.0625rem] transition-colors duration-300 group-hover:text-rose md:text-[1.1875rem]">
                    {link.label}
                  </h3>
                  <p class="t-body mt-2 text-[0.9375rem] text-ink-soft">{link.note}</p>
                </a>
              </li>
            ))}
            {guide && (
              <li class="border-b border-line">
                <a href={guide.href} class="group block py-6">
                  <h3 class="t-service text-[1.0625rem] transition-colors duration-300 group-hover:text-rose md:text-[1.1875rem]">
                    {guide.label}
                  </h3>
                  <p class="t-body mt-2 text-[0.9375rem] text-ink-soft">{guide.lead}</p>
                </a>
              </li>
            )}
          </ul>
        </div>
      </div>
    </section>
  )}

  {/* The internal-link mesh.
      On a service-and-city page: the other services in this city, and the
      same service in the other cities that offer it. Between them every
      service×city page is reachable from its area hub, from its service
      page, and from its siblings — no page in the cluster is an orphan. */}
  {(siblingServices?.length || siblingCities?.length) && (
    <section class="bg-porcelain py-16 md:py-20">
      <div class="wrap section-y">
        {siblingServices && siblingServices.length > 0 && (
          <>
            <Reveal>
              <p class="t-eyebrow text-ink-soft">
                {isArea && cityName ? `Other treatments in ${cityName}` : 'Also available'}
              </p>
              <h2 class="t-h2 mt-4">
                {isArea && cityName
                  ? `Every treatment available in ${cityName}`
                  : 'Other treatments'}
              </h2>
            </Reveal>
            <ul class="m-0 mt-10 grid list-none gap-x-8 gap-y-0 p-0 md:grid-cols-2">
              {siblingServices.map((link) => (
                <li class="border-b border-line">
                  <a href={link.href} class="group block py-7">
                    <h3 class="t-service text-[1.0625rem] transition-colors duration-300 group-hover:text-rose md:text-[1.1875rem]">
                      {link.name}
                    </h3>
                    <p class="t-body mt-2 text-[0.9375rem] text-ink-soft">{link.note}</p>
                  </a>
                </li>
              ))}
            </ul>
          </>
        )}

        {siblingCities && siblingCities.length > 0 && (
          <>
            <Reveal class="mt-16 block">
              <p class="t-eyebrow text-ink-soft">Across San Diego</p>
              <h2 class="t-h2 mt-4">
                {isArea && cityName
                  ? `${current} in the other cities we serve`
                  : 'Where this treatment is available'}
              </h2>
            </Reveal>
            <ul class="m-0 mt-10 grid list-none gap-x-8 gap-y-0 p-0 md:grid-cols-2 lg:grid-cols-3">
              {siblingCities.map((link) => (
                <li class="border-b border-line">
                  <a href={link.href} class="group block py-7">
                    <h3 class="t-service text-[1.0625rem] transition-colors duration-300 group-hover:text-rose md:text-[1.1875rem]">
                      {link.name}
                    </h3>
                    <p class="t-body mt-2 text-[0.9375rem] text-ink-soft">{link.note}</p>
                  </a>
                </li>
              ))}
            </ul>
          </>
        )}
      </div>
    </section>
  )}

  <section class="bg-ivory py-16 md:py-20">
    <div class="wrap">
      <NapBlock />
    </div>
  </section>

  {/* The request. The price, the membership and the enquiry form, together.

      Measured on a service page, the body carried no "Request Appointment"
      between the hero and the pricing table — the reader who was convinced
      by the price had to keep scrolling for a button, and the only action
      above the fold was a tap-to-call chip. The band closes that gap, and
      it is where the membership finally gets a price and a link rather than
      a mention inside somebody else's review. */}
  <RequestBand
    heading={bandHeading}
    eventLabel={isArea ? 'area_band' : 'service_band'}
    defaultTreatment={hero.serviceName}
  />

  <script>
    import '../scripts/scroll-depth';
  </script>
</article>

