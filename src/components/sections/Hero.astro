---
import { getImage } from 'astro:assets';
import Button from '../Button.astro';
import heroTall from '../../assets/licensed-esthetician-melanin-rich-skin-san-diego.jpg';
import heroWide from '../../assets/kiamo-skin-esthetician-mission-hills-san-diego-hero.jpg';
import { business } from '../../config/business';
import { CTA_LABEL } from '../../config/nav';

// Astro's built-in <Picture> only switches format and size, not the source image,
// so art direction needs a hand-built <picture> fed by getImage().
const tallAvif = await getImage({
  src: heroTall,
  format: 'avif',
  widths: [640, 828, 1080],
  quality: 72,
});
const wideAvif = await getImage({
  src: heroWide,
  format: 'avif',
  widths: [1280, 1920, 2400],
  quality: 72,
});
const fallback = await getImage({ src: heroWide, format: 'jpeg', width: 1920, quality: 72 });
---

{/*
  Two compositions, not one composition squeezed.

  Desktop (≥640px): copy overlays the wide frame, which has empty wall on the left
  exactly where the text sits. Overlay opacity stays 0 per spec §4.1.

  Mobile (<640px): the tall crop puts its wall at the TOP and the subject across the
  bottom — the copy's only landing zone. Overlaying it meant either unreadable text
  or a scrim that washed out the photograph. Splitting instead gives the image a
  clean, uncovered frame and the copy full contrast on porcelain. No scrim, no
  compromise on either half.
*/}
<section class="relative isolate overflow-hidden">
  <picture class="block h-[56svh] w-full sm:absolute sm:inset-0 sm:h-full">
    <source media="(max-width: 639px)" srcset={tallAvif.srcSet.attribute} type="image/avif" />
    <source media="(min-width: 640px)" srcset={wideAvif.srcSet.attribute} type="image/avif" />
    <img
      src={fallback.src}
      width={1920}
      height={1080}
      alt=""
      fetchpriority="high"
      decoding="async"
      class="ken-burns size-full object-cover object-[78%_50%] sm:object-[65%_50%] lg:object-center"
    />
  </picture>

  <div
    class="wrap relative flex flex-col justify-end pt-12 pb-16 sm:min-h-[92svh] sm:pt-[60px] sm:pb-20 md:min-h-[88svh] md:pb-28"
  >
    {/* The brand line moves to the kicker so the H1 can carry the geo claim.
        This is one of the two pages where a geo H1 is correct — strategy §1.13:
        the homepage and the category mirrors state the geography, every
        treatment H1 stays bare. */}
    <p class="t-eyebrow text-ink-soft sm:text-ink">Corrective skin studio · Mission Hills, San Diego</p>
    <h1 class="t-hero mt-4 max-w-[16ch] sm:mt-5 sm:max-w-[18ch]">
      Corrective skin & scalp treatments in San Diego—for pigmentation, acne, and scalp health.
    </h1>
    <p class="t-body mt-5 max-w-[52ch] sm:mt-6">
      KIAMO SKIN is a licensed corrective skin and scalp studio in {business.address.neighborhood},
      minutes from Hillcrest and Little Italy. We specialize in pigmentation treatment, acne
      scarring, scalp therapy, and barrier repair—safe and effective for all skin types.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-3 sm:mt-9">
      <Button href={business.bookingUrl} external>{CTA_LABEL}</Button>
      <Button variant="ghost" href="/treatments/">View treatments</Button>
    </div>
    <p class="t-body mt-5 text-[0.875rem] text-ink-soft">
      Trusted by clients across San Diego County · <a
        href={`https://www.google.com/maps/place/?q=place_id:${business.gbpPlaceId}`}
        target="_blank"
        rel="noopener noreferrer"
        class="border-b border-ink/40 hover:border-rose hover:text-rose"
      >Read reviews on Google</a>
    </p>
  </div>
</section>

<style>
  /* Spec §9: ken-burns scale 1 → 1.06 over 20s. */
  .ken-burns {
    animation: ken-burns 20s ease-out forwards;
    transform-origin: 60% 50%;
  }

  @keyframes ken-burns {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.06);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ken-burns {
      animation: none;
    }
  }
</style>
