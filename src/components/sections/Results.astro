---
import Reveal from '../Reveal.astro';
import BeforeAfter from '../BeforeAfter.astro';
import { testimonials } from '../../data/testimonials';
import { gbpReviewsUrl } from '../../config/urls';
import { business } from '../../config/business';
import pigBefore from '../../assets/hyperpigmentation-before-treatment-melanin-rich-skin-san-diego.jpg';
import pigAfter from '../../assets/hyperpigmentation-after-treatment-results-san-diego.jpg';
import scalpBefore from '../../assets/keravive-scalp-treatment-before-san-diego.jpg';
import scalpAfter from '../../assets/keravive-scalp-treatment-after-results-san-diego.jpg';

const homepageReviews = testimonials.filter((t) => !t.area);
const row1 = homepageReviews.slice(0, 6);
const row2 = homepageReviews.slice(6);
---

<section class="bg-porcelain">
  <div class="wrap section-y">
    <p class="t-eyebrow text-ink-soft">Progress, not promises</p>
    <h2 class="t-h2 mt-5 max-w-[26ch]">Skin results in San Diego — not overnight, but with consistency.</h2>

    <div class="mt-14 grid gap-12 md:grid-cols-2 md:gap-16">
      <Reveal>
        <BeforeAfter
          id="ba-pigmentation"
          before={pigBefore}
          after={pigAfter}
          beforeAlt="Cheek with uneven tone and dark patches before a course of treatment"
          afterAlt="The same cheek with noticeably more even tone after a course of treatment"
        />
        <p class="t-service mt-6 text-[1rem]">Pigmentation &amp; tone</p>
        <p class="t-body mt-2 text-[0.9375rem] text-ink-soft">
          A course of Lira peels paired with home care.
        </p>
      </Reveal>

      <Reveal>
        <BeforeAfter
          id="ba-scalp"
          before={scalpBefore}
          after={scalpAfter}
          beforeAlt="Dry, flaking scalp at the part before treatment"
          afterAlt="The same scalp looking clear and calm after treatment"
        />
        <p class="t-service mt-6 text-[1rem]">Scalp &amp; density</p>
        <p class="t-body mt-2 text-[0.9375rem] text-ink-soft">
          HydraFacial Keravive across a multi-session plan.
        </p>
      </Reveal>
    </div>

    <p class="t-meta mt-8 max-w-[60ch] text-ink-soft">
      Results vary from person to person. Images are illustrative and do not depict a specific
      client outcome.
    </p>
  </div>
</section>

<section class="reviews-section" aria-label="Client reviews">
  <div class="wrap reviews-header">
    <p class="t-eyebrow reviews-eyebrow">Client experiences</p>
    <h2 class="t-h2 reviews-h2">What clients say after corrective treatment in San Diego.</h2>
  </div>

  <div class="reviews-marquee-wrap" aria-hidden="true">
    <!-- Row 1: scrolls left -->
    <div class="reviews-track reviews-track--left">
      <ul class="reviews-row">
        {row1.map((t) => (
          <li class="review-card">
            <p class="review-quote">&ldquo;{t.quote}&rdquo;</p>
            <p class="review-meta">— {t.attribution}{t.platform ? `, ${t.platform}` : ''}</p>
          </li>
        ))}
      </ul>
      <ul class="reviews-row" aria-hidden="true">
        {row1.map((t) => (
          <li class="review-card">
            <p class="review-quote">&ldquo;{t.quote}&rdquo;</p>
            <p class="review-meta">— {t.attribution}{t.platform ? `, ${t.platform}` : ''}</p>
          </li>
        ))}
      </ul>
    </div>

    <!-- Row 2: scrolls right -->
    <div class="reviews-track reviews-track--right">
      <ul class="reviews-row">
        {row2.map((t) => (
          <li class="review-card">
            <p class="review-quote">&ldquo;{t.quote}&rdquo;</p>
            <p class="review-meta">— {t.attribution}{t.platform ? `, ${t.platform}` : ''}</p>
          </li>
        ))}
      </ul>
      <ul class="reviews-row" aria-hidden="true">
        {row2.map((t) => (
          <li class="review-card">
            <p class="review-quote">&ldquo;{t.quote}&rdquo;</p>
            <p class="review-meta">— {t.attribution}{t.platform ? `, ${t.platform}` : ''}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="wrap reviews-cta-wrap">
    <a
      href={gbpReviewsUrl(business.gbpPlaceId)}
      target="_blank"
      rel="noopener"
      class="reviews-cta"
    >
      Read our Google reviews ↗
    </a>
  </div>
</section>

<style>
  .reviews-section {
    background-color: var(--color-ivory);
    padding-block: 96px 80px;
  }

  @media (min-width: 52.5rem) {
    .reviews-section {
      padding-block: 128px 96px;
    }
  }

  .reviews-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .reviews-eyebrow {
    color: var(--color-rose);
    margin-bottom: 1.25rem;
  }

  .reviews-h2 {
    margin-inline: auto;
    max-width: 28ch;
  }

  /* Marquee container — clips overflow */
  .reviews-marquee-wrap {
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* Each row: two identical lists side by side */
  .reviews-track {
    display: flex;
    width: max-content;
  }

  @media (prefers-reduced-motion: no-preference) {
    .reviews-track--left {
      animation: scroll-left 40s linear infinite;
    }
    .reviews-track--right {
      animation: scroll-right 40s linear infinite;
    }
  }

  .reviews-track:hover {
    animation-play-state: paused;
  }

  @keyframes scroll-left {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  @keyframes scroll-right {
    from { transform: translateX(-50%); }
    to   { transform: translateX(0); }
  }

  .reviews-row {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 1.25rem;
    flex-shrink: 0;
  }

  .review-card {
    background-color: var(--color-porcelain);
    border: 1px solid var(--color-line);
    padding: 2rem 2.25rem;
    width: 340px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
  }

  @media (min-width: 52.5rem) {
    .review-card {
      width: 400px;
      padding: 2.5rem 2.75rem;
    }
  }

  .review-quote {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-ink);
  }

  @media (min-width: 52.5rem) {
    .review-quote {
      font-size: 1.25rem;
    }
  }

  .review-meta {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }

  .reviews-cta-wrap {
    text-align: center;
    margin-top: 3.5rem;
  }

  .reviews-cta {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 0.4em;
    text-decoration-color: var(--color-ink);
    transition: color 200ms ease, text-decoration-color 200ms ease;
  }

  .reviews-cta:hover {
    color: var(--color-rose);
    text-decoration-color: var(--color-rose);
  }
</style>
