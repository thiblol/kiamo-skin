---
import Reveal from '../Reveal.astro';
import BeforeAfter from '../BeforeAfter.astro';
import pigBefore from '../../assets/hyperpigmentation-before-treatment-melanin-rich-skin-san-diego.jpg';
import pigAfter from '../../assets/hyperpigmentation-after-treatment-results-san-diego.jpg';
import scalpBefore from '../../assets/keravive-scalp-treatment-before-san-diego.jpg';
import scalpAfter from '../../assets/keravive-scalp-treatment-after-results-san-diego.jpg';

/**
 * Results
 * -------
 * The before-and-afters, and the treatment-room clips.
 *
 * The client quotes used to live at the bottom of this section. They now sit
 * directly under the price menu, in ClientReviews.astro, because the order a
 * reader decides in is price, then other people, then a request — and the
 * quotes were two thirds of the page away from the price they answer.
 */
---

<section class="bg-porcelain">
  <div class="wrap pt-[88px] pb-16 md:pt-[112px]">
    <Reveal>
      <p class="t-eyebrow text-ink-soft">Real results, real reviews</p>
      <h2 class="t-h2 mt-5 max-w-[30ch]">Corrective skin work in San Diego — proof and client experiences.</h2>
    </Reveal>

    <div class="mt-14 grid gap-12 md:grid-cols-2 md:gap-16">
      <Reveal>
        <BeforeAfter
          id="ba-pigmentation"
          before={pigBefore}
          after={pigAfter}
          beforeAlt="Before Lira Chemical Peel treatment at KIAMO Skin in San Diego - post-inflammatory hyperpigmentation on melanin-rich skin."
          afterAlt="After four Lira Chemical Peel sessions at KIAMO Skin in San Diego - dark marks from acne and shaving cleared over a five-month series."
        />
        <p class="t-service mt-6 text-[1rem]">Pigmentation &amp; tone</p>
        <p class="t-body mt-2 text-[0.9375rem] text-ink-soft">
          Four LIRA chemical peels across five months, on Fitzpatrick V–VI skin, with daily tinted
          SPF carrying the work between visits.
        </p>
        <a
          href="/gallery/#case-pih-lira-chemical-peel-paired"
          class="t-button mt-4 inline-block border-b border-ink pb-1 hover:border-rose hover:text-rose"
        >
          See the full case
        </a>
      </Reveal>

      <Reveal>
        <BeforeAfter
          id="ba-scalp"
          before={scalpBefore}
          after={scalpAfter}
          beforeAlt="Before Keravive scalp therapy at KIAMO Skin in San Diego - hard water mineral buildup and flaking."
          afterAlt="After three Keravive scalp therapy sessions at KIAMO Skin in San Diego - cleaner scalp with reduced flaking."
        />
        <p class="t-service mt-6 text-[1rem]">Scalp &amp; density</p>
        <p class="t-body mt-2 text-[0.9375rem] text-ink-soft">
          Three Keravive scalp sessions across four months, clearing the mineral film that San
          Diego's hard water leaves behind.
        </p>
        <a
          href="/gallery/#case-keravive-scalp-buildup-paired"
          class="t-button mt-4 inline-block border-b border-ink pb-1 hover:border-rose hover:text-rose"
        >
          See the full case
        </a>
      </Reveal>
    </div>

    {/* These are the studio's own photographs — the same two cases published
        in full on /gallery/ — so the disclaimer says what is true. It used to
        call them "illustrative" and deny that they depicted a client outcome,
        which contradicted the Outcomes section two screens above ("real cases
        from this studio, each photographed with written consent"). A reader who
        found both stopped believing either. */}
    <p class="t-meta mt-8 max-w-[60ch] text-ink-soft">
      Results vary from person to person. Both photographs are real sessions from this studio,
      published with written consent — the treatment plan and Fitzpatrick band for each are on the
      results page.
    </p>
  </div>

  {/* The treatment-room clips. They are proof, so they live inside the proof
      section rather than claiming a heading of their own. */}
  <slot name="media" />
</section>
