---
import Reveal from '../Reveal.astro';
import BeforeAfter from '../BeforeAfter.astro';
import { testimonials } from '../../data/testimonials';
import { gbpReviewsUrl } from '../../config/urls';
import { business } from '../../config/business';
import pigBefore from '../../assets/result-pigmentation-before.jpg';
import pigAfter from '../../assets/result-pigmentation-after.jpg';
import scalpBefore from '../../assets/result-scalp-before.jpg';
import scalpAfter from '../../assets/result-scalp-after.jpg';
---

<section class="bg-porcelain">
  <div class="wrap section-y">
    <p class="t-eyebrow text-ink-soft">Progress, not promises</p>
    <h2 class="t-h2 mt-5 max-w-[26ch]">Skin doesn’t change overnight. It changes with consistency.</h2>

    <div class="mt-14 grid gap-12 md:grid-cols-2 md:gap-16">
      <Reveal>
        <BeforeAfter
          id="ba-pigmentation"
          before={pigBefore}
          after={pigAfter}
          beforeAlt="Cheek with uneven tone and dark patches before a course of treatment"
          afterAlt="The same cheek with noticeably more even tone after a course of treatment"
        />
        <p class="t-service mt-6 text-[1rem]">Pigmentation &amp; tone</p>
        <p class="t-body mt-2 text-[0.9375rem] text-ink-soft">
          A course of Lira peels paired with home care.
        </p>
      </Reveal>

      <Reveal>
        <BeforeAfter
          id="ba-scalp"
          before={scalpBefore}
          after={scalpAfter}
          beforeAlt="Dry, flaking scalp at the part before treatment"
          afterAlt="The same scalp looking clear and calm after treatment"
        />
        <p class="t-service mt-6 text-[1rem]">Scalp &amp; density</p>
        <p class="t-body mt-2 text-[0.9375rem] text-ink-soft">
          HydraFacial Keravive across a multi-session plan.
        </p>
      </Reveal>
    </div>

    {/* Required disclaimer — these frames are illustrative renders for the demo,
        not photographs of clients. Spec §10. */}
    <p class="t-meta mt-8 max-w-[60ch] text-ink-soft">
      Results vary from person to person. Images are illustrative and do not depict a specific
      client outcome.
    </p>

    <div class=”mt-28 border-t border-line pt-20 text-center”>
      <p class=”t-eyebrow text-ink-soft”>Client experiences</p>
      <h2 class=”t-h2 mx-auto mt-5 max-w-[28ch]”>What clients say after corrective treatment in San Diego.</h2>
    </div>

    <ul class=”mt-16 grid list-none gap-px p-0 border border-line md:grid-cols-3 reviews-grid”>
      {testimonials.slice(0, 3).map((t) => {
        const platform = t.platform ? `, ${t.platform}` : '';
        return (
          <li data-reveal class=”review-card”>
            <p class=”quote-mark”>&ldquo;</p>
            <blockquote class=”quote-text”>
              {t.quote}
            </blockquote>
            <p class=”quote-attribution”>— {t.attribution}{platform}</p>
          </li>
        );
      })}
    </ul>

    <div class=”mt-10 text-center”>
      <a
        href={gbpReviewsUrl(business.gbpPlaceId)}
        target=”_blank”
        rel=”noopener”
        class=”review-cta”
      >
        Read our Google reviews ↗
      </a>
    </div>
  </div>
</section>

<style>
  .reviews-grid {
    background-color: var(--color-line);
  }

  .review-card {
    background-color: var(--color-porcelain);
    padding: 2.5rem 2rem;
  }

  @media (min-width: 52.5rem) {
    .review-card {
      padding: 3rem 2.5rem;
    }
  }

  .quote-mark {
    font-family: var(--font-display);
    color: var(--color-rose);
    font-size: 3rem;
    line-height: 1;
    font-weight: 300;
  }

  .quote-text {
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.125rem, 1.8vw, 1.375rem);
    line-height: 1.45;
    color: var(--color-ink);
  }

  .quote-attribution {
    margin-top: 2rem;
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }

  .review-cta {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    line-height: 1;
    text-decoration: underline;
    text-underline-offset: 0.35em;
    text-decoration-color: currentColor;
    color: var(--color-ink-soft);
    transition: color 200ms ease;
  }

  .review-cta:hover {
    color: var(--color-rose);
  }
</style>
