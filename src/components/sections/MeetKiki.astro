---
import { Image } from 'astro:assets';
import Reveal from '../Reveal.astro';
import PanelWipe from '../PanelWipe.astro';
import Button from '../Button.astro';
import portrait from '../../assets/kiki-california-licensed-esthetician-mission-hills.jpg';
import { business } from '../../config/business';

/* All copy here is pronoun-free — spec §2. Kiki has never published pronouns,
   and the guard suite fails the build on she/her. */
---

<Reveal as="section" class="bg-blush">
  <div class="wrap section-y grid items-center gap-12 md:grid-cols-[0.85fr_1fr] md:gap-20">
    <PanelWipe class="aspect-3/4">
      <Image
        src={portrait}
        alt="Kiki, licensed esthetician and owner of KIAMO Skin, beside the HydraFacial device in the treatment room"
        widths={[400, 800, 1600]}
        sizes="(min-width: 840px) 40vw, 90vw"
        loading="lazy"
        class="size-full object-cover"
      />
    </PanelWipe>

    <div>
      <p class="t-eyebrow text-ink-soft">Meet {business.ownerName}</p>
      <h2 class="t-h2 mt-5 max-w-[24ch]">Licensed esthetician in Mission Hills, San Diego — specialising in corrective skin care.</h2>
      <p class="t-body mt-5 italic text-ink-soft">"Trust the process. Your skin can heal."</p>

      <p class="t-body mt-7">
        {business.ownerName} is a California licensed esthetician with {business.experience} of
        experience specializing in acne, acne scars, hyperpigmentation, melasma, skin barrier
        repair, age management, HydraFacial, Procell Microchanneling, and scalp health. Every
        treatment plan is customized using evidence-based techniques and professional-grade
        technology to support healthy, long-term results — not quick fixes.
      </p>

      <p class="t-body mt-5">
        At KIAMO Skin, we believe healthy skin starts with education, consistency, and
        personalized care. We proudly welcome all skin tones, with extensive experience treating
        melanin-rich skin, post-inflammatory hyperpigmentation, and skin concerns that require
        specialized care. Every client receives a customized treatment plan designed around their
        unique skin goals, lifestyle, and long-term skin health.
      </p>

      <div class="mt-9">
        <Button variant="ghost" href="/about/">More about the studio</Button>
      </div>
    </div>
  </div>
</Reveal>
