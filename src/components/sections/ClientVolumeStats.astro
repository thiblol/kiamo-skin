---
import Reveal from '../Reveal.astro';

/**
 * Client Volume Stats - Social proof section for service-areas hub
 *
 * Shows geographic distribution of client base with specific percentages.
 * Builds authority through volume data and distance commitment.
 *
 * Key elements:
 * - Area-by-area breakdown (North Park 22%, La Jolla 18%, etc.)
 * - Distance stats (68% travel 20+ minutes)
 * - Farthest regular client (45 minutes)
 * - Most common concern by area
 */
---

<section class="bg-blush">
  <div class="wrap section-y">
    <Reveal>
      <p class="t-eyebrow text-ink-soft">Client distribution</p>
      <h2 class="t-h2 mt-5 max-w-[28ch]">Where our 450+ clients come from</h2>
    </Reveal>

    <div class="mt-14 grid gap-12 md:grid-cols-2 lg:gap-20">
      <div>
        <Reveal>
          <h3 class="t-service text-[1.25rem]">By area (top 6)</h3>
          <div class="mt-8 space-y-5">
            <div>
              <div class="flex justify-between items-baseline mb-2">
                <span class="t-body font-medium">North Park</span>
                <span class="t-body text-ink-soft">22%</span>
              </div>
              <div class="h-2 bg-ivory rounded-full overflow-hidden">
                <div class="h-full bg-rose" style="width: 22%"></div>
              </div>
            </div>
            <div>
              <div class="flex justify-between items-baseline mb-2">
                <span class="t-body font-medium">La Jolla</span>
                <span class="t-body text-ink-soft">18%</span>
              </div>
              <div class="h-2 bg-ivory rounded-full overflow-hidden">
                <div class="h-full bg-rose" style="width: 18%"></div>
              </div>
            </div>
            <div>
              <div class="flex justify-between items-baseline mb-2">
                <span class="t-body font-medium">Chula Vista</span>
                <span class="t-body text-ink-soft">15%</span>
              </div>
              <div class="h-2 bg-ivory rounded-full overflow-hidden">
                <div class="h-full bg-rose" style="width: 15%"></div>
              </div>
            </div>
            <div>
              <div class="flex justify-between items-baseline mb-2">
                <span class="t-body font-medium">Pacific Beach</span>
                <span class="t-body text-ink-soft">13%</span>
              </div>
              <div class="h-2 bg-ivory rounded-full overflow-hidden">
                <div class="h-full bg-rose" style="width: 13%"></div>
              </div>
            </div>
            <div>
              <div class="flex justify-between items-baseline mb-2">
                <span class="t-body font-medium">Downtown / Little Italy</span>
                <span class="t-body text-ink-soft">11%</span>
              </div>
              <div class="h-2 bg-ivory rounded-full overflow-hidden">
                <div class="h-full bg-rose" style="width: 11%"></div>
              </div>
            </div>
            <div>
              <div class="flex justify-between items-baseline mb-2">
                <span class="t-body font-medium">Encinitas / Carlsbad</span>
                <span class="t-body text-ink-soft">9%</span>
              </div>
              <div class="h-2 bg-ivory rounded-full overflow-hidden">
                <div class="h-full bg-rose" style="width: 9%"></div>
              </div>
            </div>
            <div>
              <div class="flex justify-between items-baseline mb-2">
                <span class="t-body">Other (La Mesa, Del Mar, Hillcrest)</span>
                <span class="t-body text-ink-soft">12%</span>
              </div>
              <div class="h-2 bg-ivory rounded-full overflow-hidden">
                <div class="h-full bg-rose" style="width: 12%"></div>
              </div>
            </div>
          </div>
        </Reveal>
      </div>

      <div class="space-y-10">
        <Reveal>
          <div>
            <h3 class="t-service text-[1.25rem]">Distance commitment</h3>
            <div class="mt-6 space-y-6">
              <div class="border-l-2 border-rose pl-6">
                <p class="text-[2rem] font-light leading-none text-rose">68%</p>
                <p class="t-body mt-2 text-ink-soft">travel 20+ minutes for every visit</p>
              </div>
              <div class="border-l-2 border-rose pl-6">
                <p class="text-[2rem] font-light leading-none text-rose">18 min</p>
                <p class="t-body mt-2 text-ink-soft">average drive time from La Jolla via I-5</p>
              </div>
              <div class="border-l-2 border-rose pl-6">
                <p class="text-[2rem] font-light leading-none text-rose">45 min</p>
                <p class="t-body mt-2 text-ink-soft">farthest regular client (Carlsbad, monthly visits)</p>
              </div>
            </div>
          </div>
        </Reveal>

        <Reveal>
          <div>
            <h3 class="t-service text-[1.25rem]">Most common concern by area</h3>
            <dl class="mt-6 space-y-3 text-[0.9375rem]">
              <div class="flex justify-between gap-4">
                <dt class="font-medium">North Park / Hillcrest</dt>
                <dd class="text-ink-soft text-right">Acne, congestion</dd>
              </div>
              <div class="flex justify-between gap-4">
                <dt class="font-medium">La Jolla / Pacific Beach</dt>
                <dd class="text-ink-soft text-right">Barrier damage (ocean)</dd>
              </div>
              <div class="flex justify-between gap-4">
                <dt class="font-medium">Chula Vista / La Mesa</dt>
                <dd class="text-ink-soft text-right">Melasma, pigmentation</dd>
              </div>
              <div class="flex justify-between gap-4">
                <dt class="font-medium">Encinitas / Carlsbad</dt>
                <dd class="text-ink-soft text-right">Sun damage, reactive skin</dd>
              </div>
              <div class="flex justify-between gap-4">
                <dt class="font-medium">Downtown / Little Italy</dt>
                <dd class="text-ink-soft text-right">Urban pollution, dullness</dd>
              </div>
            </dl>
          </div>
        </Reveal>
      </div>
    </div>
  </div>
</section>
