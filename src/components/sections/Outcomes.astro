---
/**
 * Outcomes
 * --------
 * The "results you can expect" half of the menu, sitting directly after it.
 *
 * The treatment menu answers "what does this cost". This answers "what does
 * this take" — sessions, elapsed time, and what the client actually saw.
 * Every row is a case already published with written consent on /gallery/,
 * so the numbers are the studio's own record and the outcome line describes a
 * photograph anyone can verify.
 *
 * The one thing this section is careful not to do is promise a result. Each
 * row links to its case, the range language is the studio's own, and the
 * disclaimer sits directly beneath. A reader can check every claim by
 * clicking.
 */
import Reveal from '../Reveal.astro';
import { outcomes } from '../../data/outcomes';
---

<section class="bg-porcelain">
  <div class="wrap section-y">
    <Reveal>
      <p class="t-eyebrow text-ink-soft">What to expect</p>
      <h2 class="t-h2 mt-5 max-w-[26ch]">Results take sessions. Here is what the sessions look like.</h2>
      <p class="t-body mt-6 max-w-[62ch]">
        Correction runs in a series, not a single visit. These are real cases from this studio,
        each photographed with written consent and published in full.
      </p>
    </Reveal>

    <ul class="mt-14 m-0 grid list-none gap-x-10 gap-y-0 p-0 md:grid-cols-2">
      {
        outcomes.map((o) => (
          <Reveal as="li" class="border-b border-line">
            <a href={o.href} class="group block py-8">
              <p class="t-eyebrow text-rose">{o.concern}</p>
              <p class="t-body mt-4 text-[1rem] text-ink">{o.outcome}</p>
              <dl class="mt-6 m-0 flex flex-wrap gap-x-8 gap-y-3">
                <div>
                  <dt class="t-meta">Treatment</dt>
                  <dd class="t-body mt-1 m-0 text-ink">{o.treatment}</dd>
                </div>
                <div>
                  <dt class="t-meta">Sessions</dt>
                  <dd class="t-body mt-1 m-0 text-ink">{o.sessions}</dd>
                </div>
                <div>
                  <dt class="t-meta">Over</dt>
                  <dd class="t-body mt-1 m-0 text-ink">{o.timeframe}</dd>
                </div>
              </dl>
              <p class="t-button mt-6 inline-block border-b border-ink pb-1 transition-colors duration-300 group-hover:border-rose group-hover:text-rose">
                See the full case
              </p>
            </a>
          </Reveal>
        ))
      }
    </ul>

    <p class="t-meta mt-8 max-w-[60ch] text-ink-soft">
      Results vary from person to person. Every photo linked here is the actual session record from
      this studio, published with written consent.
    </p>

    <div class="mt-10">
      <a
        href="/gallery/"
        class="t-button border-b border-ink pb-1 hover:border-rose hover:text-rose"
      >
        See every published result
      </a>
    </div>
  </div>
</section>
