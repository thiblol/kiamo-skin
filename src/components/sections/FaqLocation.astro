---
import NapBlock from '../NapBlock.astro';
import LocationMap from '../LocationMap.astro';
import Button from '../Button.astro';
import ProofQuote from '../ProofQuote.astro';
import FaqList from '../FaqList.astro';
import FaqSchema from '../schema/FaqSchema.astro';
import { business } from '../../config/business';
import { CTA_LABEL } from '../../config/nav';
import { gbpDirectionsUrl, gbpReviewsUrl } from '../../config/urls';
import { studioProof } from '../../data/treatment-trust';
import type { Faq } from '../../data/faqs';

/**
 * Conversion-optimized FAQs using FAQ Money Printer PRO methodology.
 * Targets 8 buyer hesitation categories: price, time, trust, comparison,
 * risk reversal, location, qualification, results skepticism.
 *
 * This is the default set. A page can pass its own `faqs` prop to publish a
 * different set: the same question on two pages is a duplicate-content signal
 * and splits the authority between them.
 */
const bookingFaqs: Faq[] = [
  {
    question: "What's the difference between KIAMO Skin and a regular spa facial in San Diego?",
    answer: "KIAMO Skin offers corrective skin treatments, not spa facials. While spa facials focus on relaxation and surface-level care, corrective treatments target specific skin concerns—acne, hyperpigmentation, melasma, scarring, and barrier damage—using clinical-grade technology like HydraFacial Syndeo, medical-grade chemical peels, and Procell Microchanneling. Every treatment is customized by a California-licensed esthetician based on your skin type, concern, and goals. You'll still relax during your session, but results come first."
  },
  {
    question: "Is KIAMO Skin safe for my skin type? I have sensitive/darker skin.",
    answer: "Yes. KIAMO Skin treats all skin types safely, from Fitzpatrick I to VI. Kiki has 7+ years of experience working with sensitive skin, reactive skin, acne-prone skin, and darker skin tones that are prone to post-inflammatory hyperpigmentation. Every treatment protocol is customized to your skin's barrier function, melanin response, and sensitivity level. We never use aggressive treatments that compromise your skin barrier or cause unnecessary inflammation."
  },
  {
    question: "How much do treatments cost at KIAMO Skin?",
    answer: "First-time client consultations start at $249 and include a full skin analysis and customized treatment. HydraFacial sessions are $259. Chemical peels range from $199 to $299 depending on depth. Procell Microchanneling is $475 per session or $1,199 for a series of three. Scalp treatments (Keravive) are $599 per session. Monthly memberships start at $199 and include one treatment per month plus discounts on additional services. Exact pricing depends on your custom treatment plan."
  },
  {
    question: "Where is KIAMO Skin located and is parking available?",
    answer: "KIAMO Skin is located at 3067 Reynard Way in San Diego—minutes from Hillcrest Medical Center, Little Italy, and Balboa Park. Free street parking is available on Reynard Way and surrounding streets. The studio is easily accessible from Downtown San Diego (10 minutes), North Park (8 minutes), and the I-5/I-8 interchange. Appointments are by appointment only—no walk-ins."
  },
  {
    question: "How long does it take to see results?",
    answer: "It depends on your skin concern. For barrier repair and hydration, you'll see improvement after one HydraFacial session. For acne, hyperpigmentation, melasma, and scarring, expect visible progress within 4-6 weeks with a consistent treatment plan. Corrective skincare is not a quick fix—it's a process. Kiki will create a realistic timeline during your first consultation based on your skin's current condition and your goals. Most clients commit to monthly treatments for 3-6 months to achieve lasting results."
  },
  {
    question: "Do I need to do anything before my first appointment?",
    answer: "Arrive with a clean face—no makeup, sunscreen, or active skincare products on the day of your appointment. If you're using prescription retinoids (tretinoin, Retin-A) or acids (AHAs, BHAs), stop 3-5 days before your appointment to avoid over-exfoliation. Avoid tanning, waxing, or other facial treatments 1 week before. If you have active cold sores, reschedule—facial treatments can trigger outbreaks. Bring a list of current skincare products and any medications you're taking. That's it."
  },
  {
    question: "Can I book same-day or do I need to schedule in advance?",
    answer: "KIAMO Skin operates by appointment only—no walk-ins. Same-day appointments are occasionally available, but most clients book 1-2 weeks in advance, especially for weekend slots. First-time clients should book at least 3-5 days ahead to ensure availability for a full consultation. You can book online through the Vagaro booking system or call the studio directly. Memberships include priority booking for monthly treatment slots."
  }
];

const { faqs = bookingFaqs } = Astro.props as { faqs?: Faq[] };

/**
 * One list, one behaviour.
 *
 * The answers used to run as two tiers — four at full size, the rest as a
 * quieter reference block. Both tiers are now behind a click, rendered
 * through FaqList, so the section reads as seven questions rather than
 * seven paragraphs of copy the reader has to scroll past to reach the
 * booking button.
 *
 * The answers are unchanged. They are still in the HTML, still in the
 * schema, and still spoken by the speakable schema — the reader just
 * opens them when they want them.
 */

const schemaFaqs = faqs.map(faq => ({
  question: faq.question,
  answer: faq.answer
}));

const directionsUrl = gbpDirectionsUrl(business.gbpPlaceId, business.address.full);
const reviewsUrl = gbpReviewsUrl(business.gbpPlaceId);
---

<FaqSchema faqs={schemaFaqs} />

<section class="bg-ivory">
  <div class="wrap section-y grid gap-16 md:grid-cols-[1fr_0.8fr] md:gap-20">
    <div>
      <p class="t-eyebrow text-ink-soft">Before you book</p>
      <h2 class="t-h2 mt-5 max-w-[20ch]">Facial questions answered — San Diego</h2>

      {/* The questions. Every answer opens on click. */}
      <div class="mt-12">
        <FaqList faqs={faqs} />
      </div>
    </div>

    <div>
      <p class="t-eyebrow text-ink-soft">The studio</p>
      <h2 class="t-h2 mt-5 text-[2rem] md:text-[2.5rem]">
        Visit us in San Diego
      </h2>

      {/* A live map, not a photo linking to one. Scorpio embeds the map on the
          homepage (§1.10) and it is the one conversion element that also
          reinforces the pin the local pack ranks. */}
      <div class="mt-8">
        <LocationMap id="faq-map" />
      </div>

      <div class="mt-8">
        <NapBlock tone="light" showCancellation />
      </div>

      <div class="mt-9 flex flex-wrap items-center gap-x-8 gap-y-4">
        <Button href={business.bookingUrl} external>{CTA_LABEL}</Button>
        {/* Dual CTA — T8. Different people convert differently, and a call is
            the lower-friction half when booking is request-based. */}
        <a
          href={business.phone.href}
          class="t-button border-b border-ink pb-1 hover:border-rose hover:text-rose"
          onclick="if(typeof gtag !== 'undefined') gtag('event', 'phone_click', {event_category: 'engagement', event_label: 'faq_column', transport_type: 'beacon'});"
        >
          Call {business.phone.display}
        </a>
      </div>

      {/* Trust repeats. The band under the hero carries one quote; this is the
          second one, next to the booking form, so a reader who scrolls
          straight to the CTA still meets a client before they meet the
          button. */}
      <div class="mt-10 border-t border-line pt-9">
        <ProofQuote testimonial={studioProof} />
      </div>

      {/* Risk reversal. The audit found no answer to "what if it doesn't work"
          anywhere near the booking form — and that is the question that stops
          a first-time visitor sending a request.

          Every line here is a fact the studio already publishes, not a
          promise invented to close a sale. A satisfaction guarantee is NOT
          claimed here, because no such guarantee has been offered by the
          business and inventing one would be a fabrication. What is offered is
          the three things a cautious reader actually wants: the price before
          the appointment, a consultation before the treatment, and a stated
          cancellation window. If the studio wants a real guarantee, that is a
          business decision to make, not a copy decision to fake. */}
      <div class="mt-10 border-t border-line pt-8">
        <p class="t-eyebrow text-rose">Before you commit</p>
        <ul class="mt-6 m-0 list-none p-0">
          <li class="border-l-2 border-rose pl-5">
            <p class="t-service text-[0.9375rem]">The price comes first</p>
            <p class="t-body mt-2 text-[0.9375rem]">
              Every treatment price is published on the menu. Nothing is quoted at the door, and the
              first visit includes the consultation that decides the plan.
            </p>
          </li>
          <li class="mt-6 border-l-2 border-rose pl-5">
            <p class="t-service text-[0.9375rem]">Nothing is treated before it is assessed</p>
            <p class="t-body mt-2 text-[0.9375rem]">
              A full consultation and skin analysis come first, and the treatment is chosen around
              what your skin is doing that day.
            </p>
          </li>
          <li class="mt-6 border-l-2 border-rose pl-5">
            <p class="t-service text-[0.9375rem]">A stated cancellation window</p>
            <p class="t-body mt-2 text-[0.9375rem]">
              {business.cancellation}
            </p>
          </li>
        </ul>
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
        <a
          href={directionsUrl}
          target="_blank"
          rel="noopener"
          class="t-button border-b border-ink pb-1 hover:border-rose hover:text-rose"
        >
          Get directions
        </a>
        {/* Points AT the Google Business Profile rather than reproducing
            anything from it. Publishes no count and no rating, so it stays
            inside the spec, and it feeds the review flywheel that gates the
            local pack (T1, T8). */}
        <a
          href={reviewsUrl}
          target="_blank"
          rel="noopener"
          class="t-button border-b border-ink pb-1 hover:border-rose hover:text-rose"
        >
          Read our Google reviews
        </a>
      </div>
    </div>
  </div>
</section>
