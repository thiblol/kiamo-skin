---
import { Image } from 'astro:assets';
import Reveal from '../Reveal.astro';
import uv from '../../assets/san-diego-uv-exposure-skin-damage-protection.jpg';
import water from '../../assets/san-diego-hard-water-skin-barrier-damage.jpg';
import barrier from '../../assets/skin-barrier-repair-treatment-san-diego.jpg';
import { articles } from '../../data/articles';

/**
 * The three most recent articles, newest first. The sort reads the ISO date
 * string directly rather than using the Date constructor, so the server and
 * the client render the same order.
 */
const recent = [...articles]
  .sort((a, b) => (a.datePublished < b.datePublished ? 1 : -1))
  .slice(0, 3);

const formatDate = (iso: string): string => {
  const [year, month, day] = iso.split('-');
  const months = [
    'January', 'February', 'March', 'April', 'May', 'June',
    'July', 'August', 'September', 'October', 'November', 'December',
  ];
  const monthName = months[Number(month) - 1] ?? month;
  return `${monthName} ${Number(day)}, ${year}`;
};

/**
 * Spec §8 asks for three local-context columns each linking onward. The journal
 * only has two articles (§5), so the Santa Ana column links to the treatment that
 * actually answers it — DMK enzyme therapy for barrier repair — rather than a
 * stub article. Flagged to the client in CLIENT-INPUTS.md.
 */
const columns = [
  {
    heading: 'June gloom is not sun protection',
    body: 'The marine layer scatters light, it does not stop it. UV still reaches 8–10 on the index through overcast mornings, which is exactly how pigmentation quietly deepens in a city that feels mild.',
    href: '/journal/june-gloom-is-not-sun-protection/',
    linkLabel: 'Read the article',
    image: uv,
    alt: 'Overcast San Diego coastline under a bright marine layer',
  },
  {
    heading: 'Hard water, dry scalp',
    body: 'San Diego water runs around 16 grains per gallon — hard by any measure. Mineral residue builds on the scalp and hair, which shows up as flaking, itch and product that stops working.',
    href: '/journal/san-diego-hard-water-and-your-scalp/',
    linkLabel: 'Read the article',
    image: water,
    alt: 'Water falling over a hand, lit from the side',
  },
  {
    heading: 'Santa Ana winds and your barrier',
    body: 'Humidity can drop into single digits within hours. A compromised barrier loses water faster than it can hold it, and skin that was calm all summer starts stinging in October.',
    href: '/services/dmk-enzyme-therapy/',
    linkLabel: 'See barrier repair',
    image: barrier,
    alt: 'Portrait in dry, warm light with visible natural skin texture',
  },
];
---

<section class="bg-espresso text-porcelain">
  <div class="wrap section-y">
    <p class="t-eyebrow text-porcelain/60">Treating skin in San Diego</p>
    <h2 class="t-h2 mt-5 max-w-[26ch]">
      Your San Diego climate is part of your protocol.
    </h2>

    <ul class="mt-14 grid list-none gap-12 p-0 md:grid-cols-3 md:gap-10">
      {
        columns.map((col) => (
          <Reveal as="li">
            <Image
              src={col.image}
              alt={col.alt}
              widths={[400, 800]}
              sizes="(min-width: 840px) 30vw, 90vw"
              loading="lazy"
              class="aspect-4/3 w-full object-cover"
            />
            <h3 class="t-h3 mt-7 text-[1.375rem] md:text-[1.625rem]">{col.heading}</h3>
            <p class="t-body mt-4 text-[0.9375rem] text-porcelain/75">{col.body}</p>
            <a
              href={col.href}
              class="t-button mt-6 inline-block border-b border-porcelain/40 pb-1 hover:border-porcelain"
            >
              {col.linkLabel}
            </a>
          </Reveal>
        ))
      }
    </ul>

    {/* The journal. A compact list rather than a card grid: the homepage
        carries three recent articles, and the point of the block is that the
        writing is one click away, not that it fills the screen. */}
    <div class="mt-16 border-t border-porcelain/20 pt-10">
      <p class="t-eyebrow text-porcelain/60">More from the journal</p>
      <ul class="m-0 mt-6 list-none p-0">
        {
          recent.map((article) => (
            <li class="border-b border-porcelain/15 last:border-b-0">
              <a href={`/journal/${article.slug}/`} class="group block py-5">
                <p class="t-body text-[1rem] text-porcelain/90 transition-colors group-hover:text-blush">
                  {article.headline}
                </p>
                <p class="t-meta mt-2 text-porcelain/50">
                  <time datetime={article.datePublished}>{formatDate(article.datePublished)}</time>
                </p>
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href="/journal/"
        class="t-button mt-8 inline-block border-b border-porcelain/40 pb-1 hover:border-porcelain"
      >
        All journal articles
      </a>
    </div>
  </div>
</section>
