---
import { Image } from 'astro:assets';
import Reveal from '../Reveal.astro';
import PanelWipe from '../PanelWipe.astro';
import pigmentation from '../../assets/lira-chemical-peel-treatment-mission-hills-san-diego.jpg';
import acne from '../../assets/procell-microchanneling-san-diego.jpg';
import barrier from '../../assets/dmk-enzyme-therapy-san-diego.jpg';
import scalp from '../../assets/keravive-scalp-treatment-san-diego.jpg';

/**
 * Tiles show the treatment in action, sourced from each linked treatment page.
 * Alt text describes what is actually in the frame.
 */
const tiles = [
  {
    label: 'Pigmentation & Melasma',
    href: '/treatments/melasma/',
    image: pigmentation,
    alt: 'Lira chemical peel application in progress at KIAMO Skin San Diego — licensed esthetician applying professional peel for pigmentation and melasma correction',
  },
  {
    label: 'Acne & Scarring',
    href: '/treatments/procell-microchanneling/',
    image: acne,
    alt: 'Procell microchanneling treatment in progress at KIAMO Skin San Diego — licensed esthetician performing corrective microchanneling on a client',
  },
  {
    label: 'Barrier & Dehydration',
    href: '/treatments/dmk-enzyme-therapy/',
    image: barrier,
    alt: 'DMK enzyme therapy treatment in progress at KIAMO Skin San Diego — licensed esthetician performing corrective enzyme therapy on a client',
  },
  {
    label: 'Scalp Health',
    href: '/treatments/keravive-scalp/',
    image: scalp,
    alt: 'Keravive scalp treatment in progress at KIAMO Skin San Diego — licensed esthetician performing clinical scalp therapy on a client',
  },
];
---

<section class="bg-porcelain">
  <div class="wrap section-y">
    <p class="t-eyebrow text-ink-soft">Where to start</p>
    <h2 class="t-h2 mt-5 max-w-[28ch]">Corrective skin treatments in San Diego — where to start.</h2>

    <ul class="mt-14 grid list-none grid-cols-2 gap-x-5 gap-y-10 p-0 md:grid-cols-4 md:gap-x-8">
      {
        tiles.map((tile, i) => (
          <Reveal as="li">
            <a href={tile.href} class="group block">
              <PanelWipe from={i % 2 === 0 ? 'left' : 'right'} class="aspect-3/4">
                <Image
                  src={tile.image}
                  alt={tile.alt}
                  widths={[400, 800, 1200]}
                  sizes="(min-width: 840px) 22vw, 45vw"
                  loading="lazy"
                  class="size-full object-cover transition-transform duration-[1500ms] ease-out group-hover:scale-105"
                />
              </PanelWipe>
              <p class="t-service mt-5 text-[1rem] transition-colors duration-300 group-hover:text-rose">
                {tile.label}
              </p>
            </a>
          </Reveal>
        ))
      }
    </ul>
  </div>
</section>
