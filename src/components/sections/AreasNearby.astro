---
import Reveal from '../Reveal.astro';
import { areas } from '../../data/areas';

/**
 * Closes the largest structural gap on this page: before this section the
 * homepage sent ZERO links to /service-areas, so nine pages sat outside the
 * homepage's link graph entirely (gaps.md §2, site-architecture.csv).
 *
 * Two deliberate departures from the Scorpio pattern this site is modelled on:
 *
 * 1. These are real anchors. Scorpio renders 24 `{service} in {place}` strings
 *    as bare <span>s, and strategy §1.7 measured the result — absent from the
 *    top 25 beyond ~6km. Unlinked place names do nothing; linked ones pass
 *    authority to pages that can actually rank organically.
 *
 * 2. The framing is proximity, not service area. Pack rankings decay with
 *    distance regardless of copy (§1.7, §T5c), so claiming to "serve" Carlsbad
 *    would be asserting something the geography does not support. Naming the
 *    drive is both honest and the thing the reader actually wants to know.
 *
 * Anchor text is geo-modified — `Facials in La Jolla` — which is the T4b move:
 * the legitimate form of the keyword line, on a hub, where the link is a
 * genuine editorial choice. The footer's area links stay bare by contrast.
 */
const home = areas.find((a) => a.slug === 'mission-hills')!;
const rest = areas.filter((a) => a.slug !== 'mission-hills');
---

<section class="bg-porcelain">
  <div class="wrap section-y">
    <p class="t-eyebrow text-ink-soft">Getting here</p>
    <h2 class="t-h2 mt-5 max-w-[24ch]">Corrective facials near you — across San Diego County</h2>

    <p class="t-body mt-7 max-w-[62ch]">
      There is one studio, and it is off Washington Street, minutes from Hillcrest, Bankers
      Hill and Little Italy. Clients drive in from across San Diego County, so here is the
      honest distance from each.
    </p>

    <ul class="mt-14 grid list-none gap-x-10 gap-y-0 p-0 md:grid-cols-2">
      <Reveal as="li" class="border-b border-line md:col-span-2">
        <a href={`/service-areas/${home.slug}/`} class="group block py-7">
          <div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2">
            <h3 class="t-service text-[1.0625rem] transition-colors duration-300 group-hover:text-rose md:text-[1.3125rem]">
              {home.crossLinkLabel}
            </h3>
            <p class="t-body m-0 text-[0.9375rem] text-ink-soft">{home.proximity}</p>
          </div>
        </a>
      </Reveal>

      {
        rest.map((area) => (
          <Reveal as="li" class="border-b border-line">
            <a href={`/service-areas/${area.slug}/`} class="group block py-7">
              <div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2">
                <h3 class="t-service text-[1.0625rem] transition-colors duration-300 group-hover:text-rose md:text-[1.1875rem]">
                  {area.crossLinkLabel}
                </h3>
                <p class="t-body m-0 text-[0.9375rem] text-ink-soft">{area.proximity}</p>
              </div>
            </a>
          </Reveal>
        ))
      }
    </ul>

    <div class="mt-12">
      <a
        href="/service-areas/"
        class="t-button border-b border-ink pb-1 hover:border-rose hover:text-rose"
      >
        All areas across San Diego County
      </a>
    </div>
  </div>
</section>
