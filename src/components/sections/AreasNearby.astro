---
import Reveal from '../Reveal.astro';
import { areaShells } from '../../data/area-shells';
import { getServiceAreasForArea } from '../../data/service-areas-index';
import { areaServicePath, areasPath } from '../../config/urls';

/**
 * Closes the largest structural gap on the homepage: before this section
 * the homepage sent ZERO links to the area cluster, so those pages sat
 * outside the homepage's link graph entirely.
 *
 * Two deliberate departures from the pattern this site is modelled on:
 *
 * 1. These are real anchors. Rendering place names as bare <span>s measures
 *    as absent from the top 25 beyond a few kilometres. Unlinked place names
 *    do nothing; linked ones pass authority to pages that can actually rank.
 *
 * 2. The framing is proximity, not service area. Pack rankings decay with
 *    distance regardless of copy, so claiming to "serve" a city asserts
 *    something the geography does not support. Naming the drive is both honest
 *    and the thing the reader actually wants to know.
 *
 * Anchor text is geo-modified — `Facial in La Jolla` — which is the right form
 * of the keyword line, on a hub, where the link is a genuine editorial
 * choice. The footer's area links stay bare by contrast.
 *
 * Each area links to the facial service page for it, which is the broadest
 * entry point into that area's cluster.
 */
const rows = areaShells.map((shell) => {
  const records = getServiceAreasForArea(shell.slug);
  const facial = records.find((r) => r.service === 'facial');
  return {
    shell,
    href: facial ? areaServicePath(shell.slug, 'facial') : areasPath(),
  };
});
---

<section class="bg-porcelain">
  <div class="wrap section-y">
    <p class="t-eyebrow text-ink-soft">Getting here</p>
    <h2 class="t-h2 mt-5 max-w-[24ch]">Corrective facials near you — across San Diego County</h2>

    <p class="t-body mt-7 max-w-[62ch]">
      There is one studio, and it is off Washington Street — minutes from Hillcrest, Bankers Hill and
      Little Italy. Clients drive in from across San Diego County, so here is the honest distance from
      each.
    </p>

    <ul class="mt-14 grid list-none gap-x-10 gap-y-0 p-0 md:grid-cols-2">
      {
        rows.map(({ shell, href }) => (
          <Reveal as="li" class="border-b border-line">
            <a href={href} class="group block py-7">
              <div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2">
                <h3 class="t-service text-[1.0625rem] transition-colors duration-300 group-hover:text-rose md:text-[1.1875rem]">
                  {shell.name}
                </h3>
                <p class="t-body m-0 text-[0.9375rem] text-ink-soft">{shell.proximity}</p>
              </div>
            </a>
          </Reveal>
        ))
      }
    </ul>

    <div class="mt-12">
      <a
        href={areasPath()}
        class="t-button border-b border-ink pb-1 hover:border-rose hover:text-rose"
      >
        All areas across San Diego County
      </a>
    </div>
  </div>
</section>
