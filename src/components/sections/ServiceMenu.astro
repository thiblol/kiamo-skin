---
/**
 * ServiceMenu
 * -----------
 * The homepage's price list — every treatment, its published price, and the
 * filter tabs that narrow it by category.
 *
 * Why the homepage carries this rather than sending the reader to the
 * services index: a visitor who arrives on "facial san diego" is deciding
 * whether to book, and the price is the thing they need to see before
 * anything else. The full menu lives at /services/; this is the short form.
 *
 * The tabs work without JavaScript — every row renders and every filter
 * button exists in the HTML, and the script only ever hides rows. A reader
 * with JS blocked sees the whole menu.
 */
import { services, categories } from '../../data/services';
import { servicePath } from '../../config/urls';
import { business } from '../../config/business';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

/**
 * The price shown on each row.
 *
 * A service with several options shows its entry price — the figure a
 * first-time client is actually quoted. A service priced at consultation
 * shows that string rather than a number, because it is not a number and
 * setting it as one would be a claim the studio does not make.
 */
const rowPrice = (pricing?: { price: string }[]) => {
  if (!pricing || pricing.length === 0) return '';
  return pricing[0].price;
};
---

{/*
  The price list. It sits inside the treatments section rather than carrying
  one of its own: the tiles above it and the prices below it are the same
  topic, and two headings for one topic is what made this page read as a
  dump.
*/}
<div class={className}>
  <h3 class="t-h3 max-w-[26ch]">Every treatment, with its published price</h3>

  <div
  role="tablist"
  aria-label="Filter treatments by category"
  class="mt-8 flex flex-wrap gap-x-8 gap-y-2 border-b border-line"
  >
    <button
      type="button"
      role="tab"
      aria-selected="true"
      data-filter="all"
      class="t-eyebrow -mb-px border-b-2 border-transparent py-4 aria-selected:border-rose aria-selected:text-rose"
    >
      All
    </button>
    {
      categories.map((c) => (
        <button
          type="button"
          role="tab"
          aria-selected="false"
          data-filter={c}
          class="t-eyebrow -mb-px border-b-2 border-transparent py-4 aria-selected:border-rose aria-selected:text-rose"
        >
          {c}
        </button>
      ))
    }
  </div>

  {/* All rows render in the HTML and are visible by default, so the section
      works with JS disabled. The tabs only ever hide rows. */}
  <ul id="service-rows" class="m-0 list-none p-0">
    {
      services.map((s) => {
        const price = rowPrice(s.pricing);
        return (
          <li data-category={s.category} class="border-b border-line">
            <div class="group grid grid-cols-1 items-baseline gap-y-3 py-7 transition-colors duration-[280ms] ease-out hover:bg-porcelain md:grid-cols-[minmax(0,1fr)_auto] md:gap-x-10">
              <div class="min-w-0">
                <h3 class="t-service text-[1.0625rem] md:text-[1.3125rem]">
                  <a href={servicePath(s.slug)} class="hover:text-rose">
                    {s.name}
                  </a>
                </h3>
                <p class="t-body mt-2 text-[0.9375rem] text-ink-soft">{s.opener}</p>
              </div>

              <div class="flex items-center gap-6 md:justify-end">
                {price && <p class="t-price whitespace-nowrap transition-colors duration-[280ms] group-hover:text-rose">{price}</p>}
                <a
                  href={business.bookingUrl}
                  target="_blank"
                  rel="noopener"
                  class="t-button shrink-0 border-b border-ink pb-1 hover:border-rose hover:text-rose"
                >
                  Book<span class="sr-only"> {s.name}</span>
                </a>
              </div>
            </div>
          </li>
        );
      })
    }
  </ul>
</div>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('[role="tab"][data-filter]');
  const rows = document.querySelectorAll<HTMLElement>('#service-rows > li');

  const apply = (filter: string) => {
    rows.forEach((row) => {
      row.hidden = filter !== 'all' && row.dataset.category !== filter;
    });
    tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.filter === filter)));
  };

  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => apply(tab.dataset.filter!));

    tab.addEventListener('keydown', (e) => {
      const dir = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!dir) return;
      e.preventDefault();
      const next = tabs[(i + dir + tabs.length) % tabs.length];
      next.focus();
      apply(next.dataset.filter!);
    });
  });
</script>
