---
import { business } from '../../config/business';

/**
 * Scorpio's trust strip is `5+ years · 1000+ clients · 100% hygiene · 5.0 rating`.
 * Two of those four are numbers KIAMO cannot publish: the guard suite fails the
 * build on any rating, and no client count was ever verified.
 *
 * So this carries only what config/business.ts can prove. Every item is a fact
 * already stated elsewhere on the site, placed above the fold where the trust
 * question is actually being asked.
 */
const credentials = [
  { label: 'Licensed esthetician', detail: 'California Board of Barbering & Cosmetology' },
  { label: `${business.experience} in San Diego`, detail: 'Serving Mission Hills, Hillcrest, Little Italy' },
  { label: 'All skin types', detail: 'Safe, effective protocols for every skin tone' },
  { label: 'Clinical-grade equipment', detail: 'HydraFacial Syndeo · Procell MD · Professional peels' },
];
---

<section class="border-y border-line bg-porcelain">
  <div class="wrap py-12 md:py-16">
    <p class="t-eyebrow text-ink-soft">Why KIAMO</p>
    <h2 class="t-h2 mt-5 mb-10 max-w-[26ch]">Esthetician specialising in all skin types, Mission Hills</h2>
    <ul class="grid list-none grid-cols-2 gap-x-6 gap-y-9 p-0 md:grid-cols-4 md:gap-x-10">
      {
        credentials.map((c) => (
          <li>
            <p class="t-service text-[0.9375rem] md:text-[1rem]">{c.label}</p>
            <p class="t-body mt-2 text-[0.875rem] text-ink-soft">{c.detail}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
