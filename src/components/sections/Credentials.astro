---
/**
 * Why KIAMO Skin
 * --------------
 * The why-us proof section.
 *
 * It used to be three separate blocks — a credential grid, a centred
 * positioning quote, and a founder portrait with two paragraphs. Three
 * headings, one topic. They are one section now: the positioning line
 * leads, the founder and the credentials sit side by side underneath it.
 *
 * The quote is spec §2, Kiki's own words. Do not paraphrase or shorten it.
 *
 * All copy here is pronoun-free — spec §2. Kiki has never published
 * pronouns, and the guard suite fails the build on she/her.
 */
import { Image } from 'astro:assets';
import Reveal from '../Reveal.astro';
import PanelWipe from '../PanelWipe.astro';
import Button from '../Button.astro';
import CertificateModal from '../CertificateModal.astro';
import { business } from '../../config/business';
import portrait from '../../assets/kiki-california-licensed-esthetician-mission-hills.jpg';

/**
 * Scorpio's trust strip is `5+ years · 1000+ clients · 100% hygiene · 5.0 rating`.
 * Two of those four are numbers KIAMO Skin cannot publish: the guard suite fails the
 * build on any rating, and no client count was ever verified.
 *
 * So this carries only what config/business.ts can prove. Every item is a fact
 * already stated elsewhere on the site.
 */
const credentials = [
  { label: 'Licensed esthetician', detail: 'California Board of Barbering & Cosmetology' },
  { label: `${business.experience} in San Diego`, detail: 'Serving Hillcrest, Little Italy and North Park' },
  { label: 'All skin types', detail: 'Safe, effective protocols for every skin tone' },
  { label: 'Clinical-grade equipment', detail: 'HydraFacial Syndeo · Procell MD · Professional peels' },
];
---

<section class="bg-blush">
  <div class="wrap section-y">
    <Reveal>
      <p class="t-eyebrow text-ink-soft">Why KIAMO Skin</p>
      <h2 class="t-h2 mt-5 max-w-[26ch]">Esthetician specialising in all skin types in San Diego</h2>
    </Reveal>

    {/* Spec §2, Kiki's words verbatim. Do not paraphrase or shorten. */}
    <Reveal>
      <blockquote class="t-body mt-8 max-w-[62ch] text-[1.0625rem] text-ink-soft [text-wrap:balance]">
        This isn't just a spa facial. This is strategy, correction, intention. Every step has a
        purpose. Every product has a reason. Relaxing always — but results come first.
      </blockquote>
    </Reveal>

    <div class="mt-14 grid items-start gap-12 md:grid-cols-[0.85fr_1fr] md:gap-16">
      <Reveal>
        <PanelWipe class="aspect-3/4">
          <Image
            src={portrait}
            alt="Kiki, licensed esthetician and owner of KIAMO Skin, beside the HydraFacial device in the treatment room"
            widths={[400, 800, 1600]}
            sizes="(min-width: 840px) 40vw, 90vw"
            loading="lazy"
            class="size-full object-cover"
          />
        </PanelWipe>

        <p class="t-service mt-7 text-[1.125rem]">{business.ownerName}</p>
        <p class="t-body mt-2 text-[0.9375rem] text-ink-soft">
          California licensed esthetician · {business.experience}
        </p>
        <p class="t-body mt-4 text-[0.9375rem] italic text-ink-soft">
          "Trust the process. Your skin can heal."
        </p>

        <p class="t-body mt-5 text-[0.9375rem]">
          The work spans acne, acne scars, hyperpigmentation, melasma, barrier repair, age
          management and scalp health. Every plan is built around clinical-grade technique: the
          HydraFacial Syndeo platform, medical-grade chemical peels, and Procell MD
          microchanneling. Long-term results, without quick fixes that compromise the barrier.
        </p>

        <p class="t-body mt-4 text-[0.9375rem]">
          Every skin tone and skin type is welcome — sensitive, reactive, acne-prone, aging, or
          marked by post-inflammatory hyperpigmentation. Unlike a day spa built around relaxation,
          this is a clinical protocol in a calm, private room, and every client leaves with a plan
          built around their skin.
        </p>

        <div class="mt-7">
          <Button variant="ghost" href="/about/">More about the studio</Button>
        </div>
      </Reveal>

      <Reveal>
        <ul class="m-0 grid list-none grid-cols-2 gap-x-6 gap-y-9 p-0 md:gap-x-10">
          {
            credentials.map((c) => (
              <li class="border-t border-line pt-5">
                <p class="t-service text-[0.9375rem] md:text-[1rem]">{c.label}</p>
                <p class="t-body mt-2 text-[0.875rem] text-ink-soft">{c.detail}</p>
              </li>
            ))
          }
        </ul>

        <div class="mt-12 border-t border-line pt-9">
          <p class="t-body text-[0.875rem] text-ink-soft">
            Advanced certifications — click to view:
          </p>
          <div class="mt-5 flex gap-6">
            <CertificateModal
              id="cert-hydrafacial-home"
              image="/images/hydrafacial-certified-provider-san-diego.jpg"
              alt="HydraFacial Certified Provider certificate - KIAMO Skin, San Diego California"
              title="HydraFacial Certified Provider"
            />
            <CertificateModal
              id="cert-dmk-home"
              image="/images/dmk-certified-skin-therapist-kiki-kiamo.jpg"
              alt="DMK Certified Skin Therapist certificate - Kiki, KIAMO Skin San Diego"
              title="DMK Certified Skin Therapist"
            />
          </div>
        </div>
      </Reveal>
    </div>
  </div>
</section>
