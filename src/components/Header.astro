---
import Button from './Button.astro';
import MenuOverlay from './MenuOverlay.astro';
import { business } from '../config/business';
import { CTA_LABEL } from '../config/nav';
---

{/*
  The header CTA is hidden on mobile by the `hidden` utility, but the Button
  component's own base class also carries `inline-flex` — and Tailwind emits
  `.inline-flex` AFTER `.hidden` in the cascade, so the hidden class lost and
  the button rendered at every width. On a 390px screen that left the logo
  wrapped to two lines and the menu button squeezed to 35px.

  Fixing it inside Button would change every button on the site. Instead the
  mobile breakpoint is handled here, where the header decides its own layout:
  below `sm` the header carries the phone number and the menu only, and the
  sticky bottom bar carries the appointment CTA. Above `sm`, the header gets
  the full CTA back.

  The phone number is a real link with a real tap target — a local visitor
  whose intent is "call someone" should not have to hunt for it.

  CONTRAST. The header is transparent over the hero photograph, and the hero
  differs by page: the homepage hero is a light, warm interior, while the
  service heroes are a dark full-bleed photograph under a scrim. Ink-coloured
  text with a light halo reads on the first and disappears on the second.

  So the header reads its own theme from a data attribute on the document
  body, which the service pages set to `dark`. Over a dark hero the logo and
  the menu button switch to porcelain with a dark halo; once the reader
  scrolls past 80px the header turns porcelain and everything reverts to ink.
  The rose phone chip carries its own fill either way, so it never depends on
  what is behind it.
*/}
<header
  id="site-header"
  data-scrolled="false"
  class="group/header fixed inset-x-0 top-0 z-40 h-[60px] border-b border-transparent transition-colors duration-300 ease-out data-[scrolled=true]:border-line data-[scrolled=true]:bg-porcelain"
>
  <div class="wrap flex h-full items-center justify-between gap-3">
    <a
      href="/"
      class="header-ink font-display text-[1.25rem] uppercase tracking-[0.14em] whitespace-nowrap transition-[text-shadow] duration-300"
    >
      KIAMO Skin
      <span class="sr-only">— home</span>
    </a>

    <div class="flex items-center gap-3 sm:gap-4">
      {/* The phone number. Visible at every width.

          HIERARCHY. On desktop this sits beside the "Request Appointment"
          button, and both were painted the same rose — two identical pills of
          equal weight, so nothing said which one was the point of the header.
          From `sm` up the chip is now an outline and the appointment button
          keeps the fill, so the primary action reads as primary.

          Below `sm` the appointment button is hidden and this chip is the only
          conversion action in the header, so it keeps the filled treatment
          there. A visitor on a phone gets a tappable number from the first
          screen; a visitor on a desktop gets one clear primary button.

          The outline follows `currentColor`, which the header already flips
          between ink and porcelain with the theme, so the chip never depends
          on what is behind it in either the scrolled or unscrolled state. */}
      <a
        href={business.phone.href}
        class="header-ink header-phone t-body inline-flex h-[42px] items-center rounded-full px-4 text-[0.875rem] leading-none whitespace-nowrap transition-colors max-sm:bg-rose max-sm:hover:bg-rose-deep sm:text-[0.9375rem]"
        onclick="if(typeof gtag !== 'undefined') gtag('event', 'phone_click', {event_category: 'engagement', event_label: 'header', transport_type: 'beacon'});"
      >
        <span class="sr-only">Call the studio at </span>{business.phone.display}
      </a>

      <div class="hidden sm:block">
        <Button href={business.bookingUrl} external trackEvent="booking_click" eventLabel="header">
          {CTA_LABEL}
        </Button>
      </div>

      <button
        type="button"
        id="menu-open"
        aria-expanded="false"
        aria-controls="menu-overlay"
        class="header-ink flex size-11 shrink-0 items-center justify-center transition-[text-shadow] duration-300"
      >
        <span class="sr-only">Open menu</span>
        <svg width="20" height="10" viewBox="0 0 20 10" aria-hidden="true">
          <path d="M0 1h20M0 5h20M0 9h20" stroke="currentColor" stroke-width="1"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<MenuOverlay />

<script>
  // Spec §6 §1: transparent over the hero, porcelain + hairline past 80px.
  const header = document.getElementById('site-header');
  if (header) {
    const sync = () => {
      header.dataset.scrolled = String(window.scrollY > 80);
    };
    sync();
    window.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync, { passive: true });
  }
</script>

<style>
  /* The default: ink on a light hero, with a light halo so the wordmark
     holds against a bright photograph. */
  .header-ink {
    color: var(--color-ink);
    text-shadow: 0 1px 3px rgba(253, 251, 247, 0.95);
  }

  /* Over a dark hero: porcelain with a dark halo. The attribute is on the
     body, so the selector is scoped to the unscrolled state only — once the
     header turns porcelain on scroll, the ink colour comes back. */
  :global(body[data-header-theme='dark']) #site-header[data-scrolled='false'] .header-ink {
    color: var(--color-porcelain);
    text-shadow: 0 1px 4px rgba(34, 31, 29, 0.75);
  }

  /* The phone chip's outline, from `sm` up. Below that it is the only
     conversion action in the header and keeps its filled treatment.
     `currentColor` means the ring follows the theme — ink on a light hero,
     porcelain on a dark one, and ink again once the header turns porcelain
     on scroll — without a second rule. */
  @media (min-width: 40rem) {
    .header-phone {
      border: 1px solid color-mix(in srgb, currentColor 45%, transparent);
    }

    .header-phone:hover {
      border-color: var(--color-rose);
      color: var(--color-rose);
      text-shadow: none;
    }
  }
</style>
