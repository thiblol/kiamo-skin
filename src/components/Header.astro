---
import Button from './Button.astro';
import MenuOverlay from './MenuOverlay.astro';
import { business } from '../config/business';
import { CTA_LABEL } from '../config/nav';
---

{/*
  The header CTA is hidden on mobile by the `hidden` utility, but the Button
  component's own base class also carries `inline-flex` — and Tailwind emits
  `.inline-flex` AFTER `.hidden` in the cascade, so the hidden class lost and
  the button rendered at every width. On a 390px screen that left the logo
  wrapped to two lines and the menu button squeezed to 35px.

  Fixing it inside Button would change every button on the site. Instead the
  mobile breakpoint is handled here, where the header decides its own layout:
  below `sm` the header carries the phone number and the menu only, and the
  sticky bottom bar carries the appointment CTA. Above `sm`, the header gets
  the full CTA back.

  The phone number is a real link with a real tap target — a local visitor
  whose intent is "call someone" should not have to hunt for it.

  Contrast: the header is transparent over the hero photograph, and on mobile
  the top of that crop is a dark brown wall. Ink on that wall measures 2.7:1,
  and the softer ink used for the phone number measured 1.1:1 — unreadable.
  Two fixes, both driven by the header's existing scrolled state: the logo
  takes a porcelain halo while it is over the photograph, and the phone sits
  on a porcelain chip so it carries its own background. Once the header turns
  porcelain on scroll, both revert to their plain ink.
*/}
<header
  id="site-header"
  data-scrolled="false"
  class="group/header fixed inset-x-0 top-0 z-40 h-[60px] border-b border-transparent transition-colors duration-300 ease-out data-[scrolled=true]:border-line data-[scrolled=true]:bg-porcelain"
>
  <div class="wrap flex h-full items-center justify-between gap-3">
    <a
      href="/"
      class="font-display text-[1.25rem] uppercase tracking-[0.14em] whitespace-nowrap transition-[text-shadow] duration-300 group-data-[scrolled=false]/header:[text-shadow:0_1px_3px_rgba(253,251,247,0.95)]"
    >
      KIAMO Skin
      <span class="sr-only">— home</span>
    </a>

    <div class="flex items-center gap-3 sm:gap-4">
      {/* Visible at every width. Below `sm` this is the only conversion path
          in the header, so it needs to be readable, not an icon. The chip
          gives it a background of its own, so it never depends on what
          happens to be behind the transparent header. */}
      <a
        href={business.phone.href}
        class="t-body rounded-full bg-porcelain/90 px-3 py-1.5 text-[0.875rem] leading-none whitespace-nowrap text-ink shadow-[0_1px_3px_rgba(43,43,41,0.12)] transition-colors hover:text-rose sm:bg-transparent sm:px-0 sm:py-0 sm:text-[0.9375rem] sm:text-ink-soft sm:shadow-none"
        onclick="if(typeof gtag !== 'undefined') gtag('event', 'phone_click', {event_category: 'engagement', event_label: 'header', transport_type: 'beacon'});"
      >
        <span class="sr-only">Call the studio at </span>{business.phone.display}
      </a>

      <div class="hidden sm:block">
        <Button href={business.bookingUrl} external>{CTA_LABEL}</Button>
      </div>

      <button
        type="button"
        id="menu-open"
        aria-expanded="false"
        aria-controls="menu-overlay"
        class="flex size-11 shrink-0 items-center justify-center transition-[text-shadow] duration-300 group-data-[scrolled=false]/header:[text-shadow:0_1px_3px_rgba(253,251,247,0.95)]"
      >
        <span class="sr-only">Open menu</span>
        <svg width="20" height="10" viewBox="0 0 20 10" aria-hidden="true">
          <path d="M0 1h20M0 5h20M0 9h20" stroke="currentColor" stroke-width="1"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<MenuOverlay />

<script>
  // Spec §6 §1: transparent over the hero, porcelain + hairline past 80px.
  const header = document.getElementById('site-header');
  if (header) {
    const sync = () => {
      header.dataset.scrolled = String(window.scrollY > 80);
    };
    sync();
    window.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync, { passive: true });
  }
</script>
