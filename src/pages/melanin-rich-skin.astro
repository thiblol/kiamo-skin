---
/**
 * The melanin-rich skin specialism page.
 *
 * Targets the practitioner- and business-identity half of the melanin cluster
 * (`black esthetician san diego`, `black owned spa san diego`, `esthetician for
 * black skin`, `facials for black skin`). The condition half — melasma,
 * hyperpigmentation — deliberately stays on `/services/chemical-peel/`, which
 * already ranks-targets `chemical peel san diego` at 210/mo. Splitting the
 * intents keeps the two pages off each other's head terms.
 *
 * A geo H1 is correct here: like the area pages, the whole purpose of this page
 * is the geographic claim. Treatment-page H1s stay bare.
 *
 * Sourced claims link inline to the AAD and NIH. Nothing is written from memory,
 * and no outcome is promised.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Reveal from '../components/Reveal.astro';
import Button from '../components/Button.astro';
import NapBlock from '../components/NapBlock.astro';
import FaqList from '../components/FaqList.astro';
import PanelWipe from '../components/PanelWipe.astro';
import FaqSchema from '../components/schema/FaqSchema.astro';
import PageHero from '../components/PageHero.astro';
import BreadcrumbSchema from '../components/schema/BreadcrumbSchema.astro';
import { melaninFaqs } from '../data/melanin-faqs';
import { services } from '../data/services';
import { areaShells } from '../data/area-shells';
import { business, verifiedPrices } from '../config/business';
import { absolute, businessId, websiteId } from '../config/urls';
import { CTA_LABEL } from '../config/nav';
import pigmentation from '../assets/hyperpigmentation-treatment-melanin-rich-skin-san-diego.jpg';
import VerifiedProof from '../components/VerifiedProof.astro';
import { getServiceTestimonials } from '../data/testimonials';

const site = Astro.site;
const url = absolute('/melanin-rich-skin', site);

/* Ordered by how a client arrives at them, not by price. */
const concerns = [
  {
    slug: 'melasma',
    concern: 'Melasma and post-inflammatory hyperpigmentation',
    body: 'Post-inflammatory marks and melasma are worked through with a series of gentle professional peels, with strength escalating only as the skin tolerates it. There is no single-session version of pigmentation work.',
  },
  {
    slug: 'procell-microchanneling',
    concern: 'Acne scarring and uneven texture',
    body: 'Procell microchanneling stimulates repair without heat or light, which matters on melanin-rich skin because heat is itself a pigment trigger. Every pass is customised for skin tone.',
  },
  {
    slug: 'dmk-enzyme-therapy',
    concern: 'Skin that stings, flushes or reacts to everything',
    body: 'A damaged barrier has to be rebuilt before any corrective work begins. Treating pigmentation on reactive skin is how the marks get worse instead of better.',
  },
  {
    slug: 'hydrafacial',
    concern: 'Congestion, blackheads and dullness',
    body: 'Vortex extraction lifts congestion without the manual pressure that leaves marks behind on deeper skin tones. It is where most first visits start.',
  },
];

const featured = concerns
  .map((c) => {
    const service = services.find((s) => s.slug === c.slug);
    return service ? { ...c, service } : undefined;
  })
  .filter((c) => c !== undefined);

/* The strongest melanin-rich catchments in the county, per the area research. */
const catchments = ['chula-vista', 'north-park', 'la-mesa', 'hillcrest']
  .map((slug) => areaShells.find((a) => a.slug === slug))
  .filter((a) => a !== undefined);

const title = 'Hyperpigmentation for Melanin-Rich Skin | KIAMO Skin';
const description =
  'Black-owned facial spa in San Diego specializing in pigmentation treatment for melanin-rich skin. Melasma, dark spots, and PIH. Request an appointment.';

const webpage = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${url}#webpage`,
  url,
  name: title,
  description,
  isPartOf: { '@id': websiteId(site) },
  about: { '@id': businessId(site) },
  inLanguage: 'en-US',
};

const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${url}#service`,
  name: 'Hyperpigmentation Treatment for Melanin-Rich Skin',
  serviceType: 'Pigmentation treatment for melanin-rich skin',
  category: 'Dermatology',
  description:
    'Expert hyperpigmentation treatment for Black and brown skin in San Diego. Safe, effective care for melasma, post-inflammatory hyperpigmentation, and dark spots at a Black-owned studio in San Diego.',
  url,
  provider: { '@id': businessId(site) },
  areaServed: business.areaServed.map((name) => ({ '@type': 'Place', name })),
  audience: {
    '@type': 'PeopleAudience',
    name: 'Clients with melanin-rich skin seeking pigmentation treatment',
  },
};
---

<BaseLayout {title} {description}
  headerTheme="dark">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(webpage)} slot="head" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(service)} slot="head" />
  <FaqSchema slot="head" faqs={melaninFaqs} />
  <BreadcrumbSchema
    slot="head"
    trail={[{ name: 'Melanin-Rich Skin', path: '/melanin-rich-skin' }]}
  />

  <article>
    {/* The hero. The photograph is the background, so the page opens on the
        thing it is actually about.

        The H1 used to end "for melanin-rich skin in San Diego", which put it
        on the same query as /service-areas/san-diego/hyperpigmentation-treatment/
        — two pages, both "hyperpigmentation treatment in San Diego". The
        San Diego area page owns the geo query; this page is the one that
        owns the treatment itself, for every skin tone and every city the
        studio serves. The geo stays in the eyebrow, the title and the
        address, where it belongs for a page whose job is the treatment. */}
    <PageHero
      eyebrow="Black-owned · San Diego · Every Fitzpatrick type, I–VI"
      h1="Expert pigmentation treatment"
      h1Accent="for melanin-rich skin"
      claim="Melasma, post-inflammatory hyperpigmentation and uneven tone, treated with the pigment protocols written for darker skin tones rather than adjusted for them afterwards."
      paragraph="KIAMO Skin is San Diego's Black-owned facial spa. The depth is in the protocols: melanin-rich skin responds to trauma by producing more pigment, so strength is escalated only as the barrier allows, and every treatment and peel is selected with that in mind."
      image={pigmentation}
      imageAlt="A brightening treatment being applied to the cheek of a client with deep brown skin at the KIAMO Skin studio in Mission Hills, San Diego"
      price={{ label: 'First-time client treatment', price: verifiedPrices['first-time-client'] }}
      trust={[
        { label: 'Safe for every Fitzpatrick type, I–VI' },
        { label: 'Pigment protocols written for deeper tones' },
        { label: 'Kiki, licensed esthetician, 7+ years' },
        { label: 'Prices published before a booking is made' },
      ]}
      reassurance={[
        business.visit.appointmentOnly,
        business.visit.parking,
        'Free cancellation up to 48 hours before',
      ]}
      current="Melanin-Rich Skin"
      eventLabel="melanin_hero"
    />

    <section class="bg-porcelain">
      <div class="wrap section-y grid items-center gap-12 md:grid-cols-[1fr_0.85fr] md:gap-20">
        <div>
          <Reveal>
            <h2 class="t-h3">Why dark marks behave differently</h2>
            <p class="t-body mt-7">
              Melanin-rich skin answers inflammation by producing more pigment. Post-inflammatory
              hyperpigmentation is most common and most severe in <a
                href="https://www.ncbi.nlm.nih.gov/books/NBK559150/"
                target="_blank"
                rel="noopener"
                class="border-b border-ink/30 hover:border-rose hover:text-rose"
                >Fitzpatrick skin types IV to VI</a
              >, because those melanocytes are more reactive — and in people with darker skin who
              have acne, the incidence runs as high as 65 percent.
            </p>
            <p class="t-body mt-6">
              Depth decides the timeline. Pigment sitting in the surface layers usually clears over
              six to twelve months; pigment that has dropped deeper can take years and resists
              treatment far more stubbornly. That is the honest reason corrective work here is
              planned as a series and paced deliberately, and why the cause gets controlled before
              anyone starts fading the mark. It is also why pigmentation is usually run on a <a
                href="/membership/"
                class="border-b border-ink/40 hover:border-rose hover:text-rose"
                >monthly treatment plan</a
              > rather than booked visit by visit.
            </p>
            <p class="t-body mt-6">
              Not every dark mark is the same condition, and the difference decides the treatment.
              This guide to <a
                href="/journal/three-kinds-of-dark-mark/"
                class="border-b border-ink/40 hover:border-rose hover:text-rose"
                >telling post-inflammatory marks, melasma and sun damage apart</a
              > covers how each one behaves and what a facial can honestly do about it.
            </p>
            <p class="t-body mt-6">
              It is also why an aggressive treatment is the wrong answer. Over-treating this skin
              produces the exact pigmentation it was meant to clear, which is the single most
              common way melanin-rich skin gets damaged in a treatment room. Needling is where that
              shows up most often, and <a
                href="/journal/microneedling-on-dark-skin-san-diego/"
                class="border-b border-ink/40 hover:border-rose hover:text-rose"
                >why depth decides the outcome on melanin-rich skin</a
              > is worth reading before booking it anywhere.
            </p>
          </Reveal>
        </div>

        <PanelWipe class="aspect-3/4">
          <Image
            src={pigmentation}
            alt="Close portrait of even, clear skin in warm natural light"
            widths={[400, 800, 1200]}
            sizes="(min-width: 840px) 40vw, 90vw"
            loading="lazy"
            class="size-full object-cover"
          />
        </PanelWipe>
      </div>
    </section>

    <section class="bg-espresso text-porcelain">
      <div class="wrap section-y">
        <p class="t-eyebrow text-porcelain/60">How we work</p>
        <h2 class="t-h2 mt-5 max-w-[24ch]">An inclusive space where everyone feels seen.</h2>
        <p class="t-body mt-7 max-w-[62ch] text-porcelain/75">
          KIAMO Skin is proud to be a Black-owned business committed to creating an inclusive space
          where everyone feels seen, valued, and cared for. That is the reason clients travel in
          from across San Diego County — being assessed by someone who has treated skin like the client’s
          before is not a small thing.
        </p>
        <div class="mt-10">
          <Button href="/about/" variant="ghost">Meet your esthetician</Button>
        </div>
      </div>
    </section>

    <section class="bg-ivory">
      <div class="wrap section-y grid gap-16 md:grid-cols-[1fr_0.7fr] md:gap-20">
        <div>
          <Reveal>
            <h2 class="t-h3">Treatments chosen for melanin-rich skin</h2>
            <p class="t-body mt-7 max-w-[62ch]">
              The first visit is an assessment, not a fixed protocol. What gets used depends on what
              the skin is doing on the day.
            </p>
            <ul class="mt-12 m-0 list-none p-0">
              {
                featured.map((item) => (
                  <li class="border-b border-line">
                    <a href={`/services/${item.service.slug}/`} class="group block py-7">
                      <h3 class="t-service text-[1.0625rem] transition-colors duration-300 group-hover:text-rose md:text-[1.1875rem]">
                        {item.concern}
                      </h3>
                      <p class="t-body mt-3 text-[0.9375rem] text-ink-soft">{item.body}</p>
                      <p class="t-meta mt-3 text-rose">{item.service.name}</p>
                    </a>
                  </li>
                ))
              }
            </ul>
            <p class="t-body mt-9 text-[0.9375rem]">
              <a
                href="/services/"
                class="border-b border-ink pb-1 hover:border-rose hover:text-rose"
              >
                See the full treatment menu in San Diego
              </a>
            </p>
            <p class="t-body mt-5 text-[0.9375rem] text-ink-soft">
              Dermaplaning uses no heat and no acid, which makes it one of the few surface
              exfoliations safe across every Fitzpatrick type. The
              <a
                href="/journal/dermaplaning-safe-dark-skin-san-diego/"
                class="border-b border-ink/40 hover:border-rose hover:text-rose"
                >dermaplaning guide for Black and brown skin</a
              > covers blade technique, California scope-of-practice, and when to time it
              between corrective peels.
            </p>
          </Reveal>

          <Reveal class="mt-16 block">
            <h2 class="t-h3">Protecting the result in San Diego</h2>
            <p class="t-body mt-7">
              Sunscreen is the treatment, not the afterthought. For deeper skin tones the American
              Academy of Dermatology recommends a <a
                href="https://www.aad.org/public/everyday-care/skin-care-secrets/routine/fade-dark-spots"
                target="_blank"
                rel="noopener"
                class="border-b border-ink/30 hover:border-rose hover:text-rose"
                >tinted sunscreen containing iron oxide</a
              > at SPF 30 or higher, because iron oxide blocks visible light — and visible light worsens
              melasma and dark spots in a way that a standard UVA/UVB sunscreen does not address.
            </p>
            <p class="t-body mt-6">
              San Diego makes that harder than it sounds. The overcast mornings are the usual reason
              people stop applying it, and the UV is still there behind the marine layer. The same
              guidance is blunt about irritation: <a
                href="https://www.aad.org/public/diseases/a-z/melasma-self-care"
                target="_blank"
                rel="noopener"
                class="border-b border-ink/30 hover:border-rose hover:text-rose"
                >stop any product that burns or stings</a
              >, because irritating the skin may darken the spots a client is trying to clear.
            </p>
          </Reveal>
        </div>

        <aside>
          <div class="border border-line bg-porcelain p-8">
            <h2 class="t-eyebrow text-ink-soft">The studio</h2>
            <div class="mt-7">
              <NapBlock tone="light" />
            </div>
            <div class="mt-8">
              <Button href={business.bookingUrl} external class="w-full">{CTA_LABEL}</Button>
            </div>
          </div>
        </aside>
      </div>
    </section>


  {/* The proof.

      The rating and the review count appeared on exactly two pages of the
      site — the homepage and /reviews. Every commercial page argued for the
      studio in the studio's own voice. This band puts the objective figure
      and two client voices on the page, which is both what a reader deciding
      whether the drive is worth it needs, and what an answer engine weights. */}
  <section class="bg-blush py-16 md:py-20">
    <div class="wrap">
      <div class="mx-auto max-w-[68ch]">
        <Reveal>
          <p class="t-eyebrow text-ink-soft">From the treatment room</p>
          <h2 class="t-h2 mt-4 max-w-[26ch]">What clients say once they have been in.</h2>
        </Reveal>
        <div class="mt-10">
          <VerifiedProof quotes={getServiceTestimonials('melanin')} />
        </div>
      </div>
    </div>
  </section>

    <section class="bg-porcelain">
      <div class="wrap section-y">
        <p class="t-eyebrow text-ink-soft">Before a booking is made</p>
        <h2 class="t-h2 mt-5">Questions</h2>
        <div class="mt-12 max-w-[74ch]">
          <FaqList faqs={melaninFaqs} />
        </div>
      </div>
    </section>

    <section class="bg-ivory">
      <div class="wrap section-y">
        <h2 class="t-h3">Travelling in across San Diego County</h2>
        <p class="t-body mt-7 max-w-[62ch]">
          The studio is in San Diego, and clients come in from across the county for this work.
        </p>
        <ul class="mt-10 m-0 grid list-none gap-x-10 gap-y-0 p-0 md:grid-cols-2">
          {
            catchments.map((area) => (
              <li class="border-b border-line">
                <a href={`/service-areas/${area.slug}/facial/`} class="group block py-7">
                  <h3 class="t-service text-[1.0625rem] transition-colors duration-300 group-hover:text-rose md:text-[1.1875rem]">
                    Facials in {area.name}
                  </h3>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="t-body mt-8 text-[0.9375rem]">
          <a href="/services/hyperpigmentation-treatment/" class="border-b border-ink pb-1 hover:border-rose hover:text-rose">
            Hyperpigmentation treatment across San Diego neighborhoods
          </a>{' '}
          ·{' '}
          <a href="/services/hydrafacial/" class="border-b border-ink pb-1 hover:border-rose hover:text-rose">
            HydraFacial across San Diego neighborhoods
          </a>{' '}
          ·{' '}
          <a href="/service-areas/" class="border-b border-ink pb-1 hover:border-rose hover:text-rose">
            See all areas served across San Diego County
          </a>
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
          <Button href={business.bookingUrl} external>{CTA_LABEL}</Button>
          <a
            href={business.phone.href}
            class="t-body border-b border-ink pb-1 hover:border-rose hover:text-rose"
          >
            {business.phone.display}
          </a>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>
