---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Reveal from '../../../components/Reveal.astro';
import Button from '../../../components/Button.astro';
import NapBlock from '../../../components/NapBlock.astro';
import GeoArticleSchema from '../../../components/schema/GeoArticleSchema.astro';
import BreadcrumbSchema from '../../../components/schema/BreadcrumbSchema.astro';
import FaqSchema from '../../../components/schema/FaqSchema.astro';
import { geoArticles, getGeoArticle } from '../../../data/geo-articles';
import { getArea } from '../../../data/areas';
import { business } from '../../../config/business';
import { CTA_LABEL } from '../../../config/nav';

export function getStaticPaths() {
  return geoArticles.map((article) => ({
    params: {
      area: article.areaSlug,
      article: article.slug,
    },
  }));
}

const { area: areaSlug, article: articleSlug } = Astro.params;
const article = getGeoArticle(areaSlug!, articleSlug!);
const area = getArea(areaSlug!);

if (!article || !area) {
  return Astro.redirect('/404');
}

const breadcrumbs = [
  { name: 'Service Areas', path: '/service-areas/' },
  { name: area.name, path: `/service-areas/${area.slug}/` },
  { name: article.h1, path: `/service-areas/${area.slug}/${article.slug}/` },
];
---

<BaseLayout title={article.title} description={article.description} ogType="article">
  <GeoArticleSchema slot="head" article={article} />
  <BreadcrumbSchema slot="head" trail={breadcrumbs} />
  <FaqSchema slot="head" faqs={article.faqs} />

  <article>
    <!-- Hero Section -->
    <section class="bg-porcelain pt-[calc(60px+72px)] md:pt-[calc(60px+112px)]">
      <div class="wrap pb-16 pt-12 md:pb-20 md:pt-16">
        <div class="mx-auto max-w-[46rem]">
          <Reveal>
            <nav class="t-body mb-8 text-[0.875rem] text-ink-soft">
              <a href="/service-areas/" class="hover:text-rose">Service Areas</a>
              <span class="mx-2">/</span>
              <a href={`/service-areas/${area.slug}/`} class="hover:text-rose">{area.name}</a>
            </nav>
          </Reveal>

          <Reveal delay={100}>
            <h1 class="t-h1">{article.h1}</h1>
          </Reveal>

          <!-- Quick Answer Block (Speakable) -->
          <Reveal delay={200}>
            <div
              class="quick-answer mt-10 border-l-4 border-rose bg-ivory px-8 py-6 text-[1.0625rem] leading-relaxed"
            >
              <p class="m-0">{article.quickAnswer}</p>
            </div>
          </Reveal>
        </div>
      </div>
    </section>

    <!-- Main Content -->
    <section class="bg-porcelain">
      <div class="wrap pb-20">
        <div class="mx-auto max-w-[46rem]">
          <Reveal>
            <div class="article-content" set:html={article.body} />
          </Reveal>
        </div>
      </div>
    </section>

    <!-- FAQs -->
    <section class="bg-ivory">
      <div class="wrap section-y">
        <div class="mx-auto max-w-[46rem]">
          <Reveal>
            <h2 class="t-h3">Frequently Asked Questions</h2>
          </Reveal>

          <div class="mt-10 space-y-8">
            {
              article.faqs.map((faq, i) => (
                <Reveal delay={i * 50}>
                  <div>
                    <h3 class="t-service mb-3 text-[1.125rem]">{faq.question}</h3>
                    <p class="t-body m-0 text-[0.9375rem] leading-relaxed text-ink-soft">
                      {faq.answer}
                    </p>
                  </div>
                </Reveal>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Related Links -->
    <section class="wrap section-y">
      <div class="mx-auto max-w-[46rem]">
        <Reveal>
          <h2 class="t-h3">Related Treatments & Areas</h2>
        </Reveal>

        <Reveal delay={100}>
          <ul class="mt-8 space-y-3 text-[0.9375rem]">
            {
              article.relatedLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="border-b border-ink/40 pb-1 hover:border-rose hover:text-rose"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </Reveal>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="bg-ivory">
      <div class="wrap section-y">
        <div class="mx-auto max-w-[46rem] text-center">
          <Reveal>
            <h2 class="t-h3">Ready to rebuild your barrier?</h2>
            <p class="t-body mt-6 text-[1rem] text-ink-soft">
              Book a consultation at KIAMO Skin in Mission Hills.
            </p>
          </Reveal>

          <Reveal delay={100}>
            <div class="mt-10 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
              <Button href={business.bookingUrl} external>{CTA_LABEL}</Button>
              <Button variant="ghost" href={`/service-areas/${area.slug}/`}>
                View {area.name} page
              </Button>
            </div>
          </Reveal>

          <Reveal delay={200}>
            <div class="mt-10">
              <p class="t-body text-[0.9375rem] text-ink-soft">
                <strong class="font-medium text-ink">3067 Reynard Way, Mission Hills</strong><br />
                <a href={business.phone.href} class="border-b border-ink/40 pb-1 hover:border-rose hover:text-rose">
                  {business.phone.display}
                </a>
              </p>
            </div>
          </Reveal>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .article-content {
    font-size: 1rem;
    line-height: 1.75;
  }

  .article-content h2 {
    margin-top: 3rem;
    margin-bottom: 1.5rem;
  }

  .article-content p {
    margin-bottom: 1.5rem;
  }

  .article-content a {
    transition: all 0.2s ease;
  }

  @media (min-width: 768px) {
    .article-content {
      font-size: 1.0625rem;
    }
  }
</style>
