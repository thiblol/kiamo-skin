---
/**
 * /service-areas/{area}/{service}/ — the service-and-city page.
 *
 * "HydraFacial in Carlsbad". The page's whole claim is that the studio is
 * somewhere else and the drive is worth it, so the city's geography — the
 * drive time, the landmarks, the local skin concern — is merged into the
 * page rather than bolted on.
 *
 * The URL hangs under the AREA, not under the service. That is the model the
 * reference project uses, and it is the right one: a reader's intent is "a
 * treatment, where I live", and the URL should read that way round. It also
 * makes the area hub the natural parent of every service page for that city.
 */
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ServicePage from '../../../../components/ServicePage.astro';
import ServiceAreaSchema from '../../../../components/schema/ServiceAreaSchema.astro';
import BreadcrumbSchema from '../../../../components/schema/BreadcrumbSchema.astro';
import FaqSchema from '../../../../components/schema/FaqSchema.astro';
import WebPageSchema from '../../../../components/schema/WebPageSchema.astro';
import PersonSchema from '../../../../components/schema/PersonSchema.astro';
import { services, heroPriceFor } from '../../../../data/services';
import {
  serviceAreas,
  getServiceAreasForService,
  getServiceAreasForArea,
} from '../../../../data/service-areas-index';
import { servicePath, areaPath, areaServicePath, areaPlaceLabel, areaMapPlace } from '../../../../config/urls';
import { areaImages, areaImageAlts } from '../../../../data/area-images';
import { AREA_CLUSTER, CONTENT_REVISED } from '../../../../data/page-dates';
import { serviceAreaHeroes } from '../../../../data/service-area-heroes';

export function getStaticPaths() {
  return serviceAreas.map((record) => ({
    params: { area: record.area, service: record.service },
    props: { record },
  }));
}

const { record } = Astro.props;

const service = services.find((s) => s.slug === record.service);

/**
 * The place label: "La Jolla, San Diego, CA".
 *
 * The area pages used to name the neighbourhood and sometimes the city, and
 * never the state. A reader types the postal form, so the label carries all
 * three parts, and the city the studio is in overrides the default because
 * "San Diego, San Diego, CA" is not a place.
 */
const placeLabel = record.placeLabel ?? areaPlaceLabel(record.area, record.name);

/**
 * The place, without the state.
 *
 * "La Jolla, San Diego" for the heading, where the state would push the
 * heading onto a third line. The state is still on the page — in the title,
 * the eyebrow, the description and the body.
 */
const h1Place = placeLabel.replace(/, CA$/, '');

/**
 * The title, with the state.
 *
 * The records were written with the city but not the state, and the state is
 * what a reader types — "facial la jolla ca". The place is added where the
 * 60-character guard allows it. Where it does not fit, the title keeps its
 * original wording and the place still names the page in the heading, the
 * eyebrow, the description and the body.
 *
 * The local angle in the record titles — "HydraFacial for Ocean Swimmers La
 * Jolla" — is kept. That angle is the differentiation between two pages
 * about the same treatment, and it is a large part of what keeps the cluster
 * from reading as a doorway page.
 */
const title = (() => {
  const head = record.title.replace(/ \| KIAMO Skin$/, '');
  if (head.includes('CA')) return record.title;
  const withState = `${head}, CA`;
  return withState.length + ' | KIAMO Skin'.length <= 60
    ? `${withState} | KIAMO Skin`
    : record.title;
})();

/** The display name of a service, for the sibling link labels. */
const serviceName = (slug: string) => services.find((s) => s.slug === slug)?.name ?? slug;

/**
 * The two sibling sets.
 *
 * The other services in this city, and the same service in the other cities
 * that offer it. Between them every service×city page is reachable from its
 * area hub, from its national service page, and from its siblings — no page
 * in the cluster is an orphan.
 */
const siblingServices = getServiceAreasForArea(record.area)
  .filter((r) => r.service !== record.service)
  .map((r) => ({
    name: serviceName(r.service),
    href: areaServicePath(r.area, r.service),
    note: r.crossLinkLabel,
  }));

/**
 * The hero for this specific pair.
 *
 * The treatment comes first and the city follows, because the city is the
 * reason THIS treatment matters here — the salt air in Encinitas, the inland
 * UV in Chula Vista, the highest UV index in the country in San Diego.
 *
 * The claim and the paragraph are written per pair, in
 * `data/service-area-heroes.ts`. They used to come from the service's own
 * hero, which meant "HydraFacial in La Jolla" and "HydraFacial in Carlsbad"
 * opened with the same two sentences differing by one clause — the doorway
 * pattern Google's guidance describes, and 1,329 page pairs in this cluster
 * sharing more than a quarter of their wording. The per-pair text is what
 * removes it, and it is also where the brand belongs: a hero that could be
 * published by any studio in any city is not what this cluster needs.
 */
const pairHero = serviceAreaHeroes[`${record.service}:${record.area}`];

const heroParagraph = pairHero?.paragraph ?? service?.hero.paragraph ?? record.opener;
const heroClaim = pairHero?.claim ?? service?.hero.claim ?? record.opener;

const siblingCities = getServiceAreasForService(record.service)
  .filter((r) => r.area !== record.area)
  .map((r) => ({
    name: `${serviceName(record.service)} in ${r.name}`,
    href: areaServicePath(r.area, record.service),
    note: r.proximity,
  }));
---

<BaseLayout title={record.title} description={record.description} headerTheme="dark">
  <ServiceAreaSchema slot="head" record={record} service={service} />
  <BreadcrumbSchema
    slot="head"
    trail={[
      { name: 'Service Areas', path: '/service-areas/' },
      { name: record.name, path: areaPath(record.area) },
      { name: service?.name ?? record.service, path: areaServicePath(record.area, record.service) },
    ]}
  />
  {record.faqs.length > 0 && <FaqSchema slot="head" faqs={record.faqs} />}
  <WebPageSchema
    slot="head"
    url={areaServicePath(record.area, record.service)}
    name={record.title}
    description={record.description}
    datePublished={record.datePublished ?? AREA_CLUSTER}
    dateModified={record.dateModified ?? CONTENT_REVISED}
  />
  <PersonSchema slot="head" />

  <ServicePage
    mode="area"
    title={record.title}
    description={record.description}
    h1={record.h1}
    opener={record.opener}
    quickAnswer={record.quickAnswer}
    authority={record.authority}
    uniqueness={record.uniqueness}
    depth={record.depth}
    intent={record.intent}
    localConcern={record.localConcern}
    landmarks={record.landmarks}
    gettingHereHeading={
      record.area === 'san-diego' ? 'Landmarks across San Diego' : `Landmarks in ${record.name}`
    }
    mapPlace={areaMapPlace(record.area, placeLabel)}
    steps={record.depth.process}
    pricing={service?.pricing}
    planMembers={service?.planMembers}
    body={record.body}
    faqs={record.faqs}
    trustSlug={record.service}
    ancestors={[
      { name: 'Service Areas', path: '/service-areas/' },
      { name: record.name, path: areaPath(record.area) },
    ]}
    current={record.name}
    cityName={record.name}
    areaSlug={record.area}
    siblingServices={siblingServices}
    siblingCities={siblingCities}
    hero={{
      eyebrow: placeLabel,
      serviceName: service?.name ?? record.service,
      cityName: h1Place,
      claim: heroClaim,
      paragraph: heroParagraph,
      image: areaImages[record.area],
      imageAlt: areaImageAlts[record.area],
      price: service ? heroPriceFor(service) : undefined,
      trust: service?.hero.trust ?? [],
    }}
  />
</BaseLayout>
