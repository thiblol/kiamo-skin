---
/**
 * /service-areas/{area}/ — the area hub.
 *
 * "Facials in Carlsbad". The parent of every service page for that city,
 * and the page that answers "does KIAMO Skin serve my area, and what do a client does for
 * the skin people here actually have".
 *
 * It is a separate top-level section from /services/. A reader who knows
 * what treatment they want goes to /services/; a reader who knows where they
 * live goes to /service-areas/. Both are linked from the homepage, and the
 * service×city pages sit under the area hub, one click from both.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Reveal from '../../../components/Reveal.astro';
import Button from '../../../components/Button.astro';
import NapBlock from '../../../components/NapBlock.astro';
import LocationMap from '../../../components/LocationMap.astro';
import BreadcrumbSchema from '../../../components/schema/BreadcrumbSchema.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import PageHero from '../../../components/PageHero.astro';
import BrandFacts from '../../../components/BrandFacts.astro';
import FaqSchema from '../../../components/schema/FaqSchema.astro';
import FaqList from '../../../components/FaqList.astro';
import RequestBand from '../../../components/sections/RequestBand.astro';
import VerifiedProof from '../../../components/VerifiedProof.astro';
import WebPageSchema from '../../../components/schema/WebPageSchema.astro';
import { getAreaTestimonials } from '../../../data/testimonials';
import { areaImages, areaImageAlts } from '../../../data/area-images';
import { AREA_CLUSTER, CONTENT_REVISED } from '../../../data/page-dates';
import AreaServiceSchema from '../../../components/schema/AreaServiceSchema.astro';
import { areaShells } from '../../../data/area-shells';
import { services } from '../../../data/services';
import { areaFaqs } from '../../../data/area-faqs';
import {
  serviceAreas,
  getServiceAreasForArea,
} from '../../../data/service-areas-index';
import { areaPath, areaServicePath, servicePath, areaPlaceLabel, areaMapPlace } from '../../../config/urls';
import { business, verifiedPrices } from "../../../config/business";
import { CTA_LABEL } from '../../../config/nav';

export function getStaticPaths() {
  // Only an area with at least one service page gets a hub of its own —
  // an area page with nothing under it is a dead end.
  const covered = new Set(serviceAreas.map((r) => r.area));
  return areaShells
    .filter((shell) => covered.has(shell.slug))
    .map((shell) => ({
      params: { area: shell.slug },
      props: { shell },
    }));
}

const { shell } = Astro.props;

/** The clients who made the drive from this city. */
const areaTestimonials = getAreaTestimonials(shell.slug);

/** The services available to clients from this city. */
const rows = getServiceAreasForArea(shell.slug).map((record) => ({
  record,
  service: services.find((s) => s.slug === record.service),
}));

/**
 * The other cities, for the lateral edge.
 *
 * Every area links to every other area, which is what keeps the cluster a
 * graph rather than a set of isolated pages.
 */
const nearby = areaShells
  .filter((s) => s.slug !== shell.slug)
  .map((s) => ({ shell: s, rows: getServiceAreasForArea(s.slug).length }))
  .filter((s) => s.rows > 0);

/**
 * The area's questions.
 *
 * These come from `data/area-faqs.ts` rather than from a template, because
 * a question a client from La Jolla actually asks is not the same question a
 * client from Chula Vista asks, and eight identical questions on ten pages is
 * the duplication the whole cluster was measured for. Each area carries five
 * questions written for the area it belongs to, and every answer names
 * KIAMO Skin and says what the studio specifically does.
 */
const faqs = areaFaqs[shell.slug] ?? [];
/**
 * The place label: "La Jolla, San Diego, CA".
 *
 * The area pages used to name the neighbourhood and sometimes the city, and
 * never the state. A reader types the postal form, so the label carries all
 * three parts — and the city the studio is in overrides the default, because
 * "San Diego, San Diego, CA" is not a place.
 */
const placeLabel = shell.placeLabel ?? areaPlaceLabel(shell.slug, shell.name);

/**
 * The title and description.
 *
 * Built from a fixed shape rather than interpolated from the area record,
 * because the record's own fields are long — the guard suite caps a
 * description at 155 characters, and a template that quotes the proximity
 * string blows straight through it.
 *
 * The description opens with the brand and carries a call to action, which
 * is what earns the click. The CTA is chosen by how much room the place
 * label leaves: the longer labels get the shorter CTA, so every area lands
 * inside the cap instead of some running past it and others running short of
 * the snippet.
 *
 * It used to open "KIAMO Skin. Corrective facials in ${placeLabel}." — the
 * H1's own words, repeated. A description that echoes the heading tells a
 * search engine the page has nothing else to say, and it handed the city
 * page the same first line the homepage used. It now says where the studio
 * is and what it does from there, which is a different fact from the
 * heading's.
 *
 * The service list dropped dermaplaning to keep the longest place label —
 * "Pacific Beach, San Diego, CA" — inside the 155-character cap at 152. The
 * page body and the treatment list below the fold still carry it.
 *
 * THE STUDIO'S OWN CITY GETS A DIFFERENT TITLE
 *   The San Diego hub was "Facials in San Diego, CA | KIAMO Skin" and its own
 *   facial leaf page is "Facial in San Diego, CA | KIAMO Skin" — one word
 *   apart, on two pages that both answer "facial in San Diego".
 *
 *   The studio's city page is the one that carries the corrective
 *   positioning, so it says so: "Corrective Facials in San Diego, CA". The
 *   neighbourhood hubs keep the general "Facials in …" form, because a
 *   neighbourhood page argues that the drive is worth it rather than that
 *   the work is corrective, and "Corrective Facials in Pacific Beach, San
 *   Diego, CA" would not fit inside the 60-character title cap anyway.
 */
const title = shell.isStudioCity
  ? `Corrective Facials in ${placeLabel} | KIAMO Skin`
  : `Facials in ${placeLabel} | KIAMO Skin`;
const description = `KIAMO Skin serves ${placeLabel} from Mission Hills. Corrective facials, HydraFacial, peels and scalp therapy. From $199. Request a visit.`;
---

<BaseLayout
  title={title}
  description={description}
  headerTheme="dark"
>
  <AreaServiceSchema slot="head" shell={shell} />
  <BreadcrumbSchema
    slot="head"
    trail={[
      { name: 'Service Areas', path: '/service-areas/' },
      { name: shell.name, path: areaPath(shell.slug) },
    ]}
  />
  <FaqSchema slot="head" faqs={faqs} />
  <WebPageSchema
    slot="head"
    url={areaPath(shell.slug)}
    name={title}
    description={description}
    datePublished={AREA_CLUSTER}
    dateModified={CONTENT_REVISED}
  />

  <article>
    {/* The hero. The city's own photograph is the background, the copy sits
        over it, and the drive — the thing a reader from out of town is
        actually deciding about — is in the first screen rather than a
        section further down. */}
    <PageHero
      eyebrow={placeLabel}
      h1="Corrective facials"
      h1Accent={`in ${placeLabel}`}
      h1Width="24ch"
      claim={shell.localConcern.body.split('. ')[0] + '.'}
      paragraph={`<a href="/" class="border-b border-blush/60 hover:text-blush">KIAMO Skin</a> treats clients from ${shell.name} at its Mission Hills studio — ${shell.proximity}. Free parking on site, by appointment only, and a corrective plan mapped before a booking is made.`}
      image={areaImages[shell.slug]}
      imageAlt={areaImageAlts[shell.slug]}
      price={{ label: 'First-time client treatment', price: verifiedPrices['first-time-client'] }}
      trust={[
        { label: 'Free parking on site' },
        { label: 'Kiki performs every treatment' },
        { label: 'Prices published before a booking is made' },
        { label: 'Safe for every Fitzpatrick type, I–VI' },
      ]}
      reassurance={[
        business.visit.appointmentOnly,
        business.visit.parking,
        'Free cancellation up to 48 hours before',
      ]}
      ancestors={[{ name: 'Service Areas', path: '/service-areas/' }]}
      current={shell.name}
      eventLabel="area_hub"
    />

    {/* The entity block, directly under the hero. The hero argues that the
        drive is worth it; this says what the studio is, with the brand as
        the subject of every sentence. */}
    <BrandFacts class="bg-ivory" />

    {/* The place. The hero carries the offer; the geography sits here,
        where it is the reason to trust the drive rather than the reason to
        book. The facts are the ones a reader checks before setting off —
        the distance, what the area is like, and what clients come for. */}
    <section class="bg-ivory py-16 md:py-24">
      <div class="wrap grid gap-12 md:grid-cols-[1.1fr_0.9fr] md:gap-16">
        <div>
          <Reveal>
            <p class="t-eyebrow text-ink-soft">The place</p>
            <h2 class="t-h2 mt-4 max-w-[24ch]">What {shell.name} is, and why the skin behaves this way.</h2>
            <p class="t-body mt-6 leading-relaxed">{shell.allAbout.body}</p>
            <p class="t-body mt-5 leading-relaxed text-ink-soft">{shell.proximity}. Free parking on site, by appointment only.</p>
          </Reveal>

          {/* The landmarks. They are the real nouns of the neighbourhood —
              the cove, the university, the village street — and they are
              what makes the page read as being about a place rather than
              about a treatment with a place stapled to it. */}
          <Reveal>
            <p class="t-eyebrow mt-10 text-ink-soft">
              {shell.isStudioCity ? `Landmarks across ${shell.name}` : `Landmarks in ${shell.name}`}
            </p>
            <ul class="t-body m-0 mt-4 list-none space-y-2 p-0">
              {shell.landmarks.slice(0, 8).map((landmark) => (
                <li class="flex gap-4">
                  <span aria-hidden="true" class="text-rose">
                    —
                  </span>
                  <span>{landmark}</span>
                </li>
              ))}
            </ul>
          </Reveal>
        </div>
        <div>
          <Reveal>
            <dl class="m-0 space-y-4">
              {
                shell.allAbout.facts.map((fact) => (
                  <div class="border-b border-line pb-4 last:border-0">
                    <dt class="t-meta text-ink-soft">{fact.label}</dt>
                    <dd class="t-body m-0 mt-1 text-[0.9375rem]">{fact.value}</dd>
                  </div>
                ))
              }
            </dl>
          </Reveal>
          {/* The area's own map. It used to sit in a "Getting to {area}"
              section beside a paragraph of turn-by-turn directions — a
              section whose heading named the reader's city while its text
              described the route to Mission Hills and its map showed the
              studio. Three destinations in one section. The map now sits
              with the place it maps, and the route is a link in the NAP
              block and the footer rather than a paragraph repeated on
              every page. */}
          <Reveal>
            <div class="mt-10">
              <LocationMap place={areaMapPlace(shell.slug, placeLabel)} id="route-map" />
            </div>
          </Reveal>
        </div>
      </div>
    </section>

    {/* The services available in this city. This is the crawl path into the
        cluster — every service page for this city is one link from here. */}
    <section class="bg-porcelain py-20 md:py-28">
      <div class="wrap">
        <Reveal>
          <p class="t-eyebrow text-ink-soft">What we do for {shell.name} clients</p>
          <h2 class="t-h2 mt-4 max-w-[24ch]">Treatments available in {shell.name}</h2>
          <p class="t-body mt-6 max-w-[62ch] leading-relaxed">
            Every treatment below is performed by Kiki, a California licensed esthetician, in one
            private treatment room. Which one is right depends on the skin tone, the concern, and
            the condition of the barrier — and that is what the first consultation establishes.
          </p>
        </Reveal>

        <ul class="m-0 mt-12 grid list-none gap-x-10 gap-y-0 p-0 md:grid-cols-2">
          {rows.map(({ record, service: svc }) => (
            <li class="border-b border-line">
              <a href={areaServicePath(record.area, record.service)} class="group block py-7">
                <div class="flex items-baseline justify-between gap-x-6 gap-y-2">
                  <h3 class="t-service text-[1.0625rem] transition-colors duration-300 group-hover:text-rose md:text-[1.1875rem]">
                    {svc?.name ?? record.service} in {shell.name}
                  </h3>
                  {/* The price, beside the treatment.
                      This list carried no prices at all: the records have a
                      `pricingNote` but no `pricing` array, so the template's
                      `record.pricing?.[0]` was always undefined. On a page
                      that ranks for "facial {city}" — a cost question — that
                      was the most expensive thing missing. The price comes
                      from the service's own published menu price. */}
                  {svc?.menuPrice && (
                    <p class="t-price shrink text-rose md:shrink-0">{svc.menuPrice}</p>
                  )}
                </div>
                <p class="t-body mt-2 text-[0.9375rem] text-ink-soft">
                  {svc?.menuLine ?? svc?.opener ?? record.opener}
                </p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* The route prose is gone from here too. It lived in a "Getting to
        {area}" section whose heading named the reader's own city while the
        text beneath it described the drive to Mission Hills — and whose map
        showed the studio. The map and the landmarks moved up into "The
        place", where they describe the same place the copy does, and the
        distance stays as one line of fact. The route itself is a
        "Get directions" link in the NAP block and the footer, which is
        where a reader who wants it will look, and which is one click
        instead of seventy-one words repeated on every page. */}

    {/* The other cities — the lateral edge that makes the cluster a graph. */}
    {nearby.length > 0 && (
      <section class="bg-porcelain py-16 md:py-20">
        <div class="wrap section-y">
          <Reveal>
            <p class="t-eyebrow text-ink-soft">
              {shell.slug === 'san-diego' ? 'Across the city' : 'Nearby'}
            </p>
            <h2 class="t-h2 mt-4 max-w-[24ch]">
              {shell.slug === 'san-diego' ? 'Neighbourhoods we serve' : 'Other cities we serve'}
            </h2>
          </Reveal>
          <ul class="m-0 mt-10 grid list-none gap-x-10 gap-y-0 p-0 md:grid-cols-2 lg:grid-cols-3">
            {nearby.map(({ shell: other }) => (
              <li class="border-b border-line">
                <a href={areaPath(other.slug)} class="group block py-7">
                  <h3 class="t-service text-[1.0625rem] transition-colors duration-300 group-hover:text-rose md:text-[1.1875rem]">
                    {other.name}
                  </h3>
                  <p class="t-body mt-2 text-[0.9375rem] text-ink-soft">{other.proximity}</p>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {/* The proof. A reader deciding whether a twenty-five minute drive is
        worth it needs to meet somebody who made it, and to see the one
        objective figure the studio can publish. */}
    <section class="bg-porcelain py-16 md:py-20">
      <div class="wrap">
        <div class="mx-auto max-w-[68ch]">
          <Reveal>
            <p class="t-eyebrow text-ink-soft">From the treatment room</p>
            <h2 class="t-h2 mt-4 max-w-[26ch]">What clients say once they have been in.</h2>
          </Reveal>
          <div class="mt-10">
            <VerifiedProof quotes={areaTestimonials} areaName={shell.name} />
          </div>
        </div>
      </div>
    </section>

    <section class="bg-ivory py-20 md:py-28">
      <div class="wrap section-y">
        <div class="max-w-[68ch]">
          <Reveal>
            <p class="t-eyebrow text-ink-soft">Common questions</p>
            <h2 class="t-h2 mt-5">Before a client travels</h2>
          </Reveal>
          <div class="mt-12">
            {/* The first two answer in full on the page — how far it is, and
                what is available for this city — because they are what
                decides whether the drive is worth it. */}
            <FaqList faqs={faqs} openFirst={2} />
          </div>
        </div>
      </div>
    </section>

    <section class="bg-porcelain py-16 md:py-20">
      <div class="wrap">
        <NapBlock />
      </div>
    </section>

    {/* The request. An area hub ranks for a cost question, so it needs the
        price and the button as well as the list of treatments. */}
    <RequestBand
      heading={`Start in ${shell.name} — with a price before a booking is made.`}
      eventLabel="area_hub_band"
    />

    <script>
      import '../../../scripts/scroll-depth';
    </script>
  </article>
</BaseLayout>
