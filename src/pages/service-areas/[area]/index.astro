---
/**
 * /service-areas/{area}/ — the area hub.
 *
 * "Facials in Carlsbad". The parent of every service page for that city,
 * and the page that answers "do you serve my area, and what do you do for
 * the skin people here actually have".
 *
 * It is a separate top-level section from /services/. A reader who knows
 * what treatment they want goes to /services/; a reader who knows where they
 * live goes to /service-areas/. Both are linked from the homepage, and the
 * service×city pages sit under the area hub, one click from both.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Reveal from '../../../components/Reveal.astro';
import Button from '../../../components/Button.astro';
import NapBlock from '../../../components/NapBlock.astro';
import LocationMap from '../../../components/LocationMap.astro';
import BreadcrumbSchema from '../../../components/schema/BreadcrumbSchema.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import FaqSchema from '../../../components/schema/FaqSchema.astro';
import SpeakableSchema from '../../../components/schema/SpeakableSchema.astro';
import AreaServiceSchema from '../../../components/schema/AreaServiceSchema.astro';
import { areaShells } from '../../../data/area-shells';
import { services } from '../../../data/services';
import {
  serviceAreas,
  getServiceAreasForArea,
} from '../../../data/service-areas-index';
import { areaPath, areaServicePath, servicePath } from '../../../config/urls';
import { business } from '../../../config/business';
import { CTA_LABEL } from '../../../config/nav';

export function getStaticPaths() {
  // Only an area with at least one service page gets a hub of its own —
  // an area page with nothing under it is a dead end.
  const covered = new Set(serviceAreas.map((r) => r.area));
  return areaShells
    .filter((shell) => covered.has(shell.slug))
    .map((shell) => ({
      params: { area: shell.slug },
      props: { shell },
    }));
}

const { shell } = Astro.props;

/** The services available to clients from this city. */
const rows = getServiceAreasForArea(shell.slug).map((record) => ({
  record,
  service: services.find((s) => s.slug === record.service),
}));

/**
 * The other cities, for the lateral edge.
 *
 * Every area links to every other area, which is what keeps the cluster a
 * graph rather than a set of isolated pages.
 */
const nearby = areaShells
  .filter((s) => s.slug !== shell.slug)
  .map((s) => ({ shell: s, rows: getServiceAreasForArea(s.slug).length }))
  .filter((s) => s.rows > 0);

const faqs = [
  {
    question: `How far is KIAMO Skin from ${shell.name}?`,
    answer: `${shell.proximity}. ${shell.gettingHere}`,
  },
  {
    question: `What treatments are available for ${shell.name} clients?`,
    answer: `Every treatment on the menu is available to ${shell.name} clients — HydraFacial, chemical peels, dermaplaning, microneedling, enzyme therapy and scalp therapy. What changes with the distance is the plan: a corrective series is scheduled as a block at the first appointment, so the drive works with the course rather than against it.`,
  },
  {
    question: `What skin concerns do ${shell.name} clients bring?`,
    answer: shell.localConcern.body,
  },
  {
    question: 'Is there parking at the studio?',
    answer: `Yes. Free parking is on site, so you do not need to find street parking or pay for a garage. The studio is by appointment only, which means a space is always available when you arrive.`,
  },
  {
    question: 'Do I need to be a regular client to get results?',
    answer:
      'Corrective work is planned across a series, and the plan is mapped at the first appointment — the number of sessions, the intervals and the total timeline. Most clients who travel from out of town stay on a monthly schedule, because a consistent routine is what makes the cumulative work pay off.',
  },
];
/**
 * The title and description.
 *
 * Built from a fixed shape rather than interpolated from the area record,
 * because the record's own fields are long — the guard suite caps a
 * description at 155 characters, and a template that quotes the proximity
 * string blows straight through it.
 */
const title = `Facials in ${shell.name}, San Diego | KIAMO Skin`;
const description = `Corrective facials for ${shell.name} clients in San Diego. HydraFacial, peels, dermaplaning, microneedling and scalp therapy. From $199.`;
---

<BaseLayout
  title={title}
  description={description}
>
  <AreaServiceSchema slot="head" shell={shell} />
  <BreadcrumbSchema
    slot="head"
    trail={[
      { name: 'Service Areas', path: '/service-areas/' },
      { name: shell.name, path: areaPath(shell.slug) },
    ]}
  />
  <FaqSchema slot="head" faqs={faqs} />
  <SpeakableSchema slot="head" />

  <article>
    <header class="bg-blush">
      <div class="wrap pt-[calc(60px+40px)] pb-14 md:pt-[calc(60px+64px)] md:pb-20">
        <div class="grid items-center gap-10 md:grid-cols-2 md:gap-14 lg:gap-20">
          <div>
            <Breadcrumbs ancestors={[{ name: 'Service Areas', path: '/service-areas/' }]} current={shell.name} />
            <h1 class="t-h2 mt-6 max-w-[24ch] text-[2.25rem] md:text-[3.5rem]">
              Corrective facials in {shell.name}, San Diego
            </h1>
            <p class="t-body mt-6 max-w-[56ch] text-[1.125rem]">{shell.localConcern.body}</p>
            <p class="t-body mt-5 max-w-[56ch] text-[0.9375rem] text-ink-soft">
              {shell.proximity}. Free parking on site, by appointment only.
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
              <Button href={business.bookingUrl} external>{CTA_LABEL}</Button>
              <a
                href={business.phone.href}
                class="t-body border-b border-ink pb-1 hover:border-rose hover:text-rose"
              >
                {business.phone.display}
              </a>
            </div>
          </div>

          <div>
            <Reveal>
              <p class="t-eyebrow text-ink-soft">The place</p>
              <p class="t-body mt-4 leading-relaxed">{shell.allAbout.body}</p>
              <dl class="mt-8 m-0 space-y-4">
                {
                  shell.allAbout.facts.map((fact) => (
                    <div class="border-b border-line pb-4 last:border-0">
                      <dt class="t-meta text-ink-soft">{fact.label}</dt>
                      <dd class="t-body m-0 mt-1 text-[0.9375rem]">{fact.value}</dd>
                    </div>
                  ))
                }
              </dl>
            </Reveal>
          </div>
        </div>
      </div>
    </header>

    {/* The services available in this city. This is the crawl path into the
        cluster — every service page for this city is one link from here. */}
    <section class="bg-porcelain py-20 md:py-28">
      <div class="wrap">
        <Reveal>
          <p class="t-eyebrow text-ink-soft">What we do for {shell.name} clients</p>
          <h2 class="t-h2 mt-4 max-w-[24ch]">Treatments available in {shell.name}</h2>
          <p class="t-body mt-6 max-w-[62ch] leading-relaxed">
            Every treatment below is performed by Kiki, a California licensed esthetician, in one
            private treatment room. Which one is right depends on your skin tone, your concern, and
            the condition of your barrier — and that is what the first consultation establishes.
          </p>
        </Reveal>

        <ul class="m-0 mt-12 grid list-none gap-x-10 gap-y-0 p-0 md:grid-cols-2">
          {rows.map(({ record, service: svc }) => (
            <li class="border-b border-line">
              <a href={areaServicePath(record.area, record.service)} class="group block py-7">
                <div class="flex items-baseline justify-between gap-x-6 gap-y-2">
                  <h3 class="t-service text-[1.0625rem] transition-colors duration-300 group-hover:text-rose md:text-[1.1875rem]">
                    {svc?.name ?? record.service} in {shell.name}
                  </h3>
                  {record.pricing?.[0] && (
                    <p class="t-price shrink-0 text-rose">{record.pricing[0].price}</p>
                  )}
                </div>
                <p class="t-body mt-2 text-[0.9375rem] text-ink-soft">
                  {svc?.opener ?? record.opener}
                </p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* Getting here — the drive is the thing a reader from this city is
        actually deciding about. */}
    <section class="bg-ivory py-20 md:py-28">
      <div class="wrap grid items-center gap-12 md:grid-cols-[1fr_0.9fr] md:gap-16">
        <div>
          <Reveal>
            <p class="t-eyebrow text-ink-soft">Getting here</p>
            <h2 class="t-h2 mt-4">Getting to {shell.name}</h2>
            <p class="t-body mt-6 leading-relaxed">{shell.gettingHere}</p>
            <p class="t-body mt-5 leading-relaxed text-ink-soft">{shell.proximity}</p>
            <ul class="t-body mt-7 m-0 list-none space-y-3 p-0">
              {shell.landmarks.slice(0, 6).map((landmark) => (
                <li class="flex gap-4">
                  <span aria-hidden="true" class="text-rose">—</span>
                  <span>{landmark}</span>
                </li>
              ))}
            </ul>
          </Reveal>
        </div>
        <Reveal>
          <div id="location-map">
            <LocationMap origin={shell.name} />
          </div>
        </Reveal>
      </div>
    </section>

    {/* The other cities — the lateral edge that makes the cluster a graph. */}
    {nearby.length > 0 && (
      <section class="bg-porcelain py-16 md:py-20">
        <div class="wrap section-y">
          <Reveal>
            <p class="t-eyebrow text-ink-soft">Nearby</p>
            <h2 class="t-h2 mt-4 max-w-[24ch]">Other cities we serve</h2>
          </Reveal>
          <ul class="m-0 mt-10 grid list-none gap-x-10 gap-y-0 p-0 md:grid-cols-2 lg:grid-cols-3">
            {nearby.map(({ shell: other }) => (
              <li class="border-b border-line">
                <a href={areaPath(other.slug)} class="group block py-7">
                  <h3 class="t-service text-[1.0625rem] transition-colors duration-300 group-hover:text-rose md:text-[1.1875rem]">
                    {other.name}
                  </h3>
                  <p class="t-body mt-2 text-[0.9375rem] text-ink-soft">{other.proximity}</p>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <section class="bg-ivory py-20 md:py-28">
      <div class="wrap section-y">
        <div class="max-w-[68ch]">
          <Reveal>
            <p class="t-eyebrow text-ink-soft">Common questions</p>
            <h2 class="t-h2 mt-5">Before you travel</h2>
          </Reveal>
          <div class="faq-section mt-12">
            {faqs.map((faq) => (
              <div class="border-b border-line py-7 first:pt-0">
                <h3 class="t-service text-[1.0625rem] md:text-[1.1875rem]">{faq.question}</h3>
                <p class="t-body mt-3 text-[0.9375rem]">{faq.answer}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="bg-porcelain py-16 md:py-20">
      <div class="wrap">
        <NapBlock />
      </div>
    </section>
  </article>
</BaseLayout>
