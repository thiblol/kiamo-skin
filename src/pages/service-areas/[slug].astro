---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Reveal from '../../components/Reveal.astro';
import Button from '../../components/Button.astro';
import NapBlock from '../../components/NapBlock.astro';
import LocationMap from '../../components/LocationMap.astro';
import AreaServiceSchema from '../../components/schema/AreaServiceSchema.astro';
import BreadcrumbSchema from '../../components/schema/BreadcrumbSchema.astro';
import FaqSchema from '../../components/schema/FaqSchema.astro';
import SpeakableSchema from '../../components/schema/SpeakableSchema.astro';
import AreaReview from '../../components/sections/AreaReview.astro';
import { enhancedAreas, type EnhancedArea } from '../../data/areas-enhanced';
import { areaFaqs } from '../../data/area-faqs';
import { treatments } from '../../data/treatments';
import { getAreaTestimonials } from '../../data/testimonials';
import { business } from '../../config/business';
import { CTA_LABEL } from '../../config/nav';
import studioInterior from '../../assets/kiamo-skin-studio-mission-hills-san-diego.jpg';

// Import area-specific hero images
import heroLaJolla from '../../assets/hero-la-jolla-keravive-scalp-ocean-swimmers-san-diego.jpg';
import heroPacificBeach from '../../assets/hero-pacific-beach-lira-chemical-peel-sun-damage-san-diego.jpg';
import heroNorthPark from '../../assets/hero-north-park-hydrafacial-series-melanin-rich-skin-san-diego.jpg';
import heroEncinitas from '../../assets/hero-encinitas-dmk-enzyme-therapy-surfer-barrier-repair-san-diego.jpg';
import heroDelMar from '../../assets/hero-del-mar-procell-microchanneling-fair-season-uv-damage-san-diego.jpg';
import heroCarlsbad from '../../assets/hero-carlsbad-procell-keravive-series-planning-san-diego.jpg';
import heroLaMesa from '../../assets/hero-la-mesa-lira-peel-melasma-inland-uv-fitzpatrick-san-diego.jpg';
import heroMissionHills from '../../assets/hero-mission-hills-hydrafacial-studio-reynard-way-san-diego.jpg';
import heroChulaVista from '../../assets/hero-chula-vista-lira-peel-melanin-rich-skin-expertise-san-diego.jpg';

// Map area slugs to their hero images
const areaHeroImages: Record<string, any> = {
  'la-jolla': heroLaJolla,
  'pacific-beach': heroPacificBeach,
  'north-park': heroNorthPark,
  'encinitas': heroEncinitas,
  'del-mar': heroDelMar,
  'carlsbad': heroCarlsbad,
  'la-mesa': heroLaMesa,
  'mission-hills': heroMissionHills,
  'chula-vista': heroChulaVista,
};

// Map area slugs to their specific alt texts
const areaImageAlts: Record<string, string> = {
  'la-jolla': 'Keravive scalp treatment for La Jolla ocean swimmers addressing salt water and UV damage',
  'pacific-beach': 'Lira chemical peel consultation for Pacific Beach client with May Gray UVA sun damage',
  'north-park': 'HydraFacial series treatment for North Park clients with 10-minute proximity advantage',
  'encinitas': 'DMK Enzyme Therapy for Encinitas surfers addressing salt water barrier damage',
  'del-mar': 'Procell microchanneling consultation for Del Mar clients with fair and race season sun damage',
  'carlsbad': 'Corrective treatment series planning for Carlsbad clients with upfront scheduling',
  'la-mesa': 'Lira peel consultation for La Mesa clients with melasma from inland valley heat UV exposure',
  'mission-hills': 'HydraFacial treatment at KIAMO Skin studio on Reynard Way in Mission Hills San Diego',
  'chula-vista': 'Lira chemical peel for Chula Vista clients specializing in melanin-rich skin hyperpigmentation',
};

export function getStaticPaths() {
  return enhancedAreas.map((area) => ({
    params: { slug: area.slug },
    props: { area },
  }));
}

const { area } = Astro.props as { area: EnhancedArea };

const featured = area.featured
  .map((slug) => treatments.find((t) => t.slug === slug))
  .filter((t) => t !== undefined);

const others = enhancedAreas.filter((a) => a.slug !== area.slug);
const faqs = areaFaqs[area.slug] ?? [];
const areaReviews = getAreaTestimonials(area.slug);

// Combine base FAQs with enhanced FAQs (limit to 6 total for scannability)
const allFaqs = [...faqs, ...(area.enhancedFaqs || [])].slice(0, 6);

const coastalAreas = ['la-jolla', 'pacific-beach', 'encinitas', 'del-mar'];
const inlandAreas = ['chula-vista', 'la-mesa'];
const urbanAreas = ['north-park', 'mission-hills'];
const distantAreas = ['carlsbad'];

const isCoastal = coastalAreas.includes(area.slug);
const isInland = inlandAreas.includes(area.slug);
const isUrban = urbanAreas.includes(area.slug);
const isDistant = distantAreas.includes(area.slug);

// Get area-specific hero image or fall back to generic studio image
const heroImage = areaHeroImages[area.slug] || studioInterior;

// Get area-specific alt text or fall back to generic
const imageAlt = areaImageAlts[area.slug] ||
  (area.slug === 'mission-hills'
    ? 'The KIAMO SKIN treatment room at 3067 Reynard Way in Mission Hills, San Diego'
    : `The KIAMO SKIN treatment room in Mission Hills, San Diego, where ${area.name} clients are seen`);

const canonicalUrl = `${business.url}/service-areas/${area.slug}/`;
---

<BaseLayout title={area.title} description={area.description}>
  <AreaServiceSchema slot="head" area={area} />
  <BreadcrumbSchema
    slot="head"
    trail={[
      { name: 'Areas We Serve', path: '/service-areas' },
      { name: area.name, path: `/service-areas/${area.slug}` },
    ]}
  />
  {allFaqs.length > 0 && <FaqSchema slot="head" faqs={allFaqs} />}
  {area.quickAnswer && <SpeakableSchema slot="head" url={canonicalUrl} />}

  <article>
    <!-- HERO: Simplified, focused on booking action -->
    <header class="bg-blush relative">
      <div class="wrap py-12 pt-[calc(60px+24px)] md:py-16 md:pt-[calc(60px+40px)]">
        <div class="grid gap-12 md:grid-cols-[1.2fr_1fr] md:gap-16 lg:gap-20">
          <!-- Left: Copy + CTA -->
          <div class="flex flex-col justify-center">
            <p class="t-eyebrow text-ink-soft">
              <a href="/service-areas/" class="hover:text-rose">Areas we serve</a> · {area.name}
            </p>
            <h1 class="t-h2 mt-4 max-w-[20ch] text-[2.25rem] leading-[1.1] md:text-[3.5rem]">{area.h1}</h1>
            <p class="t-body mt-6 max-w-[52ch] text-[1.0625rem] leading-relaxed">{area.intro}</p>

            <!-- Trust Signals: Compact, scannable -->
            {area.trustSignals && (
              <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 text-[0.875rem] text-ink-soft">
                <div class="flex items-center gap-2">
                  <svg class="h-4 w-4 text-rose" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span>{area.trustSignals.yearsInBusiness} experience</span>
                </div>
                <div class="flex items-center gap-2">
                  <svg class="h-4 w-4 text-rose" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span>Licensed esthetician</span>
                </div>
                <div class="flex items-center gap-2">
                  <svg class="h-4 w-4 text-rose" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span>One-to-one appointments</span>
                </div>
                {area.trustSignals.reviewCount > 0 && (
                  <div class="flex items-center gap-2">
                    <svg class="h-4 w-4 text-rose" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                    </svg>
                    <span>{area.trustSignals.reviewRating} ({area.trustSignals.reviewCount} reviews)</span>
                  </div>
                )}
              </div>
            )}

            <!-- Primary CTA -->
            <div class="mt-10 flex flex-wrap items-center gap-4">
              <Button href={business.bookingUrl} external size="lg" class="shadow-lg">{CTA_LABEL}</Button>
              <a
                href={business.phone.href}
                class="group inline-flex items-center gap-2 text-[0.9375rem] font-medium text-ink transition-colors hover:text-rose"
              >
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                </svg>
                {business.phone.display}
              </a>
            </div>
          </div>

          <!-- Right: Studio image -->
          <div class="relative">
            <Reveal>
              <div class="relative overflow-hidden rounded-lg shadow-2xl">
                <Image
                  src={heroImage}
                  alt={imageAlt}
                  class="aspect-[4/5] object-cover"
                  widths={[400, 600, 800]}
                  sizes="(min-width: 768px) 45vw, 100vw"
                  loading="eager"
                />
                <!-- Floating stats badge -->
                {area.proximity && (
                  <div class="absolute bottom-4 left-4 right-4 rounded-lg bg-porcelain/95 p-4 backdrop-blur-sm">
                    <p class="text-center text-[0.875rem] font-medium text-ink">
                      {area.proximity}
                    </p>
                  </div>
                )}
              </div>
            </Reveal>
          </div>
        </div>
      </div>
    </header>

    <!-- QUICK ANSWER: Simplified, scannable -->
    {area.quickAnswer && (
      <section class="bg-ivory border-y border-line">
        <div class="wrap py-10">
          <Reveal>
            <div class="mx-auto max-w-[72ch]">
              <p class="t-eyebrow text-rose mb-3">Quick Answer</p>
              <p class="text-[1.0625rem] leading-relaxed text-ink-soft">{area.quickAnswer}</p>
            </div>
          </Reveal>
        </div>
      </section>
    )}

    <!-- LOCAL CONCERN: Visual + Concise -->
    <section class="bg-porcelain">
      <div class="wrap section-y">
        <div class="grid gap-12 md:grid-cols-[1fr_1.2fr] md:gap-16">
          <!-- Problem statement -->
          <div>
            <Reveal>
              <h2 class="t-h3 text-[1.75rem]">{area.localConcern.heading}</h2>
              <p class="t-body mt-6 leading-relaxed text-ink-soft">{area.localConcern.body}</p>
              {area.melaninNote && (
                <p class="t-body mt-6 text-[0.9375rem]">
                  <a href="/melanin-rich-skin/" class="inline-flex items-center gap-1 font-medium text-rose hover:underline">
                    {area.melaninNote}
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                  </a>
                </p>
              )}
            </Reveal>
          </div>

          <!-- What makes us different: Visual cards -->
          {area.uniquenessBlock && (
            <div>
              <Reveal delay={0.1}>
                <h3 class="t-h4 mb-6 text-[1.25rem]">{area.uniquenessBlock.heading}</h3>
                <div class="space-y-4">
                  {area.uniquenessBlock.points.slice(0, 4).map((point, idx) => (
                    <div class="flex gap-3 rounded-lg bg-porcelain/60 p-4">
                      <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-rose text-porcelain text-sm font-bold">{idx + 1}</span>
                      <p class="text-[0.9375rem] leading-relaxed text-ink-soft">{point}</p>
                    </div>
                  ))}
                </div>
              </Reveal>
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- SERVICES: Visual grid with pricing -->
    {(area.services && area.services.length > 0) || featured.length > 0 ? (
      <section class="bg-blush">
        <div class="wrap section-y">
          <Reveal>
            <div class="text-center">
              <h2 class="t-h3">Services for {area.name} clients</h2>
              <p class="t-body mx-auto mt-4 max-w-[60ch] text-ink-soft">{area.pricingNote}</p>
            </div>
          </Reveal>

          <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {(area.services || featured).slice(0, 6).map((service, idx) => (
              <Reveal delay={idx * 0.05}>
                <a
                  href={`/treatments/${service.slug}/`}
                  class="group block rounded-lg border border-line bg-porcelain p-6 transition-all duration-300 hover:border-rose hover:shadow-lg"
                >
                  <h3 class="t-service text-[1.125rem] font-medium transition-colors group-hover:text-rose">
                    {service.name}
                  </h3>
                  <p class="t-body mt-3 text-[0.9375rem] leading-relaxed text-ink-soft line-clamp-3">
                    {service.description}
                  </p>
                  <div class="mt-4 inline-flex items-center gap-1 text-[0.875rem] font-medium text-rose">
                    Learn more
                    <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                  </div>
                </a>
              </Reveal>
            ))}
          </div>
        </div>
      </section>
    ) : null}

    <!-- PROCESS: Collapsible accordions instead of full text -->
    {area.processBlocks && area.processBlocks.length > 0 && (
      <section class="bg-ivory">
        <div class="wrap section-y">
          <Reveal>
            <h2 class="t-h3 mb-10">How treatments work</h2>
          </Reveal>

          <div class="mx-auto max-w-[72ch] space-y-4">
            {area.processBlocks.map((process, idx) => (
              <Reveal delay={idx * 0.05}>
                <details class="group overflow-hidden rounded-lg border border-line bg-porcelain">
                  <summary class="flex cursor-pointer items-center justify-between p-6 transition-colors hover:bg-blush list-none">
                    <h3 class="t-service text-[1.0625rem] font-medium pr-4">{process.heading}</h3>
                    <svg class="h-5 w-5 shrink-0 text-rose transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                  </summary>
                  <div class="border-t border-line bg-porcelain/60 p-6">
                    <p class="t-body mb-6 text-[0.9375rem] leading-relaxed text-ink-soft">{process.intro}</p>
                    {process.steps && (
                      <ol class="space-y-4">
                        {process.steps.map((step, stepIdx) => (
                          <li class="flex gap-4">
                            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-rose text-porcelain text-sm font-bold">
                              {stepIdx + 1}
                            </span>
                            <div>
                              <h4 class="font-medium text-ink">{step.title}</h4>
                              <p class="mt-1 text-[0.875rem] leading-relaxed text-ink-soft">{step.description}</p>
                            </div>
                          </li>
                        ))}
                      </ol>
                    )}
                    {process.footer && (
                      <p class="mt-6 text-[0.875rem] italic text-ink-soft">{process.footer}</p>
                    )}
                  </div>
                </details>
              </Reveal>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- GUARANTEE: Visual trust block -->
    {area.guaranteeBlock && (
      <section class="bg-porcelain">
        <div class="wrap section-y">
          <Reveal>
            <div class="text-center">
              <h2 class="t-h3">{area.guaranteeBlock.heading}</h2>
            </div>
          </Reveal>

          <div class="mt-12 grid gap-6 md:grid-cols-2">
            {area.guaranteeBlock.commitments.map((commitment, idx) => (
              <Reveal delay={idx * 0.05}>
                <div class="rounded-lg border-l-4 border-rose bg-blush p-6">
                  <h3 class="t-service text-[1.0625rem] font-medium">{commitment.title}</h3>
                  <p class="t-body mt-3 text-[0.9375rem] leading-relaxed text-ink-soft">{commitment.body}</p>
                </div>
              </Reveal>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- FAQS: Cleaner accordion -->
    {allFaqs.length > 0 && (
      <section class="faq-section bg-ivory">
        <div class="wrap section-y">
          <Reveal>
            <h2 class="t-h3 mb-10">Common questions from {area.name} clients</h2>
          </Reveal>

          <div class="mx-auto max-w-[72ch] space-y-4">
            {allFaqs.map((faq, index) => (
              <Reveal delay={index * 0.03}>
                <details class="group overflow-hidden rounded-lg border border-line bg-porcelain">
                  <summary class="flex cursor-pointer items-start justify-between p-6 transition-colors hover:bg-blush list-none">
                    <h3 class="t-service text-[1.0625rem] font-medium pr-4">{faq.question}</h3>
                    <svg class="mt-1 h-5 w-5 shrink-0 text-rose transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                  </summary>
                  <div class="border-t border-line bg-porcelain/60 p-6">
                    <p class="t-body text-[0.9375rem] leading-relaxed text-ink-soft">{faq.answer}</p>
                  </div>
                </details>
              </Reveal>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- GETTING HERE: Collapsible, with map -->
    <section class="bg-blush">
      <div class="wrap section-y">
        <div class="grid gap-12 md:grid-cols-[1fr_1.2fr] md:gap-16">
          <div>
            <Reveal>
              <h2 class="t-h3 mb-6">Getting here from {area.name}</h2>
              <p class="t-body mb-4 leading-relaxed text-ink-soft">{area.gettingHere}</p>
              <p class="text-[0.875rem] font-medium text-rose">{area.proximity}</p>
            </Reveal>
          </div>
          <div>
            <Reveal delay={0.1}>
              <LocationMap />
            </Reveal>
          </div>
        </div>
      </div>
    </section>

    <!-- TESTIMONIALS -->
    {areaReviews.length > 0 && (
      <AreaReview areaName={area.name} testimonial={areaReviews[0]} />
    )}

    <!-- FINAL CTA: Strong, clear -->
    <section class="bg-porcelain">
      <div class="wrap section-y text-center">
        <Reveal>
          <h2 class="t-h3">Ready to book your consultation?</h2>
          <p class="t-body mx-auto mt-6 max-w-[50ch] text-ink-soft">
            New clients start with a consultation that includes a full treatment. Book online or call —
            {area.trustSignals?.responseTime || 'we respond within 24 hours'}.
          </p>
          <div class="mt-10 flex flex-wrap justify-center gap-4">
            <Button href={business.bookingUrl} external size="lg" class="shadow-lg">
              {CTA_LABEL}
            </Button>
            <a
              href={business.phone.href}
              class="group inline-flex items-center gap-2 rounded-lg border-2 border-ink bg-transparent px-8 py-3.5 text-[0.9375rem] font-medium text-ink transition-all hover:border-rose hover:text-rose"
            >
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              </svg>
              {business.phone.display}
            </a>
          </div>
          <div class="mt-12">
            <NapBlock />
          </div>
        </Reveal>
      </div>
    </section>

    <!-- ALSO SERVING: Compact grid -->
    <section class="bg-ivory border-t border-line">
      <div class="wrap py-12">
        <h2 class="t-h4 mb-8 text-[1.25rem]">Also serving</h2>
        <div class="grid gap-4 sm:grid-cols-2 md:grid-cols-3">
          {others.slice(0, 6).map((other) => (
            <a
              href={`/service-areas/${other.slug}/`}
              class="group block rounded-lg border border-line bg-porcelain p-4 transition-all hover:border-rose hover:shadow-md"
            >
              <h3 class="text-[0.9375rem] font-medium transition-colors group-hover:text-rose">
                {other.crossLinkLabel}
              </h3>
            </a>
          ))}
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  /* Smooth accordion animations */
  details summary {
    transition: background-color 200ms ease;
  }

  details[open] summary {
    border-bottom: 1px solid var(--color-line);
  }

  /* Line clamp utility */
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
