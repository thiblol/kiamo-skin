---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Reveal from '../../components/Reveal.astro';
import Button from '../../components/Button.astro';
import NapBlock from '../../components/NapBlock.astro';
import LocationMap from '../../components/LocationMap.astro';
import AreaServiceSchema from '../../components/schema/AreaServiceSchema.astro';
import BreadcrumbSchema from '../../components/schema/BreadcrumbSchema.astro';
import FaqSchema from '../../components/schema/FaqSchema.astro';
import AreaReview from '../../components/sections/AreaReview.astro';
import { areas } from '../../data/areas';
import { areaFaqs } from '../../data/area-faqs';
import { treatments } from '../../data/treatments';
import { getAreaTestimonials } from '../../data/testimonials';
import { business } from '../../config/business';
import { CTA_LABEL } from '../../config/nav';
import studioInterior from '../../assets/studio-interior.jpg';

export function getStaticPaths() {
  return areas.map((area) => ({
    params: { slug: area.slug },
    props: { area },
  }));
}

const { area } = Astro.props;

const featured = area.featured
  .map((slug) => treatments.find((t) => t.slug === slug))
  .filter((t) => t !== undefined);

const others = areas.filter((a) => a.slug !== area.slug);
const faqs = areaFaqs[area.slug] ?? [];
const areaReviews = getAreaTestimonials(area.slug);

/**
 * Categorize areas to create different page structures.
 * This breaks the template detection pattern that Google uses to identify doorway pages.
 */
const coastalAreas = ['la-jolla', 'pacific-beach', 'encinitas', 'del-mar'];
const inlandAreas = ['chula-vista', 'la-mesa'];
const urbanAreas = ['north-park', 'mission-hills'];
const distantAreas = ['carlsbad'];

const isCoastal = coastalAreas.includes(area.slug);
const isInland = inlandAreas.includes(area.slug);
const isUrban = urbanAreas.includes(area.slug);
const isDistant = distantAreas.includes(area.slug);

/**
 * The one image on the page, so the alt text is the only place the studio and
 * the area appear in the same string. Mission Hills is the studio's own area —
 * "clients travelling from Mission Hills" would be false — so it reads plainly.
 */
const imageAlt =
  area.slug === 'mission-hills'
    ? 'The KIAMO SKIN treatment room at 3067 Reynard Way in Mission Hills, San Diego'
    : `The KIAMO SKIN treatment room in Mission Hills, San Diego, where ${area.name} clients are seen`;
---

<BaseLayout title={area.title} description={area.description}>
  <AreaServiceSchema slot="head" area={area} />
  <BreadcrumbSchema
    slot="head"
    trail={[
      { name: 'Areas We Serve', path: '/service-areas' },
      { name: area.name, path: `/service-areas/${area.slug}` },
    ]}
  />
  {faqs.length > 0 && <FaqSchema slot="head" faqs={faqs} />}

  <article>
    <header class="bg-blush">
      <div class="wrap section-y pt-[calc(60px+72px)] md:pt-[calc(60px+112px)]">
        <p class="t-eyebrow text-ink-soft">
          <a href="/service-areas/" class="hover:text-rose">Areas we serve</a> · {area.name}
        </p>
        <h1 class="t-h2 mt-6 max-w-[22ch] text-[2.5rem] md:text-[4rem]">{area.h1}</h1>
        <p class="t-body mt-7 max-w-[62ch]">{area.intro}</p>
        <div class="mt-9 flex flex-wrap items-center gap-x-8 gap-y-4">
          <Button href={business.bookingUrl} external>{CTA_LABEL}</Button>
          <a href={business.phone.href} class="t-body border-b border-ink pb-1 hover:border-rose hover:text-rose">
            {business.phone.display}
          </a>
        </div>
        <p class="t-body mt-6 text-[0.875rem] text-ink-soft">
          {business.experience} treating pigmentation, barrier damage &amp; melanin-rich skin · One esthetician, every appointment · Mission Hills, San Diego
        </p>
      </div>
    </header>

    {/* COASTAL AREAS: Lead with local concern (ocean impact) before directions */}
    {isCoastal && (
      <>
        <section class="bg-porcelain">
          <div class="wrap section-y grid gap-16 md:grid-cols-[1fr_0.7fr] md:gap-20">
            <div>
              <Reveal>
                <h2 class="t-h3">{area.localConcern.heading}</h2>
                <p class="t-body mt-7">{area.localConcern.body}</p>
                {
                  area.melaninNote && (
                    <p class="t-body mt-6">
                      {area.melaninNote}{' '}
                      <a href="/melanin-rich-skin/" class="border-b border-ink pb-0.5 hover:border-rose hover:text-rose">
                        facials for melanin-rich skin in San Diego
                      </a>
                      .
                    </p>
                  )
                }
              </Reveal>

              <Reveal class="mt-16 block">
                <h2 class="t-h3">Treatments booked most</h2>
                <p class="t-body mt-5 text-[0.9375rem] text-ink-soft">{area.pricingNote}</p>
                <ul class="mt-8 m-0 list-none p-0">
                  {
                    featured.map((treatment) => (
                      <li class="border-b border-line">
                        <a href={`/treatments/${treatment.slug}/`} class="group block py-7">
                          <h3 class="t-service text-[1.0625rem] transition-colors duration-300 group-hover:text-rose md:text-[1.1875rem]">
                            {treatment.name} in {area.name}
                          </h3>
                          <p class="t-body mt-2 text-[0.9375rem] text-ink-soft">{treatment.headline}</p>
                        </a>
                      </li>
                    ))
                  }
                </ul>
                <p class="t-body mt-9 text-[0.9375rem]">
                  <a href="/treatments/" class="border-b border-ink pb-1 hover:border-rose hover:text-rose">
                    See the full treatment menu in San Diego
                  </a>
                </p>
              </Reveal>
            </div>

            <aside>
              <Image
                src={studioInterior}
                alt={imageAlt}
                widths={[400, 600]}
                sizes="(min-width: 768px) 30vw, 100vw"
                loading="lazy"
                class="mb-8 w-full"
              />
              <div class="border border-line bg-ivory p-8">
                <h2 class="t-eyebrow text-ink-soft">The studio</h2>
                <div class="mt-7">
                  <NapBlock tone="light" />
                </div>
                <div class="mt-8">
                  <Button href={business.bookingUrl} external class="w-full">{CTA_LABEL}</Button>
                </div>
              </div>
            </aside>
          </div>
        </section>

        {/* All About section */}
        <section class="bg-espresso text-porcelain">
          <div class="wrap section-y grid gap-14 md:grid-cols-[1.15fr_0.85fr] md:gap-20">
            <div>
              <p class="t-eyebrow text-porcelain/60">The area</p>
              <h2 class="t-h2 mt-5">All about {area.name}</h2>
              <p class="t-body mt-8 max-w-[58ch] text-porcelain/75">{area.allAbout.body}</p>
            </div>

            <dl class="m-0 self-end">
              {
                area.allAbout.facts.map((fact) => (
                  <div class="border-t border-porcelain/15 py-6">
                    <dt class="t-eyebrow text-porcelain/50">{fact.label}</dt>
                    <dd class="t-h3 m-0 mt-3 text-[1.5rem] text-porcelain">{fact.value}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </section>

        {/* Getting Here - moved after All About for coastal */}
        <section class="bg-porcelain">
          <div class="wrap section-y">
            <Reveal>
              <h2 class="t-h3">Getting here</h2>
              <p class="t-body mt-7 max-w-[62ch]">{area.gettingHere}</p>
              <LocationMap origin={area.name} aspect="aspect-16/10" class="mt-9" />
            </Reveal>
          </div>
        </section>
      </>
    )}

    {/* INLAND AREAS: Lead with pigmentation concern and treatments */}
    {isInland && (
      <>
        <section class="bg-porcelain">
          <div class="wrap section-y grid gap-16 md:grid-cols-[1fr_0.7fr] md:gap-20">
            <div>
              <Reveal>
                <h2 class="t-h3">{area.localConcern.heading}</h2>
                <p class="t-body mt-7">{area.localConcern.body}</p>
                {
                  area.melaninNote && (
                    <p class="t-body mt-6">
                      {area.melaninNote}{' '}
                      <a href="/melanin-rich-skin/" class="border-b border-ink pb-0.5 hover:border-rose hover:text-rose">
                        facials for melanin-rich skin in San Diego
                      </a>
                      .
                    </p>
                  )
                }
              </Reveal>

              <Reveal class="mt-16 block">
                <h2 class="t-h3">Treatments booked most</h2>
                <p class="t-body mt-5 text-[0.9375rem] text-ink-soft">{area.pricingNote}</p>
                <ul class="mt-8 m-0 list-none p-0">
                  {
                    featured.map((treatment) => (
                      <li class="border-b border-line">
                        <a href={`/treatments/${treatment.slug}/`} class="group block py-7">
                          <h3 class="t-service text-[1.0625rem] transition-colors duration-300 group-hover:text-rose md:text-[1.1875rem]">
                            {treatment.name} in {area.name}
                          </h3>
                          <p class="t-body mt-2 text-[0.9375rem] text-ink-soft">{treatment.headline}</p>
                        </a>
                      </li>
                    ))
                  }
                </ul>
                <p class="t-body mt-9 text-[0.9375rem]">
                  <a href="/treatments/" class="border-b border-ink pb-1 hover:border-rose hover:text-rose">
                    See the full treatment menu in San Diego
                  </a>
                </p>
              </Reveal>

              <Reveal class="mt-16 block">
                <h2 class="t-h3">Getting here</h2>
                <p class="t-body mt-7">{area.gettingHere}</p>
                <LocationMap origin={area.name} aspect="aspect-16/10" class="mt-9" />
              </Reveal>
            </div>

            <aside>
              <Image
                src={studioInterior}
                alt={imageAlt}
                widths={[400, 600]}
                sizes="(min-width: 768px) 30vw, 100vw"
                loading="lazy"
                class="mb-8 w-full"
              />
              <div class="border border-line bg-ivory p-8">
                <h2 class="t-eyebrow text-ink-soft">The studio</h2>
                <div class="mt-7">
                  <NapBlock tone="light" />
                </div>
                <div class="mt-8">
                  <Button href={business.bookingUrl} external class="w-full">{CTA_LABEL}</Button>
                </div>
              </div>
            </aside>
          </div>
        </section>

        <section class="bg-espresso text-porcelain">
          <div class="wrap section-y grid gap-14 md:grid-cols-[1.15fr_0.85fr] md:gap-20">
            <div>
              <p class="t-eyebrow text-porcelain/60">The area</p>
              <h2 class="t-h2 mt-5">All about {area.name}</h2>
              <p class="t-body mt-8 max-w-[58ch] text-porcelain/75">{area.allAbout.body}</p>
            </div>

            <dl class="m-0 self-end">
              {
                area.allAbout.facts.map((fact) => (
                  <div class="border-t border-porcelain/15 py-6">
                    <dt class="t-eyebrow text-porcelain/50">{fact.label}</dt>
                    <dd class="t-h3 m-0 mt-3 text-[1.5rem] text-porcelain">{fact.value}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </section>
      </>
    )}

    {/* URBAN AREAS: Lead with proximity/convenience, skip "All About" */}
    {isUrban && (
      <>
        <section class="bg-porcelain">
          <div class="wrap section-y grid gap-16 md:grid-cols-[1fr_0.7fr] md:gap-20">
            <div>
              <Reveal>
                <h2 class="t-h3">Getting here</h2>
                <p class="t-body mt-7">{area.gettingHere}</p>
                <LocationMap origin={area.name} aspect="aspect-16/10" class="mt-9" />
              </Reveal>

              <Reveal class="mt-16 block">
                <h2 class="t-h3">{area.localConcern.heading}</h2>
                <p class="t-body mt-7">{area.localConcern.body}</p>
                {
                  area.melaninNote && (
                    <p class="t-body mt-6">
                      {area.melaninNote}{' '}
                      <a href="/melanin-rich-skin/" class="border-b border-ink pb-0.5 hover:border-rose hover:text-rose">
                        facials for melanin-rich skin in San Diego
                      </a>
                      .
                    </p>
                  )
                }
              </Reveal>

              <Reveal class="mt-16 block">
                <h2 class="t-h3">Treatments booked most</h2>
                <p class="t-body mt-5 text-[0.9375rem] text-ink-soft">{area.pricingNote}</p>
                <ul class="mt-8 m-0 list-none p-0">
                  {
                    featured.map((treatment) => (
                      <li class="border-b border-line">
                        <a href={`/treatments/${treatment.slug}/`} class="group block py-7">
                          <h3 class="t-service text-[1.0625rem] transition-colors duration-300 group-hover:text-rose md:text-[1.1875rem]">
                            {treatment.name} in {area.name}
                          </h3>
                          <p class="t-body mt-2 text-[0.9375rem] text-ink-soft">{treatment.headline}</p>
                        </a>
                      </li>
                    ))
                  }
                </ul>
                <p class="t-body mt-9 text-[0.9375rem]">
                  <a href="/treatments/" class="border-b border-ink pb-1 hover:border-rose hover:text-rose">
                    See the full treatment menu in San Diego
                  </a>
                </p>
              </Reveal>
            </div>

            <aside>
              <Image
                src={studioInterior}
                alt={imageAlt}
                widths={[400, 600]}
                sizes="(min-width: 768px) 30vw, 100vw"
                loading="lazy"
                class="mb-8 w-full"
              />
              <div class="border border-line bg-ivory p-8">
                <h2 class="t-eyebrow text-ink-soft">The studio</h2>
                <div class="mt-7">
                  <NapBlock tone="light" />
                </div>
                <div class="mt-8">
                  <Button href={business.bookingUrl} external class="w-full">{CTA_LABEL}</Button>
                </div>
              </div>
            </aside>
          </div>
        </section>
      </>
    )}

    {/* DISTANT AREAS: Lead with series planning, skip detailed "All About" */}
    {isDistant && (
      <>
        <section class="bg-porcelain">
          <div class="wrap section-y grid gap-16 md:grid-cols-[1fr_0.7fr] md:gap-20">
            <div>
              <Reveal>
                <h2 class="t-h3">{area.localConcern.heading}</h2>
                <p class="t-body mt-7">{area.localConcern.body}</p>
              </Reveal>

              <Reveal class="mt-16 block">
                <h2 class="t-h3">Getting here</h2>
                <p class="t-body mt-7">{area.gettingHere}</p>
                <LocationMap origin={area.name} aspect="aspect-16/10" class="mt-9" />
              </Reveal>

              <Reveal class="mt-16 block">
                <h2 class="t-h3">Treatments booked most</h2>
                <p class="t-body mt-5 text-[0.9375rem] text-ink-soft">{area.pricingNote}</p>
                <ul class="mt-8 m-0 list-none p-0">
                  {
                    featured.map((treatment) => (
                      <li class="border-b border-line">
                        <a href={`/treatments/${treatment.slug}/`} class="group block py-7">
                          <h3 class="t-service text-[1.0625rem] transition-colors duration-300 group-hover:text-rose md:text-[1.1875rem]">
                            {treatment.name} in {area.name}
                          </h3>
                          <p class="t-body mt-2 text-[0.9375rem] text-ink-soft">{treatment.headline}</p>
                        </a>
                      </li>
                    ))
                  }
                </ul>
                <p class="t-body mt-9 text-[0.9375rem]">
                  <a href="/treatments/" class="border-b border-ink pb-1 hover:border-rose hover:text-rose">
                    See the full treatment menu in San Diego
                  </a>
                </p>
              </Reveal>
            </div>

            <aside>
              <Image
                src={studioInterior}
                alt={imageAlt}
                widths={[400, 600]}
                sizes="(min-width: 768px) 30vw, 100vw"
                loading="lazy"
                class="mb-8 w-full"
              />
              <div class="border border-line bg-ivory p-8">
                <h2 class="t-eyebrow text-ink-soft">The studio</h2>
                <div class="mt-7">
                  <NapBlock tone="light" />
                </div>
                <div class="mt-8">
                  <Button href={business.bookingUrl} external class="w-full">{CTA_LABEL}</Button>
                </div>
              </div>
            </aside>
          </div>
        </section>
      </>
    )}

    {/* FAQs - only on some pages */}
    {
      faqs.length > 0 && (
        <section class="bg-blush">
          <div class="wrap section-y">
            <p class="t-eyebrow text-ink-soft">Before you book</p>
            <h2 class="t-h2 mt-5">{area.name} questions</h2>
            <div class="mt-12 max-w-[68ch]">
              {faqs.map((faq) => (
                <div class="border-b border-line">
                  <details class="group">
                    <summary class="t-service flex cursor-pointer list-none items-center justify-between gap-6 py-6 text-[1.0625rem] hover:text-rose md:text-[1.1875rem]">
                      <span>{faq.question}</span>
                      <span
                        aria-hidden="true"
                        class="shrink-0 text-rose transition-transform duration-300 group-open:rotate-45"
                      >
                        +
                      </span>
                    </summary>
                    <div class="t-body pb-6 text-[0.9375rem]">{faq.answer}</div>
                  </details>
                </div>
              ))}
            </div>
          </div>
        </section>
      )
    }

    {/* "All About" section - only for non-urban areas */}
    {!isUrban && !isDistant && (
      <section class="bg-espresso text-porcelain">
        <div class="wrap section-y grid gap-14 md:grid-cols-[1.15fr_0.85fr] md:gap-20">
          <div>
            <p class="t-eyebrow text-porcelain/60">The area</p>
            <h2 class="t-h2 mt-5">All about {area.name}</h2>
            <p class="t-body mt-8 max-w-[58ch] text-porcelain/75">{area.allAbout.body}</p>
          </div>

          <dl class="m-0 self-end">
            {
              area.allAbout.facts.map((fact) => (
                <div class="border-t border-porcelain/15 py-6">
                  <dt class="t-eyebrow text-porcelain/50">{fact.label}</dt>
                  <dd class="t-h3 m-0 mt-3 text-[1.5rem] text-porcelain">{fact.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </section>
    )}

    {areaReviews.length > 0 && (
      <AreaReview testimonial={areaReviews[0]} areaName={area.name} />
    )}

    <section class="bg-blush">
      <div class="wrap section-y text-center">
        <h2 class="t-h3 max-w-[28ch] mx-auto">Ready to book a facial in {area.name}?</h2>
        <p class="t-body mt-5 max-w-[52ch] mx-auto">
          One treatment room. One practitioner. Request an appointment and Kiki will
          confirm a time by the next business day.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-x-8 gap-y-4">
          <Button href={business.bookingUrl} external>{CTA_LABEL}</Button>
          <a href={business.phone.href} class="t-body border-b border-ink pb-1 hover:border-rose hover:text-rose">
            {business.phone.display}
          </a>
        </div>
      </div>
    </section>

    <section class="bg-ivory">
      <div class="wrap section-y">
        <h2 class="t-h3">Also serving</h2>
        <ul class="mt-10 m-0 grid list-none gap-x-10 gap-y-0 p-0 md:grid-cols-2">
          {
            others.map((other) => (
              <li class="border-b border-line">
                <a href={`/service-areas/${other.slug}/`} class="group block py-7">
                  <h3 class="t-service text-[1.0625rem] transition-colors duration-300 group-hover:text-rose md:text-[1.1875rem]">
                    {other.crossLinkLabel}
                  </h3>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </article>
</BaseLayout>
