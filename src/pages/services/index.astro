---
/**
 * /services/ — the services index.
 *
 * The menu of every treatment the studio performs, with the published price
 * on each row. This is the page that answers "what can I book, and what does
 * it cost" before any single service page does.
 *
 * The old /treatments/ index did this job but was built around treatment
 * records that included the two concern pages whose live copy sat in
 * hand-written .astro files instead — so the menu and the pages it linked to
 * disagreed. One registry now backs both.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Reveal from '../../components/Reveal.astro';
import Button from '../../components/Button.astro';
import NapBlock from '../../components/NapBlock.astro';
import VerifiedProof from '../../components/VerifiedProof.astro';
import CollectionSchema from '../../components/schema/CollectionSchema.astro';
import BreadcrumbSchema from '../../components/schema/BreadcrumbSchema.astro';
import PageHero from '../../components/PageHero.astro';
import FaqSchema from '../../components/schema/FaqSchema.astro';
import SpeakableSchema from '../../components/schema/SpeakableSchema.astro';
import { services } from '../../data/services';
import { getServiceTestimonials } from '../../data/testimonials';
import { getCoveredAreas, getServiceAreasForArea } from '../../data/service-areas-index';
import { servicePath, areaServicePath } from '../../config/urls';
import { business, verifiedPrices } from '../../config/business';
import { CTA_LABEL } from '../../config/nav';
import heroImage from '../../assets/kiamo-skin-studio-mission-hills-san-diego.jpg';

const faqs = [
  {
    question: 'How much does a facial treatment cost in San Diego?',
    answer:
      'Prices depend on the modality: dermaplaning starts at $199, a HydraFacial is $259, LIRA chemical peels run $199 to $299, DMK Enzyme Therapy starts at $279, and Keravive scalp therapy is $599. A first-time client treatment is $249 and includes the consultation that decides the plan. Every price is published on this site and confirmed at booking — nothing is quoted at the door.',
  },
  {
    question: 'Which treatment should I book first?',
    answer:
      'That is what the consultation is for. The first visit is a full assessment — skin tone, primary concern, and the condition of the barrier — and the modality is selected from what the skin is doing that day. DMK enzyme therapy often comes first for a compromised barrier, a HydraFacial for maintenance, and peels or microchanneling for pigment and scarring.',
  },
  {
    question: 'Does KIAMO Skin treat all skin types?',
    answer:
      'Yes — Fitzpatrick I through VI. Kiki has 7+ years treating the full spectrum, and the pigment protocols are written for melanin-rich skin rather than adjusted for it. That matters because melanin-rich skin responds to trauma by producing more pigment, so strength is escalated only as the barrier allows.',
  },
  {
    question: 'Which treatments are best for dark spots and melasma?',
    answer:
      'LIRA chemical peels are the backbone of a melasma plan, with Procell microchanneling added where texture or scarring is part of the picture and a HydraFacial with a brightening booster holding the result between sessions. Pigmentation is treated as a series, with strength escalating across the course rather than in one visit.',
  },
  {
    question: 'How often should I come in?',
    answer:
      'Monthly for maintenance, and every four to six weeks for a corrective plan. The monthly facial membership at $199 includes one HydraFacial monthly plus discounts on additional treatments, which is usually the cheaper way to stay consistent across a series.',
  },
  {
    question: 'Do I need to travel far for treatment?',
    answer:
      'The studio is in San Diego and clients travel from across the county — North Park and Hillcrest are five to ten minutes, La Jolla and Pacific Beach around fifteen to twenty, and Encinitas and Carlsbad about thirty-five to forty. Each service page lists the areas it covers and the honest drive time.',
  },
];

const groups = [
  { key: 'Facials', note: 'The foundation — cleansing, extraction, resurfacing and maintenance.', tone: 'bg-porcelain' },
  { key: 'Peels', note: 'Pigment and texture correction, paced across a series.', tone: 'bg-ivory' },
  { key: 'Scalp', note: 'Clinical scalp therapy for buildup, flaking and irritation.', tone: 'bg-porcelain' },
  { key: 'Advanced', note: 'Depth-controlled resurfacing and barrier repair.', tone: 'bg-ivory' },
  { key: 'Corrective', note: 'Plans assembled from several modalities, for a specific concern.', tone: 'bg-porcelain' },
];

/**
 * The price table.
 *
 * The menu above already carries a price on every row, but as a list, which a
 * reader has to read down rather than across. A table answers "what does
 * this cost" in one pass, and it is the format an AI answer engine can lift
 * cleanly — which matters, because "how much does a facial cost" is the
 * highest-volume AI search term this business has.
 *
 * Durations are deliberately absent: Vagaro publishes none, and the guard
 * suite forbids estimating them.
 */
const priceTable = services.map((service) => ({
  name: service.name,
  href: servicePath(service.slug),
  price: service.menuPrice ?? 'Pricing at consultation.',
  for: service.goodFor?.[0] ?? service.concerns?.[0] ?? '',
  kind: service.category,
}));

/**
 * The city index.
 *
 * The hub page for each city, and every treatment that city can book. This
 * is the one place on the site where the service tree and the area tree are
 * shown together — the two clusters met at the service-and-city pages, and
 * nothing above them pointed at the meeting point.
 */
const cities = getCoveredAreas().map((shell) => ({
  name: shell.name,
  slug: shell.slug,
  proximity: shell.proximity,
  treatments: getServiceAreasForArea(shell.slug).map((record) => ({
    name: services.find((s) => s.slug === record.service)?.name ?? record.service,
    href: areaServicePath(record.area, record.service),
    price: services.find((s) => s.slug === record.service)?.menuPrice ?? '',
  })),
}));
---

<BaseLayout
  title="Treatments & Prices in San Diego | KIAMO Skin"
  description="Every treatment at KIAMO Skin in San Diego, with published prices. HydraFacial, peels, dermaplaning, enzyme therapy and scalp therapy. From $199."
  headerTheme="dark"
>
  <CollectionSchema
    slot="head"
    name="Treatments and prices in San Diego"
    description="Every corrective skin and scalp treatment available at KIAMO Skin in San Diego, with published prices."
    items={services.map((s) => ({ name: s.name, path: servicePath(s.slug) }))}
  />
  <BreadcrumbSchema slot="head" trail={[{ name: 'Services', path: '/services/' }]} />
  <FaqSchema slot="head" faqs={faqs} />
  <SpeakableSchema slot="head" />

  <article>
    {/* The hero. The photograph is the background, the copy sits over it,
        and the price table and the city index are one click away. */}
    <PageHero
      eyebrow="Every treatment · Every price published"
      h1="Corrective skin & scalp treatments"
      h1Accent="in San Diego"
      claim="The right treatment depends on the skin tone, the concern, and the condition of the barrier — not on what is trending."
      paragraph="Every treatment below is performed by Kiki, a California licensed esthetician with 7+ years in corrective skin, in one private treatment room. Prices are published here and confirmed at booking."
      prices="Dermaplaning from $199 · HydraFacial $259 · First visit $249"
      image={heroImage}
      imageAlt="The KIAMO Skin treatment room in Mission Hills, San Diego — a single private room with one treatment bed"
      price={{ label: 'First-time client treatment', price: verifiedPrices['first-time-client'] }}
      trust={[
        { label: 'Safe for every Fitzpatrick type, I–VI' },
        { label: 'Prices published before a booking is made' },
        { label: 'Licensed esthetician, 7+ years' },
        { label: 'One practitioner, every visit' },
      ]}
      reassurance={[
        business.visit.appointmentOnly,
        business.visit.parking,
        'Free cancellation up to 48 hours before',
      ]}
      ancestors={[{ name: 'Services', path: '/services/' }]}
      current="San Diego"
      eventLabel="services_hero"
    />

    {
      groups.map((group) => {
        const rows = services.filter((s) => s.category === group.key);
        if (rows.length === 0) return null;
        return (
          <section class={`${group.tone} py-14 md:py-20`}>
            <div class="wrap">
              <Reveal>
                <p class="t-eyebrow text-ink-soft">{group.key}</p>
                <h2 class="t-h3 mt-3 max-w-[40ch]">{group.note}</h2>
              </Reveal>
              <ul class="m-0 mt-10 grid list-none gap-x-12 gap-y-0 p-0 md:grid-cols-2">
                {rows.map((service) => (
                  <li class="border-b border-line">
                    <a href={servicePath(service.slug)} class="group block py-7">
                      {/* The price is allowed to shrink and wrap rather than
                          being held at its full width. "Pricing at
                          consultation." is a long phrase, and with `shrink-0`
                          it pushed the row past the viewport on a 390px
                          screen. */}
                      <div class="flex items-baseline justify-between gap-x-6 gap-y-2">
                        <h3 class="t-service min-w-0 text-[1.0625rem] transition-colors duration-300 group-hover:text-rose md:text-[1.1875rem]">
                          {service.name}
                        </h3>
                        {service.menuPrice && (
                          <p class="t-price shrink text-[1.0625rem] text-rose md:shrink-0">
                            {service.menuPrice}
                          </p>
                        )}
                      </div>
                      <p class="t-body mt-2 text-[0.9375rem] text-ink-soft">
                        {service.opener}
                      </p>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        );
      })
    }

    {/* The price table. Every price on the menu, in one grid, with what each
        treatment is actually for beside it. */}
    <section class="bg-ivory py-20 md:py-28">
      <div class="wrap">
        <div class="max-w-[68ch]">
          <Reveal>
            <p class="t-eyebrow text-ink-soft">Every price, in one place</p>
            <h2 class="t-h2 mt-5">What each treatment costs.</h2>
            <p class="t-body mt-6 leading-relaxed">
              Nothing here is quoted at the door. The first visit is $249 wherever a client start, and it
              includes the consultation that decides which treatment follows.
            </p>
          </Reveal>
        </div>

        <div class="mt-12 overflow-x-auto">
          <table class="w-full border-collapse text-left">
            <thead>
              <tr class="border-b border-line">
                <th class="t-eyebrow py-4 pr-6 align-bottom text-ink-soft">Treatment</th>
                <th class="t-eyebrow py-4 pr-6 align-bottom text-ink-soft">What it is for</th>
                <th class="t-eyebrow py-4 align-bottom text-ink-soft">Price</th>
              </tr>
            </thead>
            <tbody>
              {priceTable.map((row) => (
                <tr class="border-b border-line align-top">
                  <td class="py-5 pr-6">
                    <a
                      href={row.href}
                      class="t-service text-[1rem] transition-colors duration-300 hover:text-rose"
                    >
                      {row.name}
                    </a>
                  </td>
                  <td class="t-body py-5 pr-6 text-[0.9375rem] text-ink-soft">{row.for}</td>
                  <td class="t-price py-5 whitespace-nowrap text-rose">{row.price}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    {/* The city index. The service tree and the area tree are shown together
        here — the two clusters met at the service-and-city pages, and nothing
        above them pointed at the meeting point. */}
    <section class="bg-porcelain py-20 md:py-28">
      <div class="wrap">
        <div class="max-w-[68ch]">
          <Reveal>
            <p class="t-eyebrow text-ink-soft">Across San Diego County</p>
            <h2 class="t-h2 mt-5 max-w-[26ch]">Every treatment, in every city served.</h2>
            <p class="t-body mt-6 leading-relaxed">
              The studio is in Mission Hills and clients travel from across the county. Each city
              below links to its own page, and each treatment to the page written for that
              treatment in that city.
            </p>
          </Reveal>
        </div>

        <ul class="m-0 mt-12 grid list-none gap-x-10 gap-y-0 p-0 md:grid-cols-2 lg:grid-cols-3">
          {cities.map((city) => (
            <li class="border-b border-line py-7">
              <a
                href={`/service-areas/${city.slug}/`}
                class="t-service text-[1.0625rem] transition-colors duration-300 hover:text-rose md:text-[1.1875rem]"
              >
                {city.name}
              </a>
              <p class="t-body mt-2 text-[0.9375rem] text-ink-soft">{city.proximity}</p>
              <ul class="m-0 mt-4 list-none space-y-2 p-0">
                {city.treatments.map((treatment) => (
                  <li class="t-body flex items-baseline justify-between gap-x-4 text-[0.9375rem]">
                    <a
                      href={treatment.href}
                      class="border-b border-transparent transition-colors duration-300 hover:border-rose hover:text-rose"
                    >
                      {treatment.name}
                    </a>
                    {treatment.price && <span class="shrink-0 text-ink-soft">{treatment.price}</span>}
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="bg-ivory py-20 md:py-28">
      <div class="wrap section-y">
        <div class="max-w-[68ch]">
          <Reveal>
            <p class="t-eyebrow text-ink-soft">From the treatment room</p>
            <h2 class="t-h2 mt-5">What clients say once they have been in.</h2>
          </Reveal>
          <div class="mt-10">
            <VerifiedProof quotes={getServiceTestimonials('services')} />
          </div>
        </div>
      </div>
    </section>

    <section class="bg-porcelain py-20 md:py-28">
      <div class="wrap section-y">
        <div class="max-w-[68ch]">
          <Reveal>
            <p class="t-eyebrow text-ink-soft">Before a booking is made</p>
            <h2 class="t-h2 mt-5">Questions, answered</h2>
          </Reveal>
          <div class="faq-section mt-12">
            {faqs.map((faq) => (
              <div class="border-b border-line py-7 first:pt-0">
                <h3 class="t-service text-[1.0625rem] md:text-[1.1875rem]">{faq.question}</h3>
                <p class="t-body mt-3 text-[0.9375rem]">{faq.answer}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="bg-ivory py-16 md:py-20">
      <div class="wrap">
        <NapBlock />
      </div>
    </section>
  </article>
</BaseLayout>
