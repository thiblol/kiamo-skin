                  <span>{faq.question}</span>
                  <span
                    aria-hidden="true"
                    class="shrink-0 text-rose transition-transform duration-300 group-open:rotate-45"
                  >
                    +
                  </span>
                </summary>
                <div class="t-body pb-6 text-[0.9375rem]">
                  {faq.answer}
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    {/* CLOSING CTA */}
    <section class="bg-espresso text-porcelain">
      <div class="wrap py-20 md:py-28 grid gap-12 md:grid-cols-[1.2fr_1fr] md:gap-20">
        <div>
          <Reveal>
            <p class="t-eyebrow text-porcelain/60">The next step</p>
            <h2 class="t-h2 mt-5 max-w-[24ch]">Bring the gallery to your own skin.</h2>
            <p class="t-body mt-7 max-w-[58ch] text-porcelain/85">
              The first visit at KIAMO Skin is a consultation, not a fixed protocol. The cases
              on this page show what the studio has done; the consultation decides what your
              skin actually needs now, and the plan follows from that.
            </p>

            <div class="mt-9 flex flex-wrap items-center gap-x-8 gap-y-4">
              <Button href={business.bookingUrl} external trackEvent="booking_click">
                {CTA_LABEL}
              </Button>
              <a
                href={business.phone.href}
                class="t-body border-b border-porcelain/40 pb-1 hover:border-blush hover:text-blush"
              >
                {business.phone.display}
              </a>
            </div>
          </Reveal>
        </div>

        <aside>
          <div class="border border-porcelain/20 p-8">
            <p class="t-eyebrow text-porcelain/60">Studio visit</p>
            <div class="mt-7 space-y-4 text-[0.9375rem]">
              <p>{business.address.full}</p>
              <p>Free parking on site</p>
              <p class="text-porcelain/70">{business.cancellation}</p>
              <p class="text-porcelain/70">
                First-time visit package{' '}
                <span class="t-tier-price text-[2rem] text-porcelain">$249</span>
              </p>
            </div>
          </div>
        </aside>
      </div>
    </section>
  </article>
</BaseLayout>

<script>
  const grid = document.getElementById('gallery-grid');
  const empty = document.getElementById('gallery-empty');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');

  if (grid && empty && buttons.length) {
    const apply = (id: string) => {
      grid.dataset.active = id;
      buttons.forEach((b) => {
        b.setAttribute('aria-selected', String(b.dataset.filter === id));
      });

      const cards = grid.querySelectorAll<HTMLElement>('[data-concern]');
      let visible = 0;
      cards.forEach((card) => {
        if (id === 'all' || card.dataset.concern === id) visible += 1;
      });
      empty.hidden = visible > 0;
    };

    buttons.forEach((b) => {
      b.addEventListener('click', () => apply(b.dataset.filter ?? 'all'));
    });
  }
</script>

<style>
  #gallery-grid[data-active='all'] [data-concern],
  #gallery-grid:not([data-active='all']) [data-concern]:not([hidden]) {
    display: list-item;
  }

  #gallery-grid[data-active='pigmentation'] [data-concern]:not([data-concern='pigmentation']),
  #gallery-grid[data-active='melasma'] [data-concern]:not([data-concern='melasma']),
  #gallery-grid[data-active='acne'] [data-concern]:not([data-concern='acne']),
  #gallery-grid[data-active='barrier'] [data-concern]:not([data-concern='barrier']),
  #gallery-grid[data-active='scalp'] [data-concern]:not([data-concern='scalp']) {
    display: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  [role='tab']:focus-visible {
    outline: 2px solid var(--color-rose);
    outline-offset: 3px;
  }
</style>
