---
import BaseLayout from '../layouts/BaseLayout.astro';
import Reveal from '../components/Reveal.astro';
import Button from '../components/Button.astro';
import NapBlock from '../components/NapBlock.astro';
import FaqSchema from '../components/schema/FaqSchema.astro';
import { services } from '../data/services';
import { business } from '../config/business';
import { CTA_LABEL } from '../config/nav';

/**
 * Booking through Vagaro is a REQUEST, not an instant confirmation. Spec §2 — the
 * page has to say so plainly, or the demo sets a false expectation.
 */
const steps = [
  {
    title: 'Send the request',
    body: 'Pick the treatment you think you need and send it through. If you are not sure which one, choose the First-Time Client Treatment — that visit exists to work it out.',
  },
  {
    title: 'Wait for confirmation',
    body: 'Requests are reviewed and confirmed directly, so the time you pick is not booked until you hear back. Check your email and phone for the confirmation.',
  },
  {
    title: 'Arrive with clean skin',
    body: `Please arrive with clean skin if possible. Before your appointment, text photos of the skincare products you currently use to ${business.phone.display}. Reviewing your routine beforehand allows us to provide more personalized recommendations from the moment you arrive.`,
  },
];

const firstVisit = services.find((s) => s.name === 'First-Time Client Treatment');

/**
 * Pre-visit questions. These are the things that decide whether a treatment is
 * safe to book, and the answers are already the studio's clinical protocol —
 * the contraindications live on the treatment pages, and repeating the rule
 * here is what stops a client booking straight into one.
 */
const faqs = [
  {
    question: 'How far in advance should I book my first appointment?',
    answer:
      'Requests are confirmed directly rather than held automatically, so booking early gives more choice. Most clients book one to two weeks ahead, and two to three weeks for a specific time slot or a weekend. First-time clients should book at least three to five days ahead so there is room for a full consultation rather than a shortened slot. Call ' +
      business.phone.display +
      ' if a specific time matters.',
  },
  {
    question: 'Is it safe to get a facial while pregnant or breastfeeding?',
    answer:
      'Facials are generally fine during pregnancy, but the protocol narrows. Peels are the exception — peels are contraindicated during pregnancy, so they wait. The product list is screened as well: azelaic acid, niacinamide, kojic acid and vitamin C are the ones that stay, while retinoids and hydroquinone do not, and oral tranexamic acid is out too. Anything that cannot be confirmed as pregnancy-safe is left out rather than trialled on the spot. Strict mineral sunscreen with zinc oxide or titanium dioxide, SPF 50+, is the single most important step during pregnancy, and it applies whether or not a treatment is booked.',
  },
  {
    question: 'Is a peel safe if I am on a retinoid?',
    answer:
      'Retinoids come off before a peel, not during. Stop tretinoin, Retin-A, adapalene and retinol a few days beforehand — the protocol here is three to five days — and leave them off for five to seven days afterwards while the peel does its work, because retinoids and acids together strip the barrier faster than either would alone. Isotretinoin is a different category: peels are not performed during a course of isotretinoin or soon after one, because the skin is rebuilding from nothing while that is happening. Bring the name of what you are using to the consultation and the timing is set around it.',
  },
];
---

<BaseLayout
  title="Request an Appointment | KIAMO Skin San Diego"
  description="Request an appointment at KIAMO Skin in Mission Hills, San Diego. Appointment-only studio for corrective facials, peels and scalp therapy."
>
  <FaqSchema slot="head" faqs={faqs} />

  <header class="bg-blush">
    <div class="wrap section-y pt-[calc(60px+72px)] md:pt-[calc(60px+112px)]">
      <p class="t-eyebrow text-ink-soft">Booking</p>
      <h1 class="t-h2 mt-6 max-w-[20ch] text-[2.5rem] md:text-[4rem]">
        Request an appointment.
      </h1>
      <p class="t-body mt-7 max-w-[62ch]">
        KIAMO Skin is {business.visit.appointmentOnly.toLowerCase()}. Booking runs through Vagaro
        as a request — you choose a time, and it is confirmed back to you rather than held
        automatically.
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <Button href={business.bookingUrl} external trackEvent="booking_click">{CTA_LABEL}</Button>
        <Button variant="ghost" href={business.phone.href} trackEvent="phone_click">Call {business.phone.display}</Button>
      </div>
    </div>
  </header>

  <section class="bg-porcelain">
    <div class="wrap section-y">
      <h2 class="t-h3">How it works</h2>
      <ol class="mt-12 m-0 grid list-none gap-12 p-0 md:grid-cols-3 md:gap-10">
        {
          steps.map((step, i) => (
            <Reveal as="li" class="border-t border-line pt-8">
              <p class="t-meta text-rose">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="t-service mt-4 text-[1.125rem] md:text-[1.3125rem]">{step.title}</h3>
              <p class="t-body mt-4 text-[0.9375rem]">{step.body}</p>
            </Reveal>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="bg-ivory">
    <div class="wrap section-y grid gap-16 md:grid-cols-2 md:gap-20">
      <div>
        <h2 class="t-h3">First time here?</h2>
        <p class="t-body mt-6">
          The First-Time Client Treatment is a full consultation and treatment together: a proper
          look at what your skin is doing, a plan for the next few months, and a deep dive into
          the right routine to run at home.
        </p>
        <p class="t-price mt-7">{firstVisit?.price}</p>
        <p class="t-body mt-3 text-[0.875rem] text-ink-soft">
          Most pricing is confirmed at consultation, because the protocol depends on what your
          skin can take. The three set prices are listed on the
          <a href="/treatments/" class="border-b border-ink hover:border-rose hover:text-rose"
            >treatments page</a
          >. If you expect to come back monthly, a
          <a href="/membership/" class="border-b border-ink hover:border-rose hover:text-rose"
            >skin membership</a
          > costs less than booking the same treatments individually.
        </p>
      </div>

      <div>
        <h2 class="t-h3">Cancellations</h2>
        <p class="t-body mt-6">{business.cancellation}</p>
        <div class="mt-10">
          <NapBlock tone="light" />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-porcelain">
    <div class="wrap section-y">
      <Reveal>
        <p class="t-eyebrow text-ink-soft">Before you request</p>
        <h2 class="t-h3">Questions to ask before booking</h2>
      </Reveal>

      <div class="faq-section mt-12 max-w-[72ch]">
        {
          faqs.map((faq) => (
            <div class="border-b border-line">
              <details class="group">
                <summary class="t-service flex cursor-pointer list-none items-center justify-between gap-6 py-6 text-[1.0625rem] hover:text-rose md:text-[1.1875rem]">
                  <span>{faq.question}</span>
                  <span
                    aria-hidden="true"
                    class="shrink-0 text-rose transition-transform duration-300 group-open:rotate-45"
                  >
                    +
                  </span>
                </summary>
                <div class="t-body pb-6 text-[0.9375rem] leading-relaxed">{faq.answer}</div>
              </details>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
