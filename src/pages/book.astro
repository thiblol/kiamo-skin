---
import BaseLayout from '../layouts/BaseLayout.astro';
import Reveal from '../components/Reveal.astro';
import Button from '../components/Button.astro';
import NapBlock from '../components/NapBlock.astro';
import FaqList from '../components/FaqList.astro';
import FaqSchema from '../components/schema/FaqSchema.astro';
import BreadcrumbSchema from '../components/schema/BreadcrumbSchema.astro';
import PageHero from '../components/PageHero.astro';
import studio from '../assets/kiamo-skin-studio-mission-hills-san-diego.jpg';
import RequestForm from '../components/sections/RequestForm.astro';
import VerifiedProof from '../components/VerifiedProof.astro';
import { services } from '../data/services';
import { getServiceTestimonials } from '../data/testimonials';
import { business, verifiedPrices } from '../config/business';
import { CTA_LABEL } from '../config/nav';

/**
 * Booking through Vagaro is a REQUEST, not an instant confirmation. Spec §2 — the
 * page has to say so plainly, or the demo sets a false expectation.
 */
const steps = [
  {
    title: 'Send the request',
    body: 'Pick the treatment you think you need and send it through. If you are not sure which one, choose the First-Time Client Treatment — that visit exists to work it out.',
  },
  {
    title: 'Wait for confirmation',
    body: 'Requests are reviewed and confirmed directly, so the time you pick is not booked until you hear back. Check your email and phone for the confirmation.',
  },
  {
    title: 'Arrive with clean skin',
    body: `Please arrive with clean skin if possible. Before your appointment, text photos of the skincare products you currently use to ${business.phone.display}. Reviewing your routine beforehand allows us to provide more personalized recommendations from the moment you arrive.`,
  },
];

const firstVisit = services.find((s) => s.name === 'First-Time Client Treatment');

/**
 * Pre-visit questions. These are the things that decide whether a treatment is
 * safe to book, and the answers are already the studio's clinical protocol —
 * the contraindications live on the treatment pages, and repeating the rule
 * here is what stops a client booking straight into one.
 */
const faqs = [
  {
    question: 'How far in advance should I book my first appointment?',
    answer:
      'Requests are confirmed directly rather than held automatically, so booking early gives more choice. Most clients book one to two weeks ahead, and two to three weeks for a specific time slot or a weekend. First-time clients should book at least three to five days ahead so there is room for a full consultation rather than a shortened slot. Call ' +
      business.phone.display +
      ' if a specific time matters.',
  },
  {
    question: 'Is it safe to get a facial while pregnant or breastfeeding?',
    answer:
      'Facials are generally fine during pregnancy, but the protocol narrows. Peels are the exception — peels are contraindicated during pregnancy, so they wait. The product list is screened as well: azelaic acid, niacinamide, kojic acid and vitamin C are the ones that stay, while retinoids and hydroquinone do not, and oral tranexamic acid is out too. Anything that cannot be confirmed as pregnancy-safe is left out rather than trialled on the spot. Strict mineral sunscreen with zinc oxide or titanium dioxide, SPF 50+, is the single most important step during pregnancy, and it applies whether or not a treatment is booked.',
  },
  {
    question: 'Is a peel safe if I am on a retinoid?',
    answer:
      'Retinoids come off before a peel, not during. Stop tretinoin, Retin-A, adapalene and retinol a few days beforehand — the protocol here is three to five days — and leave them off for five to seven days afterwards while the peel does its work, because retinoids and acids together strip the barrier faster than either would alone. Isotretinoin is a different category: peels are not performed during a course of isotretinoin or soon after one, because the skin is rebuilding from nothing while that is happening. Bring the name of what you are using to the consultation and the timing is set around it.',
  },
];

/**
 * The confirmation.
 *
 * The enquiry form posts to /api/appointment-request, and without JavaScript
 * that function answers with a redirect to /book/?sent=1. This page was the
 * destination — and it had no form on it, so a reader who had just sent an
 * enquiry landed on a page that only offered a link out to Vagaro. The
 * arrival now says what actually happened.
 */
const sent = Astro.url.searchParams.get('sent') === '1';
---

<BaseLayout
  title="Request an Appointment | KIAMO Skin San Diego"
  description="Request an appointment at KIAMO Skin in San Diego. An appointment-only studio in Mission Hills for corrective facials, peels and scalp therapy."
  headerTheme="dark"
>
  <FaqSchema slot="head" faqs={faqs} />
  <BreadcrumbSchema slot="head" trail={[{ name: 'Book', path: '/book' }]} />

  {/* The hero. Same pattern as every other page: the photograph is the
      background, and the request is in the first screen. */}
  <PageHero
    eyebrow="By appointment only · Free parking"
    h1="Request an appointment."
    claim="Booking runs through Vagaro as a request — you choose a time, and it is confirmed back to you rather than held automatically."
    paragraph="The first visit is a full consultation and treatment together: a proper look at what your skin is doing, a plan for the next few months, and the home routine to run between visits. Nothing is treated before it has been looked at."
    image={studio}
    imageAlt="Inside the KIAMO Skin treatment room in Mission Hills, San Diego"
    price={{ label: 'First-time client treatment', price: verifiedPrices['first-time-client'] }}
    trust={[
      { label: 'Prices published before you book' },
      { label: 'One practitioner, every visit' },
      { label: 'Free cancellation up to 48 hours before' },
      { label: 'Free parking on site' },
    ]}
    reassurance={[
      business.visit.appointmentOnly,
      business.visit.parking,
      'Consultations included — the plan is set before you book',
    ]}
    ancestors={[{ name: 'Appointments', path: '/book/' }]}
    current="Request"
    eventLabel="book_hero"
  />

  {sent && (
    <section class="bg-espresso text-porcelain">
      <div class="wrap py-12 md:py-14">
        <p class="t-eyebrow text-porcelain/60">Request received</p>
        <h2 class="t-h3 mt-4 max-w-[34ch]">Your request is with the studio.</h2>
        <p class="t-body mt-5 max-w-[58ch] text-porcelain/75">
          A request is confirmed by the studio rather than held automatically, so the appointment
          is yours once you hear back. Check your email and your phone. If it is urgent, call{' '}
          {business.phone.display}.
        </p>
      </div>
    </section>
  )}

  {/* The request. The form is the primary path — it takes the enquiry first —
      and the Vagaro link sits beside it for the reader who would rather pick
      a slot themselves. The form adds a route rather than replacing one. */}
  <section class="bg-porcelain py-20 md:py-28">
    <div class="wrap grid gap-12 md:grid-cols-[1.05fr_0.95fr] md:gap-16">
      <div>
        <Reveal>
          <p class="t-eyebrow text-ink-soft">How it works</p>
          <h2 class="t-h2 mt-4 max-w-[24ch]">Three steps, and the plan is set before anything is applied.</h2>
        </Reveal>
        <ol class="mt-12 m-0 grid list-none gap-10 p-0 md:grid-cols-3 md:gap-8">
          {
            steps.map((step, i) => (
              <Reveal as="li" class="border-t border-line pt-7">
                <p class="t-meta text-rose">{String(i + 1).padStart(2, '0')}</p>
                <h3 class="t-service mt-3 text-[1.125rem] md:text-[1.3125rem]">{step.title}</h3>
                <p class="t-body mt-3 text-[0.9375rem]">{step.body}</p>
              </Reveal>
            ))
          }
        </ol>

        <div class="mt-14 border-t border-line pt-9">
          <p class="t-eyebrow text-ink-soft">Or choose a time yourself</p>
          <p class="t-body mt-4 max-w-[54ch]">
            The booking calendar below shows every open slot. A request made there is confirmed the
            same way as one sent through the form.
          </p>
          <div class="mt-6">
            <Button href={business.bookingUrl} external trackEvent="booking_click" eventLabel="book_calendar">
              {CTA_LABEL}
            </Button>
          </div>
        </div>
      </div>

      <RequestForm tone="light" />
    </div>
  </section>

  {/* What the first visit actually is. A booking page that only explains the
      form tells a reader how to book but not what they are buying, and the
      answer to the second question is the one that stops the request being
      made — especially for corrective work, where a series is a commitment
      and a reader needs to know what the series is before they agree to it. */}
  <section class="bg-porcelain py-20 md:py-28">
    <div class="wrap">
      <div class="max-w-[68ch]">
        <Reveal>
          <p class="t-eyebrow text-ink-soft">Your first visit</p>
          <h2 class="t-h2 mt-4 max-w-[26ch]">
            The consultation is the treatment, in the sense that it is where the decision is made.
          </h2>
        </Reveal>

        <div class="mt-12 grid gap-10 md:grid-cols-2 md:gap-12">
          <Reveal>
            <p class="t-meta text-rose">01</p>
            <h3 class="t-service mt-3 text-[1.125rem] md:text-[1.3125rem]">
              Skin tone and barrier, before anything else
            </h3>
            <p class="t-body mt-4 text-[0.9375rem]">
              Fitzpatrick type is recorded, from I to VI, and the barrier is assessed on the day
              rather than assumed. A compromised barrier changes what can safely be applied, so
              this is the first thing looked at — and it is the thing that most often means the
              first visit is preparation rather than treatment.
            </p>
          </Reveal>

          <Reveal>
            <p class="t-meta text-rose">02</p>
            <h3 class="t-service mt-3 text-[1.125rem] md:text-[1.3125rem]">
              The cause of the concern, not the label on it
            </h3>
            <p class="t-body mt-4 text-[0.9375rem]">
              Post-inflammatory marks, melasma and sun damage look alike and respond in opposite
              directions, so the kind of mark is identified before anything is chosen. A mark left
              behind by acne, a symmetrical hormonal pattern and scattered sun damage each need a
              different plan.
            </p>
          </Reveal>

          <Reveal>
            <p class="t-meta text-rose">03</p>
            <h3 class="t-service mt-3 text-[1.125rem] md:text-[1.3125rem]">
              What has already been tried
            </h3>
            <p class="t-body mt-4 text-[0.9375rem]">
              Products used without guidance, peels performed elsewhere, and anything that caused
              a reaction. A previous reaction to a strong peel is not a footnote — it changes the
              order of the plan, because skin that has darkened after acid is usually better
              served by starting with the treatment that carries no acid.
            </p>
          </Reveal>

          <Reveal>
            <p class="t-meta text-rose">04</p>
            <h3 class="t-service mt-3 text-[1.125rem] md:text-[1.3125rem]">
              The modality, the strength and the series
            </h3>
            <p class="t-body mt-4 text-[0.9375rem]">
              Which treatment, at what strength, how many sessions, how far apart, and what to do
              at home in between. Strength escalates across a series rather than starting high.
              The home routine is prescribed rather than left to chance, because it is what
              maintains the result once the series ends.
            </p>
          </Reveal>
        </div>

        <p class="t-body mt-12 max-w-[62ch]">
          Corrective work is planned across a series rather than sold as a single session, and
          the plan is mapped at the first appointment — the number of sessions, the intervals and
          the total timeline, so nothing about the commitment is a surprise later. If you expect
          to come back monthly, a{' '}
          <a href="/membership/" class="border-b border-ink/40 hover:border-rose hover:text-rose">
            monthly skin membership</a
          > costs less than booking the same treatments one at a time.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-ivory">
    <div class="wrap section-y grid gap-16 md:grid-cols-2 md:gap-20">
      <div>
        <h2 class="t-h3">First time here?</h2>
        <p class="t-body mt-6">
          The First-Time Client Treatment is a full consultation and treatment together: a proper
          look at what your skin is doing, a plan for the next few months, and a deep dive into
          the right routine to run at home.
        </p>
        <p class="t-price mt-7">{firstVisit?.price}</p>
        <p class="t-body mt-3 text-[0.875rem] text-ink-soft">
          Most pricing is confirmed at consultation, because the protocol depends on what your
          skin can take. The three set prices are listed on the
          <a href="/services/" class="border-b border-ink hover:border-rose hover:text-rose"
            >treatments page</a
          >. If you expect to come back monthly, a
          <a href="/membership/" class="border-b border-ink hover:border-rose hover:text-rose"
            >skin membership</a
          > costs less than booking the same treatments individually.
        </p>
      </div>

      <div>
        <h2 class="t-h3">Cancellations</h2>
        <p class="t-body mt-6">{business.cancellation}</p>
        <div class="mt-10">
          <NapBlock tone="light" />
        </div>
      </div>
    </div>
  </section>

  {/* The proof. The booking page was the one page a reader reached AFTER
      deciding to enquire, and it carried no social proof of its own. */}
  <section class="bg-porcelain py-20 md:py-28">
    <div class="wrap">
      <div class="mx-auto max-w-[68ch]">
        <Reveal>
          <p class="t-eyebrow text-ink-soft">Before you request</p>
          <h2 class="t-h2 mt-4 max-w-[26ch]">What clients say once they have been in the room.</h2>
        </Reveal>
        <div class="mt-10">
          <VerifiedProof quotes={getServiceTestimonials('booking')} />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-ivory">
    <div class="wrap section-y">
      <Reveal>
        <p class="t-eyebrow text-ink-soft">Safety</p>
        <h2 class="t-h3">Questions to ask before booking</h2>
      </Reveal>

      <div class="mt-12 max-w-[72ch]">
        <FaqList faqs={faqs} />
      </div>
    </div>
  </section>
</BaseLayout>
