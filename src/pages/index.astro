---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import QuickAnswer from '../components/sections/QuickAnswer.astro';
import TreatmentMarquee from '../components/sections/TreatmentMarquee.astro';
import Credentials from '../components/sections/Credentials.astro';
import ConcernTiles from '../components/sections/ConcernTiles.astro';
import Outcomes from '../components/sections/Outcomes.astro';
import Results from '../components/sections/Results.astro';
import SocialReels from '../components/sections/SocialReels.astro';
import SanDiegoContext from '../components/sections/SanDiegoContext.astro';
import AreasNearby from '../components/sections/AreasNearby.astro';
import FaqLocation from '../components/sections/FaqLocation.astro';
import { faqs as homepageFaqs } from '../data/faqs';
import { reviewStats } from '../data/review-stats';
import PersonSchema from '../components/schema/PersonSchema.astro';
import SpeakableSchema from '../components/schema/SpeakableSchema.astro';

/**
 * The homepage, on the reference rhythm.
 *
 *   hero → the treatments and their prices → why-us proof → what to
 *   expect → proof → the local context → areas → questions → the studio
 *
 * It used to be twenty sections with thirteen headings, and the headings
 * repeated each other — a positioning statement, a credential grid and a
 * founder portrait all said the same thing in three different frames, and
 * four separate quotes were scattered between them. That is what a content
 * dump looks like: no two blocks are quite the same, so nothing feels like
 * it belongs.
 *
 * The rule now is one heading per topic. Proof repeats, but proof is a
 * section, not four — the client quotes live in one marquee, and the
 * set-piece quote that used to sit between the prices and the case list is
 * in that marquee too.
 */

/* Anchor dates for the WebPage schema node. The values are not invented
   per-build: they are the studio's launch and the current verification
   month. The build re-emits them on every render. */
const homepagePublished = '2025-01-01';
const homepageModified = '2026-10-03';

const homepageUrl = Astro.site ? new URL('/', Astro.site).href : 'https://kiamoskin.com/';
const websiteId = Astro.site ? new URL('/#website', Astro.site).href : 'https://kiamoskin.com/#website';

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': new URL('/#webpage', Astro.site).href,
  url: homepageUrl,
  name: 'Facial & Scalp Spa in San Diego | KIAMO Skin',
  description:
    `Licensed esthetician in San Diego. Facials, pigmentation, acne, and scalp therapy — safe for every skin type. ${reviewStats.count} five-star Google reviews. Request an appointment.`,
  isPartOf: { '@id': websiteId },
  inLanguage: 'en-US',
  datePublished: homepagePublished,
  dateModified: homepageModified,
};
---

<BaseLayout
  title="Facial & Scalp Spa in San Diego | KIAMO Skin"
  description={`Licensed esthetician in San Diego. Facials, pigmentation, acne, scalp therapy. ${reviewStats.count} five-star Google reviews. Request an appointment.`}
  headerTheme="dark"
>
  <PersonSchema slot="head" />
  <SpeakableSchema slot="head" url={homepageUrl} />
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(webPageSchema)} />

  <Hero />

  {/* The answer and the rating, in one band. The rating used to have a band
      of its own, which put two thin strips between the hero and the first
      real section. */}
  <QuickAnswer />
  <TreatmentMarquee />

  {/* The treatments, where to start with them, and what each one costs. */}
  <ConcernTiles />

  {/* Why-us proof: the positioning line, the practitioner, the credentials. */}
  <Credentials />

  {/* What correction actually takes, and the cases it has taken it in. */}
  <Outcomes />

  {/* The proof itself: before and after, the treatment room, and what
      clients say. The clips sit inside this section rather than claiming a
      heading of their own. */}
  <Results>
    <SocialReels slot="media" />
  </Results>

  {/* The local reason the skin behaves the way it does here, and the writing
      that goes into it. */}
  <SanDiegoContext />

  {/* Where the clients come from. */}
  <AreasNearby />

  <FaqLocation faqs={homepageFaqs} />
</BaseLayout>
