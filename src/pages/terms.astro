---
/**
 * Terms of Service
 *
 * Written from the studio's actual practices. Every clause here is drawn from
 * something the site already states elsewhere — the cancellation window from
 * `business.cancellation`, the membership terms from `data/memberships.ts`,
 * the appointment-request model from the booking pages — rather than from a
 * generic template.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Reveal from '../components/Reveal.astro';
import BreadcrumbSchema from '../components/schema/BreadcrumbSchema.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { business } from '../config/business';
import { terms as membershipTerms } from '../data/memberships';

const updated = 'November 7, 2026';
---

<BaseLayout
  title="Terms of Service | KIAMO Skin"
  description="The terms for booking, paying for and attending treatments at KIAMO Skin in Mission Hills, San Diego. Updated November 2026."
>
  <BreadcrumbSchema slot="head" trail={[{ name: 'Terms of Service', path: '/terms' }]} />

  <header class="bg-blush">
    <div class="wrap section-y pt-[calc(60px+72px)] md:pt-[calc(60px+112px)]">
      <Breadcrumbs current="Terms of Service" />
      <h1 class="t-h2 mt-6 max-w-[20ch] text-[2.5rem] md:text-[4rem]">Terms of Service</h1>
      <p class="t-body mt-7 max-w-[58ch] text-[1.125rem]">
        The short version: this is an esthetician studio, not a medical practice, and every
        treatment is performed by one person. Read the sections below before your first
        appointment.
      </p>
      <p class="t-meta mt-7">Last updated {updated}</p>
    </div>
  </header>

  <div class="bg-porcelain">
    <div class="wrap section-y">
      <div class="prose mx-auto max-w-[68ch]">
        <h2 class="t-h3">What this studio is</h2>
        <p class="t-body mt-5">
          KIAMO Skin is a single-room skin and scalp studio at {business.address.street} in
          {business.address.neighborhood}, San Diego. Every treatment is performed by
          {business.ownerName}, a California licensed esthetician with the
          {business.ownerCredential.replace('Licensed Esthetician, ', '')}, with
          {business.experience} of experience.
        </p>
        <p class="t-body mt-5">
          These are esthetician services. The studio does not diagnose skin conditions, does not
          prescribe, and does not perform medical or surgical procedures. If what you need
          requires prescription-strength intervention or medical treatment, a dermatologist is
          the right referral, and the studio will say so rather than sell you a series that
          will not reach the depth involved.
        </p>

        <h2 class="t-h3 mt-16">Booking</h2>
        <p class="t-body mt-5">
          The studio is {business.visit.appointmentOnly.toLowerCase()}. Booking runs through
          Vagaro as a request: you choose a time, and it is confirmed back to you rather than
          held automatically. A request that has been sent is not a booked appointment until
          the studio confirms it.
        </p>
        <p class="t-body mt-5">
          {business.visit.parking} at the studio. Please arrive with clean skin if possible, and
          bring a list of the skincare products you currently use.
        </p>

        <h2 class="t-h3 mt-16">Cancellations and missed appointments</h2>
        <p class="t-body mt-5">{business.cancellation}</p>

        <h2 class="t-h3 mt-16">Prices</h2>
        <p class="t-body mt-5">
          Treatment prices are published on each treatment page and are the current rates.
          Prices can change, and the rate that applies to your appointment is the rate in
          effect when it is performed. Membership pricing cannot be combined with other
          promotions.
        </p>

        <h2 class="t-h3 mt-16">Memberships</h2>
        <p class="t-body mt-5">
          Memberships renew automatically and carry a commitment period. The terms:
        </p>
        <ul class="mt-6 m-0 list-none space-y-4 p-0">
          {
            membershipTerms.map((term) => (
              <li class="t-body flex gap-4">
                <span aria-hidden="true" class="text-rose">
                  —
                </span>
                <span>{term}</span>
              </li>
            ))
          }
        </ul>
        <p class="t-body mt-6">
          Signup and consent happen on Vagaro. The recurring amount, the frequency, the minimum
          term and the cancellation method are set out above and are the ones you agree to at
          signup.
        </p>

        <h2 class="t-h3 mt-16">Results</h2>
        <p class="t-body mt-5">
          Results vary between people. The photographs on the
          <a href="/gallery/">results gallery</a> are the work of this studio on real clients,
          and the reviews on the <a href="/reviews/">reviews page</a> are published exactly as
          written. Neither is a guarantee of what a given treatment will do for a given skin.
          A plan is built on your skin on the day, and it is adjusted as the skin responds.
        </p>

        <h2 class="t-h3 mt-16">This website</h2>
        <p class="t-body mt-5">
          The content on this site is written for people in San Diego choosing a skin
          professional. It is general information about the studio and its services. It is not
          medical advice and it is not a diagnosis, and reading it does not create a
          clinical relationship with the studio.
        </p>
        <p class="t-body mt-5">
          The studio may update or correct content on this site at any time. Where a price or a
          policy is stated in more than one place, the page that covers your specific
          treatment or membership governs it.
        </p>

        <h2 class="t-h3 mt-16">Liability</h2>
        <p class="t-body mt-5">
          Treatments are performed by a licensed esthetician within the scope of the
          California Board of Barbering and Cosmetology, and every protocol is assessed against
          your skin before it is performed. You are asked at consultation about anything that
          affects what is safe to do, and answers are needed for the treatment to be carried
          out properly.
        </p>
        <p class="t-body mt-5">
          To the fullest extent permitted by law, the studio is not liable for indirect or
          consequential loss arising from a treatment. Nothing in these terms limits
          liability that cannot be limited by law.
        </p>

        <h2 class="t-h3 mt-16">Contact</h2>
        <p class="t-body mt-5">
          Questions about these terms, or anything about an appointment, go to
          <a href={`mailto:${business.email}`}>{business.email}</a> or
          <a href={business.phone.href}>{business.phone.display}</a>.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>
