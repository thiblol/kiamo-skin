---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutSchema from '../components/schema/AboutSchema.astro';
import BreadcrumbSchema from '../components/schema/BreadcrumbSchema.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PersonSchema from '../components/schema/PersonSchema.astro';
import Reveal from '../components/Reveal.astro';
import PanelWipe from '../components/PanelWipe.astro';
import Button from '../components/Button.astro';
import NapBlock from '../components/NapBlock.astro';
import CertificateModal from '../components/CertificateModal.astro';
import PageHero from '../components/PageHero.astro';
import VerifiedProof from '../components/VerifiedProof.astro';
import portrait from '../assets/kiki-licensed-esthetician-melanin-rich-skin-specialist-san-diego.jpg';
import studio from '../assets/kiamo-skin-studio-mission-hills-san-diego.jpg';
import consultation from '../assets/best-facial-san-diego-customized-consultation-mission-hills.jpg';
import { business, verifiedPrices } from '../config/business';
import { CTA_LABEL } from '../config/nav';
import { getServiceTestimonials } from '../data/testimonials';

/* Pronoun-free throughout — spec §2. */
const values = [
  {
    title: 'Education first',
    body: 'Clients leave knowing what was done and why, and what to do at home. A treatment a client does not understand is a treatment a client will not repeat correctly.',
  },
  {
    title: 'Every skin tone, with depth in the hardest ones',
    body: 'Every treatment protocol is selected for the Fitzpatrick type, from I to VI. Melanin-rich skin carries its own risks — post-inflammatory hyperpigmentation above all — and the protocols are built around avoiding them.',
  },
  {
    title: 'Consistency over intensity',
    body: 'Skin does not change overnight. A sensible plan followed for months beats an aggressive treatment followed by nothing.',
  },
];

/**
 * The consultation protocol.
 *
 * This is the studio's actual assessment sequence, written out rather than
 * described in the abstract. It is here for two reasons. A reader deciding
 * whether this is the right studio for their skin needs to see that the
 * decision is made methodically and not by a menu. And a search engine or a
 * language model trying to establish what this business is and how it works
 * has almost nothing else to read: this section is the page's answer to the
 * question every entity query asks, which is who does this, how, and on what
 * basis.
 */
const protocol = [
  {
    title: 'Skin tone and barrier, before anything else',
    body: 'Fitzpatrick type I to VI is recorded, and the barrier is assessed on the day rather than assumed. A compromised barrier changes what can safely be applied, so this is the first thing looked at and the thing that most often means the first visit is preparation rather than treatment.',
  },
  {
    title: 'The cause of the concern, not the label on it',
    body: 'Post-inflammatory marks, melasma and sun damage look alike and respond in opposite directions, so the kind of mark is identified first. A mark left behind by acne, a symmetrical hormonal pattern and scattered sun damage each need a different plan.',
  },
  {
    title: 'What has already been tried',
    body: 'Products used without guidance, peels performed elsewhere, and anything that caused a reaction. A previous reaction to a strong peel is not a footnote — it changes the order of the plan, because skin that has darkened after acid is usually better served by starting with the treatment that carries no acid.',
  },
  {
    title: 'The modality, the strength and the series',
    body: 'Which treatment, at what strength, how many sessions, how far apart, and what to do at home in between. Strength escalates across a series rather than starting high. The home routine is prescribed rather than left to chance, because it is what maintains the result once the series ends.',
  },
];

/**
 * What this studio is, and what it is not.
 *
 * The scope-of-practice paragraph belongs on this page rather than buried in
 * the footer, because a reader choosing between a facial spa and a medical
 * practice is making exactly this decision, and the answer determines whether
 * the studio is right for them. It is also the answer a search engine needs
 * when it is asked what this business is.
 */
const scope = [
  {
    title: 'A facial spa, not a medical practice',
    body: 'Every treatment here is performed within an esthetician’s scope of practice. There are no lasers, no prescriptions and no injectables. If a concern needs a dermatologist, that is what is recommended, and the referral is made plainly rather than after a paid visit.',
  },
  {
    title: 'One room, one practitioner, no rotation',
    body: 'There is a single treatment room and a single practitioner. The person who assesses the skin is the person who treats it, at every visit in the series, which is what makes the plan adjustable — the same plan cannot be adjusted by whoever happens to be working that day.',
  },
  {
    title: 'By appointment only',
    body: 'The studio is open by appointment rather than on a timetable, which means no waiting, no overlapping clients in the room, and a space free in the car park when a client arrive. It also means the request is reviewed before it is confirmed.',
  },
  {
    title: 'Every price published before a booking is made',
    body: 'Nothing is quoted at the door. The treatment menu carries a price against every treatment on it, and the first visit includes the consultation that decides the plan — so the cost of a first appointment is known before it is booked, not after.',
  },
];
---

<BaseLayout
  title="About KIAMO Skin — Esthetician in San Diego"
  description="KIAMO Skin is a Black-owned facial spa in San Diego run by a licensed esthetician. Corrective facials, peels and scalp therapy for every skin type."
  headerTheme="dark"
>
  <AboutSchema slot="head" />
  <BreadcrumbSchema slot="head" trail={[{ name: 'About', path: '/about' }]} />
  <PersonSchema slot="head" />

  {/* The hero. Every page on the site now opens the same way — the
      photograph is the background, the copy sits over it, the price and the
      action are in the first screen, and the spacing under the nav is
      identical page to page. This one used to be a wide band of empty blush
      with the portrait boxed into the right half. */}
  <PageHero
    eyebrow={`${business.ownerName} · ${business.ownerCredential}`}
    h1="A studio built around correction."
    claim="Correction begins by understanding what is causing the concern, not simply covering it up."
    paragraph="Every treatment is designed to strengthen the skin and scalp from the inside out through advanced technology, evidence-based care, and a plan that evolves with a client."
    image={portrait}
    imageAlt={`${business.ownerName}, licensed esthetician and owner of KIAMO Skin, in the treatment room`}
    price={{ label: 'First-time client treatment', price: verifiedPrices['first-time-client'] }}
    trust={[
      { label: `${business.experience} of corrective skin work` },
      { label: 'One practitioner, every visit' },
      { label: 'One private treatment room' },
      { label: 'Prices published before a booking is made' },
    ]}
    reassurance={[
      business.visit.appointmentOnly,
      business.visit.parking,
      'Free cancellation up to 48 hours before',
    ]}
    current="About"
    eventLabel="about_hero"
  />

  <section class="bg-porcelain py-20 md:py-28">
    <div class="wrap grid items-center gap-12 md:grid-cols-[1fr_0.9fr] md:gap-20">
      <div>
        <p class="t-eyebrow text-ink-soft">{business.ownerName}</p>
        <h2 class="t-h2 mt-5 text-[2rem] md:text-[2.75rem]">{business.ownerCredential}</h2>

        <p class="t-body mt-7">
          Practicing corrective skincare since 2019, I combine advanced clinical treatments with
          individualized treatment planning. Every recommendation is intentional, based on your
          skin’s current condition, long-term goals, and what will deliver the healthiest results
          not simply the most aggressive treatment.
        </p>

        <blockquote class="t-h3 mt-10 border-l-2 border-rose pl-7 text-[1.5rem] md:text-[1.75rem]">
          This isn’t just a spa facial. This is strategy, correction, intention.
        </blockquote>

        <div class="mt-10 space-y-8">
          <div class="border-t border-line pt-8">
            <p class="t-body text-[0.875rem] text-ink-soft mb-4">Advanced certifications — click to view:</p>
            <div class="flex gap-6">
              <CertificateModal
                id="cert-hydrafacial-about"
                image="/images/hydrafacial-certified-provider-san-diego.jpg"
                thumb="/images/certificates/hydrafacial-certified-provider-160.webp"
                width={160}
                height={120}
                alt="HydraFacial Certified Provider certificate - KIAMO Skin, San Diego California"
                title="HydraFacial Certified Provider"
              />
              <CertificateModal
                id="cert-dmk-about"
                image="/images/dmk-certified-skin-therapist-kiki-kiamo.jpg"
                thumb="/images/certificates/dmk-certified-skin-therapist-160.webp"
                width={160}
                height={204}
                alt="DMK Certified Skin Therapist certificate - Kiki, KIAMO Skin San Diego"
                title="DMK Certified Skin Therapist"
              />
            </div>
          </div>

          <p class="t-body text-[0.9375rem] text-ink-soft">
            Every treatment on the{' '}
            <a href="/services/" class="border-b border-ink/40 hover:border-rose hover:text-rose"
              >published menu</a
            > carries a price, and the protocols, contraindications and pricing sit on each treatment's
            own page rather than behind a call.
          </p>

          <Button href="/services/" variant="ghost">See the treatments</Button>
        </div>
      </div>

      <div>
        <Image
          src={consultation}
          alt="A skin consultation at KIAMO Skin in Mission Hills, San Diego, before a corrective treatment is chosen"
          widths={[400, 800, 1200]}
          sizes="(min-width: 840px) 45vw, 90vw"
          loading="lazy"
          class="aspect-[3/4] w-full object-cover"
        />
      </div>
    </div>
  </section>

  <section class="bg-espresso text-porcelain">
    <div class="wrap section-y">
      <p class="t-eyebrow text-porcelain/60">How we work</p>
      <h2 class="t-h2 mt-5 max-w-[24ch]">
        An inclusive space where everyone feels seen.
      </h2>
      <p class="t-body mt-7 max-w-[62ch] text-porcelain/75">
        At KIAMO Skin, we are proud to be a Black-owned business committed to creating an
        inclusive space where everyone feels seen, valued, and cared for.
      </p>
      <p class="t-body mt-5 max-w-[62ch] text-porcelain/75">
        The studio works across every Fitzpatrick type, I to VI, and has particular depth in
        <a
          href="/melanin-rich-skin/"
          class="border-b border-porcelain/40 hover:border-blush hover:text-blush"
          >facials for melanin-rich skin in San Diego</a
        > — the treatment protocols for darker skin tones, and the pigment risk that comes with
        them, are what most of the clinical training was actually about.
      </p>

      <ul class="mt-16 m-0 grid list-none gap-12 p-0 md:grid-cols-3 md:gap-10">
        {
          values.map((value, i) => (
            <Reveal as="li">
              <p class="t-meta text-rose">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="t-h3 mt-4 text-[1.375rem] md:text-[1.5rem]">{value.title}</h3>
              <p class="t-body mt-4 text-[0.9375rem] text-porcelain/75">{value.body}</p>
            </Reveal>
          ))
        }
      </ul>

      {/* Placed directly under "Consistency over intensity", which is the
          principle the membership exists to deliver. */}
      <p class="t-body mt-14 max-w-[62ch] text-porcelain/75">
        A plan followed for months is what the
        <a
          href="/membership/"
          class="border-b border-porcelain/40 hover:border-blush hover:text-blush"
          >monthly skin membership</a
        > is built to make possible.
      </p>
      <p class="t-body mt-5 max-w-[62ch] text-porcelain/75">
        The approach to pigmentation starts with
        <a
          href="/journal/three-kinds-of-dark-mark/"
          class="border-b border-porcelain/40 hover:border-blush hover:text-blush"
          >knowing which kind of dark mark a client has</a
        >.
      </p>
    </div>
  </section>

  <section class="bg-porcelain">
    <div class="wrap section-y">
      <div class="max-w-[68ch]">
        <Reveal>
          <p class="t-eyebrow text-ink-soft">How a plan is built</p>
          <h2 class="t-h2 mt-5">
            What happens at the consultation, before anything is applied.
          </h2>
          <p class="t-body mt-7">
            The consultation is the treatment, in the sense that it is where the decision is made.
            One practitioner, seven years of corrective work, and the same four steps in the same
            order for every client. Nothing is applied to skin that has not been assessed, and no
            treatment is selected from a menu.
          </p>
        </Reveal>
      </div>

      <ol class="mt-14 m-0 grid list-none gap-10 p-0 md:grid-cols-2 md:gap-12">
        {
          protocol.map((step, i) => (
            <li>
              <p class="t-meta text-rose">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="t-h3 mt-4 text-[1.375rem] md:text-[1.5rem]">{step.title}</h3>
              <p class="t-body mt-4 text-[0.9375rem] text-ink-soft">{step.body}</p>
            </li>
          ))
        }
      </ol>

      <div class="mt-14 max-w-[68ch]">
        <p class="t-body">
          The protocol is the reason the studio treats
          <a href="/melanin-rich-skin/" class="border-b border-ink/40 hover:border-rose hover:text-rose">melanin-rich skin</a>
          with particular care rather than as a service category, and it is why
          <a
            href="/journal/chemical-peel-vs-microneedling-san-diego/"
            class="border-b border-ink/40 hover:border-rose hover:text-rose"
            >chemical peels and microchanneling are never offered as a straight either-or</a
          >.
        </p>
      </div>
    </div>
  </section>

  {/* What this studio is, and is not. A reader choosing between a facial spa
      and a medical practice is making exactly this decision, and the answer
      is what tells them whether they are in the right place. */}
  <section class="bg-ivory py-20 md:py-28">
    <div class="wrap section-y">
      <div class="max-w-[68ch]">
        <Reveal>
          <p class="t-eyebrow text-ink-soft">Scope of practice</p>
          <h2 class="t-h2 mt-5 max-w-[26ch]">What this studio is, and what it is not.</h2>
        </Reveal>
      </div>

      <ul class="mt-14 m-0 grid list-none gap-x-12 gap-y-10 p-0 md:grid-cols-2">
        {
          scope.map((item) => (
            <li class="border-t border-line pt-8">
              <h3 class="t-service text-[1.125rem] md:text-[1.3125rem]">{item.title}</h3>
              <p class="t-body mt-4 text-[0.9375rem] text-ink-soft">{item.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* The proof. The About page is the page a language model reads to decide
      whether this business is real, and it carried no client voice on it at
      all — only the studio describing itself. */}
  <section class="bg-porcelain py-20 md:py-28">
    <div class="wrap">
      <div class="mx-auto max-w-[68ch]">
        <Reveal>
          <p class="t-eyebrow text-ink-soft">From the treatment room</p>
          <h2 class="t-h2 mt-4 max-w-[26ch]">What clients say once they have been in.</h2>
        </Reveal>
        <div class="mt-10">
          <VerifiedProof quotes={getServiceTestimonials('about')} />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-ivory">
    <div class="wrap section-y grid gap-12 md:grid-cols-2 md:gap-20">
      <div>
        <PanelWipe class="aspect-4/3">
          <Image
            src={studio}
            alt="Inside the KIAMO Skin treatment room in San Diego"
            widths={[400, 800, 1600]}
            sizes="(min-width: 840px) 45vw, 90vw"
            loading="lazy"
            class="size-full object-cover"
          />
        </PanelWipe>
      </div>

      <div class="self-center">
        <p class="t-eyebrow text-ink-soft">The studio</p>
        <h2 class="t-h2 mt-5 text-[2rem] md:text-[2.5rem]">Visiting</h2>
        <div class="mt-8">
          <NapBlock tone="light" showCancellation />
        </div>
        <p class="t-body mt-7 text-[0.9375rem]">
          Clients travel from across San Diego County — from <a href="/service-areas/north-park/facial/" class="border-b border-ink/40 hover:border-rose hover:text-rose">North Park</a> (10 minutes) and <a href="/service-areas/la-jolla/facial/" class="border-b border-ink/40 hover:border-rose hover:text-rose">La Jolla</a> (20 minutes) to <a href="/service-areas/chula-vista/facial/" class="border-b border-ink/40 hover:border-rose hover:text-rose">Chula Vista</a> (25 minutes) and <a href="/service-areas/carlsbad/facial/" class="border-b border-ink/40 hover:border-rose hover:text-rose">Carlsbad</a> (35 minutes). Coastal communities like <a href="/service-areas/pacific-beach/facial/" class="border-b border-ink/40 hover:border-rose hover:text-rose">Pacific Beach</a>, <a href="/service-areas/encinitas/facial/" class="border-b border-ink/40 hover:border-rose hover:text-rose">Encinitas</a> and <a href="/service-areas/del-mar/facial/" class="border-b border-ink/40 hover:border-rose hover:text-rose">Del Mar</a> bring concerns shaped by ocean exposure, while inland areas like <a href="/service-areas/la-mesa/facial/" class="border-b border-ink/40 hover:border-rose hover:text-rose">La Mesa</a> see more UV-driven pigmentation. <a href="/service-areas/" class="border-b border-ink pb-1 hover:border-rose hover:text-rose">See drive times and directions for all areas</a>.
        </p>
        <div class="mt-9">
          <Button href={business.bookingUrl} external trackEvent="booking_click">{CTA_LABEL}</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
