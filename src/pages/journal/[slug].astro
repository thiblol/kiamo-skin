---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import FaqList from '../../components/FaqList.astro';
import { articles } from '../../data/articles';
import { business } from '../../config/business';
import { CTA_LABEL } from '../../config/nav';
import ArticleSchema from '../../components/schema/ArticleSchema.astro';
import BreadcrumbSchema from '../../components/schema/BreadcrumbSchema.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqSchema from '../../components/schema/FaqSchema.astro';
import HowToSchema from '../../components/schema/HowToSchema.astro';
import SpeakableSchema from '../../components/schema/SpeakableSchema.astro';

export function getStaticPaths() {
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const others = articles.filter((a) => a.slug !== article.slug);
const faqs = article.faqs ?? [];
const articleUrl = `${Astro.site ?? 'https://kiamoskin.com'}journal/${article.slug}/`;

/**
 * Dates render as "Month D, YYYY" without the Date constructor, so the server
 * and the client produce identical text. The byline sits above the article:
 * an author with credentials and a visible last-updated date are the two
 * E-E-A-T signals readers and AI systems look for on a piece like this.
 */
const formatDate = (iso: string): string => {
  const [year, month, day] = iso.split('-');
  const months = [
    'January', 'February', 'March', 'April', 'May', 'June',
    'July', 'August', 'September', 'October', 'November', 'December',
  ];
  return `${months[Number(month) - 1] ?? month} ${Number(day)}, ${year}`;
};
---

<BaseLayout title={article.title} description={article.description} ogType="article">
  <ArticleSchema slot="head" article={article} />
  {faqs.length > 0 && <FaqSchema slot="head" faqs={faqs} />}
  {article.howTo && <HowToSchema slot="head" article={article} />}
  <SpeakableSchema slot="head" url={articleUrl} />
  <BreadcrumbSchema
    slot="head"
    trail={[
      { name: 'Journal', path: '/journal' },
      { name: article.headline, path: `/journal/${article.slug}` },
    ]}
  />
  <article>
    {/* Hero. Same shape as the membership page: copy on the left, the photograph
        beside it rather than across the page, so the image reads as evidence
        instead of as a banner and never competes with the headline. */}
    <header class="bg-blush">
      <div
        class="wrap section-y grid items-center gap-12 pt-[calc(60px+72px)] md:grid-cols-[1fr_0.85fr] md:gap-14 md:pt-[calc(60px+112px)]"
      >
        <div>
          {/* The article's own headline is a sentence, and it is the H1
              directly below — repeating it in the crumb would say the same
              thing twice. So the crumb stops at the section and carries the
              reading time, which is a fact about the article rather than
              its place in the tree. */}
          <Breadcrumbs
            ancestors={[{ name: 'Journal', path: '/journal/' }]}
            meta={article.readingTime}
          />
          <h1 class="t-h2 mt-6 max-w-[22ch] text-[2.5rem] md:text-[3.5rem]">{article.headline}</h1>
          <p class="t-body mt-7 text-[1.125rem]">{article.standfirst}</p>
          {article.quickAnswer && (
            <p class="quick-answer t-body mt-7 border-l-2 border-rose pl-6 text-[1.0625rem] font-medium max-w-[62ch]">
              {article.quickAnswer}
            </p>
          )}
          {/* Byline block. Carries the author with credentials, the publish
              date and the last-updated date, so a reader (and an AI system
              reading the markup) can see who wrote it and how current it is. */}
          <div class="mt-8 border-t border-line pt-6">
            <p class="t-meta">
              By <a
                href="/about/"
                class="border-b border-ink/40 hover:border-rose hover:text-rose">{business.ownerName}</a
              >, {business.ownerCredential}
            </p>
            <p class="t-meta mt-2">
              Published <time datetime={article.datePublished}>{formatDate(article.datePublished)}</time>
              <span aria-hidden="true"> · </span>
              Last updated <time datetime={article.dateModified}>{formatDate(article.dateModified)}</time>
            </p>
          </div>
        </div>

        <Image
          src={article.image}
          alt={article.imageAlt}
          widths={[500, 800, 1200]}
          sizes="(min-width: 52.5rem) 45vw, 100vw"
          loading="eager"
          fetchpriority="high"
          class="aspect-[0.85] w-full object-cover object-[35%_35%]"
        />
      </div>
    </header>

    <div class="bg-porcelain">
      <div class="wrap section-y">
        <div class="prose mx-auto max-w-[68ch]">
          {
            article.body.map((block) =>
              'h2' in block ? (
                <h2 class="t-h3 mt-16 first:mt-0">{block.h2}</h2>
              ) : 'h3' in block ? (
                <h3 class="t-service mt-12 text-[1.125rem] md:text-[1.25rem]">{block.h3}</h3>
              ) : 'answer' in block ? (
                <p
                  class="t-body mt-7 border-l-2 border-rose pl-6 text-[1.0625rem] first:mt-0"
                  set:html={block.answer}
                />
              ) : 'table' in block ? (
                <div class="mt-10 overflow-x-auto">
                  <table class="w-full border-collapse text-left">
                    <caption class="t-meta pb-4 text-left">{block.table.caption}</caption>
                    <thead>
                      <tr>
                        {block.table.head.map((cell) => (
                          <th
                            scope="col"
                            class="t-meta border-b border-line py-3 pr-6 align-bottom font-normal last:pr-0"
                          >
                            {cell}
                          </th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {block.table.rows.map((row) => (
                        <tr>
                          {row.map((cell, i) =>
                            i === 0 ? (
                              <th
                                scope="row"
                                class="t-body border-b border-line py-4 pr-6 align-top text-[0.9375rem] font-normal text-ink-soft"
                              >
                                {typeof cell === 'string' ? cell : cell.text}
                              </th>
                            ) : (
                              <td class="t-body border-b border-line py-4 pr-6 align-top text-[0.9375rem] last:pr-0">
                                {typeof cell === 'string' ? (
                                  cell
                                ) : (
                                  <span
                                    data-fact-source={cell.source}
                                    data-fact={cell.fact}
                                    data-fact-value={cell.text}
                                  >
                                    {cell.text}
                                  </span>
                                )}
                              </td>
                            ),
                          )}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              ) : 'ul' in block ? (
                <ul class="mt-8 m-0 list-none space-y-4 p-0">
                  {block.ul.map((item) => (
                    <li class="t-body flex gap-4">
                      <span aria-hidden="true" class="text-rose">
                        —
                      </span>
                      <span set:html={item} />
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="t-body mt-7 first:mt-0" set:html={block.p} />
              ),
            )
          }

          <div class="mt-16 border-t border-line pt-12">
            <p class="t-meta">About the author</p>
            <p class="t-body mt-4">
              Written by <a href="/about/" class="underline hover:text-rose">{business.ownerName}</a>{
                ', '
              }{business.ownerCredential}, with {business.experience} treating melanin-rich skin at
              KIAMO Skin in San Diego.
            </p>
            <div class="mt-7 flex flex-wrap gap-3">
              <Button href={article.cta.href} variant="ghost">{article.cta.label}</Button>
              <Button href={business.bookingUrl} external>{CTA_LABEL}</Button>
            </div>
          </div>
        </div>
      </div>
    </div>

    {
      faqs.length > 0 && (
        <div class="bg-ivory">
          <div class="wrap section-y">
            <p class="t-eyebrow text-ink-soft">Common questions</p>
            <h2 class="t-h2 mt-5">{article.faqHeading ?? 'Hyperpigmentation questions'}</h2>
            <div class="mt-12 max-w-[68ch]">
              {/* The answer may carry a citation link, so it is rendered as
                  HTML rather than as text. */}
              <FaqList faqs={faqs} html />
            </div>
          </div>
        </div>
      )
    }

    {
      others.length > 0 && (
        <div class="bg-blush">
          <div class="wrap section-y">
            <h2 class="t-h3">Also in the journal</h2>
            <ul class="mt-10 m-0 list-none p-0">
              {others.map((other) => (
                <li class="border-b border-line">
                  <a href={`/journal/${other.slug}/`} class="group block py-7">
                    <h3 class="t-service text-[1.0625rem] transition-colors duration-300 group-hover:text-rose md:text-[1.1875rem]">
                      {other.headline}
                    </h3>
                    <p class="t-body mt-2 text-[0.9375rem] text-ink-soft">{other.standfirst}</p>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      )
    }
  </article>
</BaseLayout>
