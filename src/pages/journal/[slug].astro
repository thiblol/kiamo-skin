---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import FaqList from '../../components/FaqList.astro';
import { articles } from '../../data/articles';
import { business, verifiedPrices } from '../../config/business';
import { CTA_LABEL } from '../../config/nav';
import ArticleSchema from '../../components/schema/ArticleSchema.astro';
import BreadcrumbSchema from '../../components/schema/BreadcrumbSchema.astro';
import PageHero from '../../components/PageHero.astro';
import FaqSchema from '../../components/schema/FaqSchema.astro';
import HowToSchema from '../../components/schema/HowToSchema.astro';
import SpeakableSchema from '../../components/schema/SpeakableSchema.astro';
import TrustBadge from '../../components/sections/TrustBadge.astro';
import ProofQuote from '../../components/ProofQuote.astro';
import { testimonials } from '../../data/testimonials';
import { reviewStats } from '../../data/review-stats';

export function getStaticPaths() {
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const others = articles.filter((a) => a.slug !== article.slug);
const faqs = article.faqs ?? [];
const articleUrl = `${Astro.site ?? 'https://kiamoskin.com'}journal/${article.slug}/`;

/**
 * The proof that sits under the byline.
 *
 * The long-running-client quote is the one that carries the most weight on a
 * reading page. A reader who has just read an article about how a plan is
 * built is deciding whether this is a studio that keeps doing the right thing
 * over years, and that is the question a quote from someone four years in
 * answers better than a quote from a first visit.
 */
const proof =
  testimonials.find((t) => t.quote.includes('trust anyone else')) ?? testimonials[0];

/**
 * The second proof point, lower down the page.
 *
 * A different client, so the two quotes say different things: the first is
 * about staying with the studio over years, this one is about the result
 * being visible. Together they cover both of the questions a reader has
 * about a studio they have only read about.
 */
const secondProof =
  testimonials.find((t) => t.quote.includes('Real, visible results')) ?? testimonials[1];

/**
 * Dates render as "Month D, YYYY" without the Date constructor, so the server
 * and the client produce identical text. The byline sits above the article:
 * an author with credentials and a visible last-updated date are the two
 * E-E-A-T signals readers and AI systems look for on a piece like this.
 */
const formatDate = (iso: string): string => {
  const [year, month, day] = iso.split('-');
  const months = [
    'January', 'February', 'March', 'April', 'May', 'June',
    'July', 'August', 'September', 'October', 'November', 'December',
  ];
  return `${months[Number(month) - 1] ?? month} ${Number(day)}, ${year}`;
};
---

<BaseLayout title={article.title} description={article.description} ogType="article" headerTheme="dark">
  <ArticleSchema slot="head" article={article} />
  {faqs.length > 0 && <FaqSchema slot="head" faqs={faqs} />}
  {article.howTo && <HowToSchema slot="head" article={article} />}
  <SpeakableSchema slot="head" url={articleUrl} />
  <BreadcrumbSchema
    slot="head"
    trail={[
      { name: 'Journal', path: '/journal' },
      { name: article.headline, path: `/journal/${article.slug}` },
    ]}
  />
  <article>
    {/* Hero. Same shape as the membership page: copy on the left, the photograph
        beside it rather than across the page, so the image reads as evidence
        instead of as a banner and never competes with the headline. */}
    {/* The hero. The article's own photograph is the background, the copy
        sits over it, and the byline, the dates and the proof are all in
        the first screen. */}
    <PageHero
      eyebrow={`${article.readingTime} · Field notes from the treatment room`}
      h1={article.headline}
      h1Width="24ch"
      paragraph={article.standfirst}
      image={article.image}
      imageAlt={article.imageAlt}
      price={{ label: 'First-time client treatment', price: verifiedPrices['first-time-client'] }}
      trust={[
        { label: `Written by ${business.ownerName}, licensed esthetician` },
        { label: `Last updated ${formatDate(article.dateModified)}` },
        { label: `${reviewStats.count} five-star Google reviews` },
        { label: 'Prices published before you book' },
      ]}
      reassurance={[
        business.visit.appointmentOnly,
        business.visit.parking,
        'Free cancellation up to 48 hours before',
      ]}
      ancestors={[{ name: 'Journal', path: '/journal/' }]}
      current="Note"
      eventLabel="article_hero"
    >
      <Fragment slot="extra">
        {
          article.quickAnswer && (
            <p class="quick-answer t-body mt-6 max-w-[58ch] border-l-2 border-blush pl-6 text-[1.0625rem] font-medium text-porcelain/90">
              {article.quickAnswer}
            </p>
          )
        }

        {/* The byline. The author, the credentials, the publish date and the
            revision date — so a reader, and an AI system reading the markup,
            can see who wrote it and how current it is. */}
        <div class="mt-8 border-t border-porcelain/20 pt-6">
          <p class="t-meta text-porcelain/75">
            By <a
              href="/about/"
              class="border-b border-porcelain/40 transition-colors hover:border-blush hover:text-blush"
              >{business.ownerName}</a
            >, {business.ownerCredential}
          </p>
          <p class="t-meta mt-2 text-porcelain/75">
            Published <time datetime={article.datePublished}>{formatDate(article.datePublished)}</time>
            <span aria-hidden="true"> · </span>
            Last updated <time datetime={article.dateModified}>{formatDate(article.dateModified)}</time>
          </p>
        </div>

        {/* The rating and the count, as visible HTML only. Schema-claimed
            review counts are forbidden on this site, and the figure links to
            the Google listing so a reader can check it. */}
        <div class="mt-6">
          <TrustBadge class="border-porcelain/20 bg-porcelain/[0.06]" />
        </div>
      </Fragment>
    </PageHero>

    <div class="bg-porcelain">
      <div class="wrap section-y">
        <div class="prose mx-auto max-w-[68ch]">
          {
            article.body.map((block) =>
              'h2' in block ? (
                <h2 class="t-h3 mt-16 first:mt-0">{block.h2}</h2>
              ) : 'h3' in block ? (
                <h3 class="t-service mt-12 text-[1.125rem] md:text-[1.25rem]">{block.h3}</h3>
              ) : 'answer' in block ? (
                <p
                  class="t-body mt-7 border-l-2 border-rose pl-6 text-[1.0625rem] first:mt-0"
                  set:html={block.answer}
                />
              ) : 'table' in block ? (
                <div class="mt-10 overflow-x-auto">
                  <table class="w-full border-collapse text-left">
                    <caption class="t-meta pb-4 text-left">{block.table.caption}</caption>
                    <thead>
                      <tr>
                        {block.table.head.map((cell) => (
                          <th
                            scope="col"
                            class="t-meta border-b border-line py-3 pr-6 align-bottom font-normal last:pr-0"
                          >
                            {cell}
                          </th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {block.table.rows.map((row) => (
                        <tr>
                          {row.map((cell, i) =>
                            i === 0 ? (
                              <th
                                scope="row"
                                class="t-body border-b border-line py-4 pr-6 align-top text-[0.9375rem] font-normal text-ink-soft"
                              >
                                {typeof cell === 'string' ? cell : cell.text}
                              </th>
                            ) : (
                              <td class="t-body border-b border-line py-4 pr-6 align-top text-[0.9375rem] last:pr-0">
                                {typeof cell === 'string' ? (
                                  cell
                                ) : (
                                  <span
                                    data-fact-source={cell.source}
                                    data-fact={cell.fact}
                                    data-fact-value={cell.text}
                                  >
                                    {cell.text}
                                  </span>
                                )}
                              </td>
                            ),
                          )}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              ) : 'ul' in block ? (
                <ul class="mt-8 m-0 list-none space-y-4 p-0">
                  {block.ul.map((item) => (
                    <li class="t-body flex gap-4">
                      <span aria-hidden="true" class="text-rose">
                        —
                      </span>
                      <span set:html={item} />
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="t-body mt-7 first:mt-0" set:html={block.p} />
              ),
            )
          }

          {/* The contextual CTA, placed at the natural stopping point.
              The article answers a question; the question is what a reader
              came with; the next step is the consultation that turns the
              answer into a plan for their skin. Putting it here — after the
              reader has been given something real — is the point at which it
              is worth clicking, which is not the same as the point at which
              it is easiest to place. */}
          <div class="mt-16 border-y border-line py-10">
            <div class="max-w-[58ch]">
              <p class="t-eyebrow text-ink-soft">Where this leaves you</p>
              <p class="t-body mt-4">
                A first visit is {verifiedPrices['first-time-client']} and includes the consultation
                and skin analysis that turns any of this into a plan for your skin.
              </p>
              <p class="t-body mt-3">
                Prices are published, the studio is appointment-only, and parking is free.
              </p>
              <div class="mt-7 flex flex-wrap items-center gap-x-8 gap-y-4">
                <Button href={business.bookingUrl} external trackEvent="booking_click">
                  {CTA_LABEL}
                </Button>
                <a
                  href={business.phone.href}
                  class="t-body border-b border-ink pb-1 hover:border-rose hover:text-rose"
                >
                  {business.phone.display}
                </a>
              </div>
            </div>
          </div>

          <div class="mt-16 border-t border-line pt-12">
            <p class="t-meta">About the author</p>
            <p class="t-body mt-4">
              Written by <a href="/about/" class="underline hover:text-rose">{business.ownerName}</a>{
                ', '
              }{business.ownerCredential}, with {business.experience} treating melanin-rich skin at
              KIAMO Skin in San Diego.
            </p>
            <div class="mt-7 flex flex-wrap gap-3">
              <Button href={article.cta.href} variant="ghost">{article.cta.label}</Button>
              <Button href={business.bookingUrl} external>{CTA_LABEL}</Button>
            </div>
          </div>
        </div>
      </div>
    </div>

    {
      faqs.length > 0 && (
        <div class="bg-ivory">
          <div class="wrap section-y">
            <p class="t-eyebrow text-ink-soft">Common questions</p>
            <h2 class="t-h2 mt-5">{article.faqHeading ?? 'Hyperpigmentation questions'}</h2>
            <div class="mt-12 max-w-[68ch]">
              {/* The answer may carry a citation link, so it is rendered as
                  HTML rather than as text.

                  The first three answers start open. These are SEO pages as
                  well as reading pages, and a collapsed answer is an answer
                  that is not indexed or surfaced — which is why the homepage
                  already opens its first three for the same reason. The
                  answers stay in the DOM and in the schema either way. */}
              <FaqList faqs={faqs} html openFirst={3} />
            </div>
            {/* Trust again, near the end.
                Trust has to repeat. A reader who scrolled the whole way down
                to the questions is about to make a decision, and the decision
                is whether to trust a studio they have only read about. The
                count and the rating sitting here, next to the questions and
                above the final CTA, are the last thing they meet. */}
            <div class="mt-14 grid gap-8 border-t border-line pt-10 md:grid-cols-[auto_1fr] md:gap-12">
              <TrustBadge class="md:w-[20rem] md:shrink-0" />
              <ProofQuote testimonial={secondProof} />
            </div>
          </div>
        </div>
      )
    }

    {
      others.length > 0 && (
        <div class="bg-blush">
          <div class="wrap section-y">
            <h2 class="t-h3">Also in the journal</h2>
            <ul class="mt-10 m-0 list-none p-0">
              {others.map((other) => (
                <li class="border-b border-line">
                  <a href={`/journal/${other.slug}/`} class="group block py-7">
                    <h3 class="t-service text-[1.0625rem] transition-colors duration-300 group-hover:text-rose md:text-[1.1875rem]">
                      {other.headline}
                    </h3>
                    <p class="t-body mt-2 text-[0.9375rem] text-ink-soft">{other.standfirst}</p>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      )
    }
  </article>
</BaseLayout>
