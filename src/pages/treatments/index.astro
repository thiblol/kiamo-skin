---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceMenu from '../../components/sections/ServiceMenu.astro';
import Reveal from '../../components/Reveal.astro';
import PanelWipe from '../../components/PanelWipe.astro';
import FaqLocation from '../../components/sections/FaqLocation.astro';
import CollectionSchema from '../../components/schema/CollectionSchema.astro';
import BreadcrumbSchema from '../../components/schema/BreadcrumbSchema.astro';
import { treatments } from '../../data/treatments';
---

<BaseLayout
  title="Skin & Scalp Treatments in San Diego | KIAMO Skin"
  description="Corrective facials, DMK enzyme therapy, Procell microchanneling, Lira peels, dermaplaning and Keravive scalp therapy in Mission Hills, San Diego."
>
  <CollectionSchema
    slot="head"
    name="Skin & Scalp Treatments in San Diego"
    description="The full corrective treatment menu at KIAMO SKIN in Mission Hills, San Diego — facials, scalp therapy, enzyme therapy, microchanneling, peels and dermaplaning."
    items={treatments.map((treatment) => ({
      name: treatment.name,
      path: `/treatments/${treatment.slug}`,
    }))}
  />
  <BreadcrumbSchema slot="head" trail={[{ name: 'Treatments', path: '/treatments' }]} />
  <header class="bg-blush">
    <div class="wrap section-y pt-[calc(60px+72px)] md:pt-[calc(60px+112px)]">
      <p class="t-eyebrow text-ink-soft">Treatments</p>
      <h1 class="t-h2 mt-6 max-w-[22ch] text-[2.5rem] md:text-[4rem]">
        Every step has a purpose.
      </h1>
      <p class="t-body mt-7 max-w-[62ch]">
        At KIAMO, we don’t believe the most aggressive treatment is always the best treatment.
        Healthy skin is built through consistency, not constantly switching modalities — which is
        why most plans here run on a <a
          href="/membership"
          class="border-b border-ink pb-0.5 hover:border-rose hover:text-rose"
          >monthly facial membership in San Diego</a
        > rather than one appointment at a time.
      </p>
      <p class="t-body mt-5 max-w-[62ch]">
        HydraFacial serves as the foundation of many of our treatment plans, helping restore and
        maintain healthy skin over time. As your skin changes, advanced corrective treatments such
        as Procell Microchanneling, DMK Enzyme Therapy, chemical peels, or Keravive may be
        introduced when they’re appropriate — not simply because they’re available.
      </p>
      <p class="t-body mt-5 max-w-[62ch]">
        Every recommendation is based on what your skin needs today, while keeping your long-term
        goals in mind. Protocols are selected to support all skin tones, with specialised
        experience in <a
          href="/melanin-rich-skin"
          class="border-b border-ink pb-0.5 hover:border-rose hover:text-rose"
          >corrective treatment for melanin-rich skin</a
        >.
      </p>
    </div>
  </header>

  <section class="bg-porcelain">
    <div class="wrap section-y">
      <ul class="m-0 grid list-none gap-x-8 gap-y-14 p-0 md:grid-cols-3">
        {
          treatments.map((treatment, i) => (
            <Reveal as="li">
              <a href={`/treatments/${treatment.slug}`} class="group block">
                <PanelWipe from={i % 2 === 0 ? 'left' : 'right'} class="aspect-4/3">
                  <Image
                    src={treatment.image}
                    alt={treatment.imageAlt}
                    widths={[400, 800, 1200]}
                    sizes="(min-width: 840px) 30vw, 90vw"
                    loading="lazy"
                    class="size-full object-cover transition-transform duration-[1500ms] ease-out group-hover:scale-105"
                  />
                </PanelWipe>
                <h2 class="t-service mt-6 text-[1.125rem] transition-colors duration-300 group-hover:text-rose">
                  {treatment.name} in San Diego
                </h2>
                <p class="t-body mt-3 text-[0.9375rem] text-ink-soft">{treatment.headline}</p>
              </a>
            </Reveal>
          ))
        }
      </ul>

      <p class="t-body mt-14 text-[0.9375rem]">
        <a href="/service-areas" class="border-b border-ink pb-1 hover:border-rose hover:text-rose">
          See the areas we serve across San Diego County
        </a>
      </p>
    </div>
  </section>

  <ServiceMenu />
  <FaqLocation />
</BaseLayout>
