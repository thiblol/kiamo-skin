---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceMenu from '../../components/sections/ServiceMenu.astro';
import Reveal from '../../components/Reveal.astro';
import PanelWipe from '../../components/PanelWipe.astro';
import FaqLocation from '../../components/sections/FaqLocation.astro';
import CollectionSchema from '../../components/schema/CollectionSchema.astro';
import BreadcrumbSchema from '../../components/schema/BreadcrumbSchema.astro';
import { treatments } from '../../data/treatments';
import { treatmentTrust, studioProof } from '../../data/treatment-trust';
import { business } from '../../config/business';
import { CTA_LABEL } from '../../config/nav';
import Button from '../../components/Button.astro';
import TrustBar from '../../components/TrustBar.astro';
import ProofQuote from '../../components/ProofQuote.astro';
import QuickAnswer from '../../components/QuickAnswer.astro';
import SpeakableSchema from '../../components/schema/SpeakableSchema.astro';
---

<BaseLayout
  title="Corrective Skin Treatments in San Diego | KIAMO Skin"
  description="Corrective facials, scalp therapy, and advanced treatments in Mission Hills. HydraFacial, peels, microchanneling, enzyme therapy. Licensed esthetician."
>
  <SpeakableSchema slot="head" url={Astro.site ? new URL(Astro.site).origin + Astro.url.pathname : Astro.url.pathname} />
  <CollectionSchema
    slot="head"
    name="Skin & Scalp Treatments in San Diego"
    description="The full corrective treatment menu at KIAMO Skin in Mission Hills, San Diego — facials, scalp therapy, enzyme therapy, microchanneling, peels and dermaplaning."
    items={treatments.map((treatment) => ({
      name: treatment.name,
      path: `/treatments/${treatment.slug}`,
    }))}
  />
  <BreadcrumbSchema slot="head" trail={[{ name: 'Treatments', path: '/treatments' }]} />
  <header class="bg-blush">
    <div class="wrap pt-[calc(60px+40px)] pb-16 md:pt-[calc(60px+64px)] md:pb-24">
      <p class="t-eyebrow text-ink-soft">Treatments</p>
      <h1 class="t-h2 mt-6 max-w-[24ch] text-[2.25rem] md:text-[3.5rem]">
        Corrective Skin &amp; Scalp Treatments in San Diego — For Pigmentation, Acne, and Scalp
      </h1>
      {/* The deck line. It leads with what the menu contains — the thing
          that is different about this studio — and closes with the
          credential, so the H1 can carry service, city, and benefit without
          the hero repeating itself. */}
      <p class="t-body mt-7 max-w-[62ch]">
        HydraFacial, peels, microchanneling, enzyme therapy, and scalp work — each one selected
        for the skin in front of you rather than for the treatment that is trending. Performed by
        Kiki, a California licensed esthetician with {business.experience} in corrective skin.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-x-8 gap-y-4">
        <Button href={business.bookingUrl} external>{CTA_LABEL}</Button>
        <a
          href={business.phone.href}
          class="t-body border-b border-ink pb-1 hover:border-rose hover:text-rose"
        >
          {business.phone.display}
        </a>
      </div>
    </div>
  </header>

    {/* The trust band. It sits directly below the hero as its own strip
        rather than inside it - the hero is the offer, and the claims are
        the reason to believe it. Keeping them apart is also what lets the
        hero fit the fold. */}
    <section class="bg-porcelain py-12 md:py-14">
      <div class="wrap">
        <TrustBar items={treatmentTrust['corrective-skin-treatments'].claims} heading="Why this studio" />
        {/* A client's words, directly under the studio's own claims. The
            claims are the studio asserting things about itself; this is
            somebody else saying it, and it belongs high on the page. */}
        <div class="mt-10 border-t border-line pt-9 md:mt-12 md:pt-10">
          <ProofQuote testimonial={studioProof} />
        </div>
      </div>
    </section>

  <section class="bg-porcelain">
    <div class="wrap section-y">
      {/* The longer explanation of how the menu works. It sits above the
          menu rather than in the hero, so the hero stays the offer, the
          subhead, and the CTA — and the whole thing fits the fold. */}
      <p class="t-body mb-14 max-w-[62ch]">
        HydraFacial serves as the foundation of many plans. As your skin changes, advanced
        corrective treatments such as Procell Microchanneling, DMK Enzyme Therapy, chemical peels,
        or Keravive may be introduced when they are appropriate — not simply because they are
        available. Protocols are selected to support all skin tones, and Kiki's training in
        treating pigmentation in deeper skin means clients with any skin tone receive the safest,
        most effective care—whether you're addressing <a
          href="/treatments/melasma/"
          class="border-b border-ink/40 hover:border-rose hover:text-rose"
          >melasma, post-inflammatory hyperpigmentation</a
        >, or uneven texture.
      </p>

      {/* The quick answer an AI engine lifts. It sits above the menu because
          it is the capsule version of the page: what this studio does, where,
          and the fact that decides the treatment. */}
      <QuickAnswer
        content={treatmentTrust['corrective-skin-treatments'].quickAnswer}
        class="mb-14 max-w-[68ch]"
      />
      <ul class="m-0 grid list-none gap-x-8 gap-y-14 p-0 md:grid-cols-3">
        {
          treatments.map((treatment, i) => (
            <Reveal as="li">
              <a href={`/treatments/${treatment.slug}/`} class="group block">
                <PanelWipe from={i % 2 === 0 ? 'left' : 'right'} class="aspect-4/3">
                  <Image
                    src={treatment.image}
                    alt={treatment.imageAlt}
                    widths={[400, 800, 1200]}
                    sizes="(min-width: 840px) 30vw, 90vw"
                    loading="lazy"
                    class="size-full object-cover transition-transform duration-[1500ms] ease-out group-hover:scale-105"
                  />
                </PanelWipe>
                <h2 class="t-service mt-6 text-[1.125rem] transition-colors duration-300 group-hover:text-rose">
                  {treatment.name} in San Diego
                </h2>
                <p class="t-body mt-3 text-[0.9375rem] text-ink-soft">{treatment.headline}</p>
              </a>
            </Reveal>
          ))
        }
      </ul>

      <p class="t-body mt-14 text-[0.9375rem]">
        See{' '}
        <a href="/hydrafacial/" class="border-b border-ink pb-1 hover:border-rose hover:text-rose">
          HydraFacial across San Diego neighborhoods
        </a>
        {' '}and{' '}
        <a href="/hyperpigmentation-treatment/" class="border-b border-ink pb-1 hover:border-rose hover:text-rose">
          hyperpigmentation treatment across San Diego
        </a>{' '}
        for area-specific booking pages.
      </p>
      <p class="t-body mt-5 text-[0.9375rem]">
        <a href="/service-areas/" class="border-b border-ink pb-1 hover:border-rose hover:text-rose">
          See the areas we serve across San Diego County
        </a>
      </p>
    </div>
  </section>

  <ServiceMenu />
  <FaqLocation />
</BaseLayout>
