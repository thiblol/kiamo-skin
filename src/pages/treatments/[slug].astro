---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Reveal from '../../components/Reveal.astro';
import Button from '../../components/Button.astro';
import NapBlock from '../../components/NapBlock.astro';
import CertificateModal from '../../components/CertificateModal.astro';
import { treatments } from '../../data/treatments';
import { treatmentFaqs } from '../../data/treatment-faqs';
import { areas } from '../../data/areas';
import { business } from '../../config/business';
import { CTA_LABEL } from '../../config/nav';
import ServiceSchema from '../../components/schema/ServiceSchema.astro';
import BreadcrumbSchema from '../../components/schema/BreadcrumbSchema.astro';
import FaqSchema from '../../components/schema/FaqSchema.astro';
import TreatmentAreaSchema from '../../components/schema/TreatmentAreaSchema.astro';
import PersonSchema from '../../components/schema/PersonSchema.astro';

export function getStaticPaths() {
  return treatments.map((treatment) => ({
    params: { slug: treatment.slug },
    props: { treatment },
  }));
}

const { treatment } = Astro.props;
const others = treatments.filter((t) => t.slug !== treatment.slug);
const faqs = treatmentFaqs[treatment.slug] ?? [];
const localAreas = treatment.areas
  .map((slug) => areas.find((a) => a.slug === slug))
  .filter((a) => a !== undefined);
---

<BaseLayout title={treatment.title} description={treatment.description}>
  <ServiceSchema slot="head" treatment={treatment} />
  <BreadcrumbSchema
    slot="head"
    trail={[
      { name: 'Treatments', path: '/treatments' },
      { name: treatment.name, path: `/treatments/${treatment.slug}` },
    ]}
  />
  {faqs.length > 0 && <FaqSchema slot="head" faqs={faqs} />}
  <TreatmentAreaSchema slot="head" treatment={treatment} />
  <PersonSchema slot="head" />

  <article>
    <header class="bg-blush">
      <div class="wrap section-y pt-[calc(60px+72px)] md:pt-[calc(60px+112px)]">
        <div class="grid gap-12 md:grid-cols-2 md:gap-16 lg:gap-20">
          <div>
            <p class="t-eyebrow text-ink-soft">
              <a href="/treatments/" class="hover:text-rose">Treatments</a> · {treatment.name}
            </p>
            <h1 class="t-h2 mt-6 max-w-[24ch] text-[2.5rem] md:text-[4rem]">{treatment.headline}</h1>
            {/* set:html so an opener can carry an inline link on the claim it supports,
                the same way `articles.ts` renders `p` and `ul`. Authored content only. */}
            <p class="t-body mt-7 max-w-[62ch] text-[1.125rem]" set:html={treatment.opener} />
            <p class="t-body mt-5 max-w-[62ch]" set:html={treatment.intro} />
            <div class="mt-9 flex flex-wrap items-center gap-x-8 gap-y-4">
              <Button href={business.bookingUrl} external>{CTA_LABEL}</Button>
              <a href={business.phone.href} class="t-body border-b border-ink pb-1 hover:border-rose hover:text-rose">
                {business.phone.display}
              </a>
            </div>
            <p class="t-body mt-6 text-[0.875rem] text-ink-soft">
              Licensed Esthetician · {business.ownerCredential.split(',')[0]} · {business.experience} experience · One-to-one, private studio
            </p>
          </div>

          <div class="flex flex-col gap-6">
            <Image
              src={treatment.image}
              alt={treatment.imageAlt}
              widths={[640, 1280]}
              sizes="(min-width: 768px) 50vw, 100vw"
              loading="eager"
              class="aspect-4/3 w-full rounded-lg object-cover"
            />
            <div class="flex justify-center md:justify-start">
              <Button href={business.bookingUrl} external>{CTA_LABEL}</Button>
            </div>
          </div>
        </div>
      </div>
    </header>

    <div class="bg-ivory">
      <div class="wrap py-12">
        <div class="prose-treatment max-w-[68ch]">
          <p class="t-body text-[0.9375rem] text-ink-soft">
            KIAMO Skin is equipped with HydraFacial Syndeo (the latest generation HydraFacial device with AI-powered skin analysis), Procell Therapies microchanneling system, DMK enzyme protocols developed by Danné Montague-King, LIRA Clinical professional-grade chemical peels, and Keravive scalp therapy using HydraFacial's proprietary peptide complex. These are not consumer devices adapted for professional use — they are clinical-grade systems designed for corrective outcomes.
          </p>
          <p class="t-body mt-4 text-[0.9375rem] text-ink-soft">
            Kiki is a California licensed esthetician (Board of Barbering & Cosmetology) with 7+ years of experience. Training certifications include HydraFacial Syndeo advanced protocols, Procell Therapies microchanneling, DMK enzyme therapy Level 1-3, LIRA Clinical professional peels, and Keravive scalp therapy. Every treatment is performed by Kiki — not delegated to junior staff or rotating providers.
          </p>

          <div class="mt-8 pt-6 border-t border-line">
            <p class="t-body text-[0.875rem] text-ink-soft mb-4">Advanced certifications — click to view:</p>
            <div class="flex gap-6">
              <CertificateModal
                id="cert-hydrafacial-treatment"
                image="/images/hydrafacial-certified-provider-san-diego.jpg"
                alt="HydraFacial Certified Provider certificate - KIAMO Skin, San Diego California"
                title="HydraFacial Certified Provider"
              />
              <CertificateModal
                id="cert-dmk-treatment"
                image="/images/dmk-certified-skin-therapist-kiki-kiamo.jpg"
                alt="DMK Certified Skin Therapist certificate - Kiki, KIAMO Skin San Diego"
                title="DMK Certified Skin Therapist"
              />
            </div>
          </div>
        </div>
      </div>
    </div>

    {localAreas.length > 0 && (
      <div class="bg-ivory">
        <div class="wrap py-8">
          <p class="t-body max-w-[68ch] text-[0.9375rem] text-ink-soft">
            {treatment.name} is performed at the Mission Hills studio. Clients travel from <a href="/service-areas/" class="border-b border-ink/40 hover:border-rose hover:text-rose">across San Diego County</a> — from nearby neighborhoods like North Park and Hillcrest to coastal areas including La Jolla, Pacific Beach and Encinitas, and inland communities like Chula Vista and La Mesa.
          </p>
        </div>
      </div>
    )}

    {treatment.slug === 'procell-microchanneling' && (
      <section class="bg-ivory py-20 md:py-28">
        <div class="wrap">
          <Reveal>
            <p class="t-eyebrow text-ink-soft">Best microneedling in San Diego</p>
            <h2 class="t-h2 mt-4 max-w-[36ch]">
              Why KIAMO is the best microneedling choice in San Diego for Black and brown skin
            </h2>
            <p class="t-body mt-7 max-w-[62ch] leading-relaxed">
              Procell microchanneling at this studio is performed by Kiki, a California licensed esthetician with 7+ years treating the most complex pigmentation cases: melanin-rich skin, where the margin for error on any resurfacing treatment is smallest. Training covers Procell Therapies advanced protocols, HydraFacial Syndeo certification, DMK enzyme therapy Level 1–3, and Lira Clinical professional peels. These are clinical-grade systems designed for corrective outcomes — not consumer devices adapted for professional use.
            </p>
            <p class="t-body mt-6 max-w-[62ch] leading-relaxed">
              Every Procell session is one-to-one in a single private treatment room at 3067 Reynard Way. There is no rotating staff, no franchise schedule, and no protocol lifted from a national template. Treatment depth on melanin-rich skin is not set uniformly across the face — it varies by region depending on skin thickness, tone, and the concern being treated. Procell's proprietary stem cytokine growth factor serums are applied directly into the open channels in the same pass. This is the work the protocol was built around.
            </p>
            <p class="t-body mt-6 max-w-[62ch] leading-relaxed">
              Other San Diego microneedling providers use RF devices — Morpheus8, Vivace, Potenza — which combine needle penetration with radiofrequency heat. In melanin-rich skin, that heat activates melanocytes and can trigger post-inflammatory hyperpigmentation: more dark marks, not fewer. Procell microchanneling works mechanically, with no thermal component. The inflammatory trigger is controlled and predictable. The growth factor serum delivered in the same pass directs cellular response toward collagen synthesis and pigment correction rather than leaving healing to chance.
            </p>

            <ul class="m-0 mt-10 grid list-none gap-4 p-0 md:grid-cols-2">
              <li class="border border-line bg-porcelain p-6">
                <p class="t-service text-[1rem]">Procell Therapies advanced protocols — certified</p>
              </li>
              <li class="border border-line bg-porcelain p-6">
                <p class="t-service text-[1rem]">Depth adjusted region by region, not uniform across the face</p>
              </li>
              <li class="border border-line bg-porcelain p-6">
                <p class="t-service text-[1rem]">Stem cytokine growth factor serums delivered in the same pass</p>
              </li>
              <li class="border border-line bg-porcelain p-6">
                <p class="t-service text-[1rem]">7+ years treating melanin-rich skin, where the margin for error is smallest</p>
              </li>
            </ul>
          </Reveal>
        </div>
      </section>
    )}

    <div class="bg-porcelain">
      <div class="wrap section-y grid gap-16 md:grid-cols-[1fr_0.7fr] md:gap-20">
        <div>
          <Reveal>
            <h2 class="t-h3">What happens in the room</h2>
            <ol class="mt-9 m-0 list-none space-y-9 p-0">
              {
                treatment.steps.map((step, i) => (
                  <li class="border-t border-line pt-7">
                    <p class="t-meta text-rose">{String(i + 1).padStart(2, '0')}</p>
                    <h3 class="t-service mt-3 text-[1.125rem] md:text-[1.3125rem]">{step.title}</h3>
                    <p class="t-body mt-3 text-[0.9375rem]">{step.body}</p>
                  </li>
                ))
              }
            </ol>
          </Reveal>

          <Reveal class="mt-20 block">
            <h2 class="t-h3">Ideal for</h2>
            <ul class="mt-8 m-0 list-none space-y-4 p-0">
              {
                treatment.goodFor.map((item) => (
                  <li class="t-body flex gap-4 text-[0.9375rem]">
                    <span aria-hidden="true" class="text-rose">
                      —
                    </span>
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>
          </Reveal>

          {treatment.slug === 'procell-microchanneling' && (
            <Reveal class="mt-20 block">
              <p class="t-eyebrow text-ink-soft">Types of microneedling</p>
              <h2 class="t-h3 mt-4">Three types of microneedling — and why this studio chose Procell</h2>
              <p class="t-body mt-7 max-w-[62ch] leading-relaxed">
                San Diego microneedling providers use one of three approaches, and the choice matters on melanin-rich skin. Here is the comparison, the safety profile, and why this studio runs Procell.
              </p>

              <div class="mt-10 overflow-x-auto">
                <table class="w-full border-collapse text-left">
                  <thead>
                    <tr class="border-b-2 border-line">
                      <th class="t-service py-4 pr-4 text-[1rem]">Modality</th>
                      <th class="t-service py-4 pr-4 text-[1rem]">Mechanism</th>
                      <th class="t-service py-4 pr-4 text-[1rem]">Suitability for melanin-rich skin (Fitzpatrick IV–VI)</th>
                      <th class="t-service py-4 text-[1rem]">KIAMO offers</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr class="border-b border-line align-top">
                      <td class="t-service py-5 pr-4 text-[0.9375rem]">RF microneedling<br /><span class="t-body text-[0.8125rem] font-normal text-ink-soft">(Morpheus8, Vivace, Potenza)</span></td>
                      <td class="t-body py-5 pr-4 text-[0.9375rem]">Needle penetration + radiofrequency heat energy</td>
                      <td class="t-body py-5 pr-4 text-[0.9375rem]">Heat is itself a pigment trigger. Thermal trauma in Fitzpatrick IV–VI can produce post-inflammatory hyperpigmentation.</td>
                      <td class="t-body py-5 text-[0.9375rem]">No</td>
                    </tr>
                    <tr class="border-b border-line align-top">
                      <td class="t-service py-5 pr-4 text-[0.9375rem]">PRP microneedling</td>
                      <td class="t-body py-5 pr-4 text-[0.9375rem]">Needles + platelet-rich plasma spun from the client's own blood</td>
                      <td class="t-body py-5 pr-4 text-[0.9375rem]">Mechanical delivery, but platelet concentration varies by donor and the published evidence on pigment correction is thinner than the marketing suggests.</td>
                      <td class="t-body py-5 text-[0.9375rem]">No</td>
                    </tr>
                    <tr class="align-top">
                      <td class="t-service py-5 pr-4 text-[0.9375rem]">Procell microchanneling</td>
                      <td class="t-body py-5 pr-4 text-[0.9375rem]">Mechanical channels + stem cytokine growth factor serums delivered in the same pass</td>
                      <td class="t-body py-5 pr-4 text-[0.9375rem]">No heat. No thermal component. Inflammatory trigger is controlled and predictable. Growth factors direct repair toward collagen and pigment correction.</td>
                      <td class="t-body py-5 text-[0.9375rem]">Yes</td>
                    </tr>
                  </tbody>
                </table>
              </div>

              <p class="t-body mt-10 max-w-[62ch] leading-relaxed">
                Procell Therapies' microchanneling handpiece creates thousands of microscopic channels using a precision-engineered tip. The proprietary stem cytokine serums are applied directly into the open channels in the same pass — communicating with skin cells to direct the repair process toward collagen synthesis, elastin remodeling, and controlled pigment correction. Faster recovery than conventional microneedling with PRP, more predictable than PRP across clients, safer than RF on melanin-rich skin — that is the reasoning behind the choice.
              </p>
            </Reveal>
          )}

          {treatment.slug === 'lira-peels' && (
            <Reveal class="mt-20 block">
              <p class="t-eyebrow text-ink-soft">Types of professional peels</p>
              <h2 class="t-h3 mt-4">Types of professional peels — and why this studio runs Lira</h2>
              <p class="t-body mt-7 max-w-[62ch] leading-relaxed">
                Not all professional peels work the same on melanin-rich skin. Here is what the four most common peel families actually do, and why Lira Clinical is the only line carried at KIAMO SKIN.
              </p>

              <div class="mt-10 overflow-x-auto">
                <table class="w-full border-collapse text-left">
                  <thead>
                    <tr class="border-b-2 border-line">
                      <th class="t-service py-4 pr-4 text-[1rem]">Peel family</th>
                      <th class="t-service py-4 pr-4 text-[1rem]">Mechanism</th>
                      <th class="t-service py-4 pr-4 text-[1rem]">Suitability for melanin-rich skin (Fitzpatrick IV–VI)</th>
                      <th class="t-service py-4 text-[1rem]">KIAMO offers</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr class="border-b border-line align-top">
                      <td class="t-service py-5 pr-4 text-[0.9375rem]">Glycolic (AHA)</td>
                      <td class="t-body py-5 pr-4 text-[0.9375rem]">Water-soluble acid, surface exfoliation</td>
                      <td class="t-body py-5 pr-4 text-[0.9375rem]">Safe at low strength; risks post-inflammatory hyperpigmentation at higher strengths on Fitzpatrick IV–VI.</td>
                      <td class="t-body py-5 text-[0.9375rem]">No</td>
                    </tr>
                    <tr class="border-b border-line align-top">
                      <td class="t-service py-5 pr-4 text-[0.9375rem]">TCA (trichloroacetic acid)</td>
                      <td class="t-body py-5 pr-4 text-[0.9375rem]">Medium-depth, protein coagulation</td>
                      <td class="t-body py-5 pr-4 text-[0.9375rem]">Risky on melanin-rich skin. Inflammatory response can produce post-inflammatory hyperpigmentation.</td>
                      <td class="t-body py-5 text-[0.9375rem]">No</td>
                    </tr>
                    <tr class="border-b border-line align-top">
                      <td class="t-service py-5 pr-4 text-[0.9375rem]">Jessner</td>
                      <td class="t-body py-5 pr-4 text-[0.9375rem]">Lactic + salicylic + resorcinol, layered</td>
                      <td class="t-body py-5 pr-4 text-[0.9375rem]">Moderate depth, requires careful layering and patch testing on melanin-rich skin.</td>
                      <td class="t-body py-5 text-[0.9375rem]">No</td>
                    </tr>
                    <tr class="align-top">
                      <td class="t-service py-5 pr-4 text-[0.9375rem]">Lira Clinical</td>
                      <td class="t-body py-5 pr-4 text-[0.9375rem]">Enzyme + acid blend, paced escalation across a series</td>
                      <td class="t-body py-5 pr-4 text-[0.9375rem]">Yes — strength escalates only as the skin tolerates it; formulated specifically for darker skin tones.</td>
                      <td class="t-body py-5 text-[0.9375rem]">Yes — Gentle Renewal $199, Advanced $299</td>
                    </tr>
                  </tbody>
                </table>
              </div>

              <p class="t-body mt-10 max-w-[62ch] leading-relaxed">
                Lira Clinical is built around the challenge of treating pigmentation without triggering the inflammation that causes more pigmentation. Each peel is layered and timed to the skin's response on the day, not to a fixed protocol. Strength escalates across a series — never in one visit. The home routine between visits is doing as much work as the peel itself.
              </p>
            </Reveal>
          )}

          {treatment.slug === 'dermaplaning' && (
            <Reveal class="mt-20 block">
              <p class="t-eyebrow text-ink-soft">Types of exfoliation</p>
              <h2 class="t-h3 mt-4">Physical vs chemical vs enzyme exfoliation — where dermaplaning fits</h2>
              <p class="t-body mt-7 max-w-[62ch] leading-relaxed">
                Dermaplaning is one of three exfoliation families offered at KIAMO SKIN. Here is the honest comparison against the other two, and where each one wins.
              </p>

              <div class="mt-10 overflow-x-auto">
                <table class="w-full border-collapse text-left">
                  <thead>
                    <tr class="border-b-2 border-line">
                      <th class="t-service py-4 pr-4 text-[1rem]">Exfoliation family</th>
                      <th class="t-service py-4 pr-4 text-[1rem]">Mechanism</th>
                      <th class="t-service py-4 pr-4 text-[1rem]">Best for</th>
                      <th class="t-service py-4 pr-4 text-[1rem]">KIAMO offers</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr class="border-b border-line align-top">
                      <td class="t-service py-5 pr-4 text-[0.9375rem]">Dermaplaning (physical)</td>
                      <td class="t-body py-5 pr-4 text-[0.9375rem]">Sterile surgical blade removes the surface layer of dead skin plus vellus hair</td>
                      <td class="t-body py-5 pr-4 text-[0.9375rem]">Surface dullness, pre-event glow, vellus hair, makeup base</td>
                      <td class="t-body py-5 text-[0.9375rem]">Yes — $199</td>
                    </tr>
                    <tr class="border-b border-line align-top">
                      <td class="t-service py-5 pr-4 text-[0.9375rem]">Chemical peel (acid)</td>
                      <td class="t-body py-5 pr-4 text-[0.9375rem]">Acid-driven cellular turnover across the epidermis</td>
                      <td class="t-body py-5 pr-4 text-[0.9375rem]">Melasma, post-inflammatory hyperpigmentation, sun damage, scarring</td>
                      <td class="t-body py-5 text-[0.9375rem]">Yes — Lira only, $199–$299</td>
                    </tr>
                    <tr class="align-top">
                      <td class="t-service py-5 pr-4 text-[0.9375rem]">Enzyme (protein dissolution)</td>
                      <td class="t-body py-5 pr-4 text-[0.9375rem]">Enzymes dissolve the protein bonds holding dead cells together</td>
                      <td class="t-body py-5 pr-4 text-[0.9375rem]">Sensitive, reactive, or barrier-compromised skin that cannot tolerate a peel</td>
                      <td class="t-body py-5 text-[0.9375rem]">Yes — DMK Enzyme Therapy from $279</td>
                    </tr>
                  </tbody>
                </table>
              </div>

              <p class="t-body mt-10 max-w-[62ch] leading-relaxed">
                Dermaplaning is surface work only — it does not address pigmentation, scarring, or barrier damage, because it never reaches the cellular layer where those conditions live. For those concerns, a Lira peel or DMK Enzyme Therapy is the right tool. The honest recommendation depends on what the skin actually needs, not what the studio most needs to sell.
              </p>
            </Reveal>
          )}
        </div>

        <aside>
          <div class="border border-line bg-ivory p-8">
            <h2 class="t-eyebrow text-ink-soft">Pricing in San Diego</h2>
            <dl class="mt-7 m-0 space-y-6">
              {
                treatment.pricing.map((row) => (
                  <div class="border-b border-line pb-6 last:border-0 last:pb-0">
                    <dt class="t-service text-[1rem]">{row.label}</dt>
                    <dd class="t-price m-0 mt-2">{row.price}</dd>
                    {
                      row.description && (
                        <dd class="t-body m-0 mt-3 text-[0.875rem] text-ink-soft">{row.description}</dd>
                      )
                    }
                  </div>
                ))
              }
            </dl>

            {treatment.note && <p class="t-body mt-7 text-[0.875rem] text-ink-soft">{treatment.note}</p>}

            {
              treatment.melaninNote && (
                <p class="t-body mt-5 text-[0.875rem] text-ink-soft">
                  {treatment.melaninNote}{' '}
                  <a href="/melanin-rich-skin/" class="border-b border-ink/40 hover:border-rose hover:text-rose">
                    Facials for melanin-rich skin in San Diego
                  </a>
                  .
                </p>
              )
            }

            {
              treatment.guide && (
                <p class="t-body mt-5 text-[0.875rem] text-ink-soft">
                  {treatment.guide.lead}{' '}
                  <a
                    href={treatment.guide.href}
                    class="border-b border-ink/40 hover:border-rose hover:text-rose"
                  >
                    {treatment.guide.label}
                  </a>
                  .
                </p>
              )
            }

            {
              treatment.membershipNote && (
                <p class="t-body mt-5 text-[0.875rem] text-ink-soft">
                  {treatment.membershipNote}{' '}
                  <a href="/membership/" class="border-b border-ink/40 hover:border-rose hover:text-rose">
                    {treatment.membershipAnchor}
                  </a>
                  .
                </p>
              )
            }

            <div class="mt-8">
              <Button href={business.bookingUrl} external class="w-full">{CTA_LABEL}</Button>
            </div>
          </div>

          <div class="mt-10">
            <NapBlock tone="light" showCancellation />
          </div>
        </aside>
      </div>
    </div>

    {treatment.slug === 'hydrafacial' && (
      <section class="bg-ivory py-20 md:py-28">
        <div class="wrap">
          <Reveal>
            <p class="t-eyebrow text-ink-soft">HydraFacial vs other treatments</p>
            <h2 class="t-h2 mt-4 max-w-[36ch]">
              HydraFacial vs other treatments — when HydraFacial is the right choice and when it isn't
            </h2>
            <p class="t-body mt-7 max-w-[62ch] leading-relaxed">
              HydraFacial is the most forgiving corrective treatment on the market, and that is also its limit. It is a resurfacing and maintenance treatment, not a corrective one. Here is the honest comparison against the other modalities San Diego clients ask about, and when each one actually wins.
            </p>

            <div class="mt-10 overflow-x-auto">
              <table class="w-full border-collapse text-left">
                <thead>
                  <tr class="border-b-2 border-line">
                    <th class="t-service py-4 pr-4 text-[1rem]">Modality</th>
                    <th class="t-service py-4 pr-4 text-[1rem]">Depth</th>
                    <th class="t-service py-4 pr-4 text-[1rem]">Downtime</th>
                    <th class="t-service py-4 pr-4 text-[1rem]">Best for</th>
                    <th class="t-service py-4 text-[1rem]">KIAMO offers</th>
                  </tr>
                </thead>
                <tbody>
                  <tr class="border-b border-line align-top">
                    <td class="t-service py-5 pr-4 text-[0.9375rem]">HydraFacial Syndeo</td>
                    <td class="t-body py-5 pr-4 text-[0.9375rem]">Surface to mid-dermis via vortex extraction at 30–70 mmHg controlled suction</td>
                    <td class="t-body py-5 pr-4 text-[0.9375rem]">None</td>
                    <td class="t-body py-5 pr-4 text-[0.9375rem]">Congestion, dehydration, dullness, pre-event glow, monthly maintenance between corrective sessions</td>
                    <td class="t-body py-5 text-[0.9375rem]">Yes</td>
                  </tr>
                  <tr class="border-b border-line align-top">
                    <td class="t-service py-5 pr-4 text-[0.9375rem]">Classic European facial</td>
                    <td class="t-body py-5 pr-4 text-[0.9375rem]">Surface only — manual extraction, light hydration</td>
                    <td class="t-body py-5 pr-4 text-[0.9375rem]">None</td>
                    <td class="t-body py-5 pr-4 text-[0.9375rem]">Relaxation and mild maintenance — not a corrective treatment</td>
                    <td class="t-body py-5 text-[0.9375rem]">No</td>
                  </tr>
                  <tr class="border-b border-line align-top">
