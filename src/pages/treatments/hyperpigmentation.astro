---
/**
 * Post-inflammatory hyperpigmentation landing page.
 *
 * Targets: "hyperpigmentation treatment san diego" cluster
 * SEO Strategy: Scenario page — service + qualifier + location, built to
 * rank and convert. The offer leads; the definition does not.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import NapBlock from '../../components/NapBlock.astro';
import Reveal from '../../components/Reveal.astro';
import ServiceMenu from '../../components/sections/ServiceMenu.astro';
import FaqSchema from '../../components/schema/FaqSchema.astro';
import BreadcrumbSchema from '../../components/schema/BreadcrumbSchema.astro';
import SpeakableSchema from '../../components/schema/SpeakableSchema.astro';
import TreatmentProof from '../../components/TreatmentProof.astro';
import TrustBar from '../../components/TrustBar.astro';
import ProofQuote from '../../components/ProofQuote.astro';
import { business } from '../../config/business';
import { absolute, businessId, websiteId } from '../../config/urls';
import { CTA_LABEL } from '../../config/nav';
import { treatmentTrust, studioProof } from '../../data/treatment-trust';
import pihHero from '../../assets/hyperpigmentation-treatment-serum-application-san-diego.jpg';
import pihResult from '../../assets/hyperpigmentation-after-treatment-results-san-diego.jpg';

const site = Astro.site;
const url = absolute('/treatments/hyperpigmentation', site);

const title = 'Hyperpigmentation Treatment in San Diego | KIAMO Skin';
const description =
  'Hyperpigmentation treatment in San Diego — dark marks after acne faded with a corrective plan, not a routine facial. Licensed esthetician, all skin tones.';

const trust = treatmentTrust.hyperpigmentation;

/**
 * The concerns that bring someone to this page. Stated in the visitor's
 * words, not the clinical term, because that is how they arrive.
 */
const concerns = [
  'Dark marks left after acne clears',
  'Marks after eczema, psoriasis, or another inflammatory rash',
  'Ingrown hair marks on the face, neck, or body',
  'Shaving nicks that darkened and stayed',
  'Marks from an over-aggressive peel or laser done elsewhere',
  'Uneven tone across the face with no single cause',
];

/**
 * The three treatments a PIH plan is built from, and what each does.
 */
const treatmentOptions = [
  {
    name: 'LIRA Chemical Peels',
    description:
      'The standard first step. Strength is escalated across a series and the peel is selected for the skin tone, which is what keeps a correction from becoming a new mark.',
    href: '/treatments/lira-peels/',
  },
  {
    name: 'Procell Microchanneling',
    description:
      'For marks that sit alongside texture or scarring. Works mechanically, with no heat or light — which matters on skin that reacts to both.',
    href: '/treatments/procell-microchanneling/',
  },
  {
    name: 'HydraFacial',
    description:
      'Cleansing, exfoliation, extraction, and hydration, with a brightening booster selected for the pigment. Usually the maintenance layer between corrections.',
    href: '/treatments/hydrafacial/',
  },
  {
    name: 'DMK Enzyme Therapy',
    description:
      'A different approach, centred on the condition and function of the skin. Considered when the barrier is compromised and a peel would be too much.',
    href: '/treatments/dmk-enzyme-therapy/',
  },
  {
    name: 'Dermaplaning',
    description:
      'Physical exfoliation that clears surface buildup and gives a smoother-feeling surface, which lets everything after it work better.',
    href: '/treatments/dermaplaning/',
  },
];

/**
 * The three steps of a PIH plan, in the order they happen.
 */
const steps = [
  {
    title: 'Identify which kind of mark it is',
    body: 'Post-inflammatory marks, melasma, and sun damage look alike and respond differently. Identifying which one it is comes before choosing anything to do about it — and it is the most common reason treatment fails.',
  },
  {
    title: 'Assess the condition of the skin',
    body: 'Pigmentation does not exist independently of the rest of the skin. Dehydration, congestion, irritation, and barrier disruption all change how the skin responds to treatment.',
  },
  {
    title: 'Correct, then hold it',
    body: 'An appropriate treatment is selected and spaced far enough apart for the skin to recover. Then daily SPF does the holding — because a new mark keeps arriving if the inflammation does.',
  },
];

const faqs = [
  {
    question: 'What is post-inflammatory hyperpigmentation (PIH) and how does it form?',
    answer:
      'PIH is the dark mark the skin leaves behind after inflammation — acne, eczema, an ingrown hair, a shaving nick, an over-aggressive peel done elsewhere, or any injury. The pigment is melanin produced by the inflammatory response, sitting in the surface and mid-layers of the skin. It is the most common pigmentation concern clients bring here, and it is one of the most treatable.',
  },
  {
    question: 'How is PIH different from melasma and sun damage?',
    answer:
      'PIH follows inflammation, so it maps to where the inflammation was — a cluster on the jaw where acne sat, marks along a beard line. Melasma is hormonal and appears as symmetrical patches across the cheeks, forehead, and upper lip. Sun damage is UV-driven and clusters on the highest-exposure areas. Each is treated differently, and choosing the wrong approach is the most common reason treatment fails.',
  },
  {
    question: 'How long does it take for post-inflammatory marks to fade?',
    answer:
      'It depends on the depth of the mark, the skin tone, and whether new inflammation is still arriving. Surface marks fade faster than marks sitting in the deeper layers. Most clients see visible change across a series of treatments rather than one appointment, and the timeline is set at consultation once the skin has been assessed. A plan of four to six treatments, spaced four to six weeks apart, is typical for a mark that has been there a while.',
  },
  {
    question: 'Can hyperpigmentation from acne be treated?',
    answer:
      'Yes, and it is one of the more straightforward cases. The one thing that changes the outcome is whether acne is still active. If new breakouts keep arriving, they keep producing new marks, so acne management is treated alongside the pigmentation. When the inflammation has stopped, the existing marks respond to a corrective plan on their own.',
  },
  {
    question: 'Is hyperpigmentation treatment suitable for melanin-rich skin?',
    answer:
      'Yes, and it is where the approach matters most. Melanin-rich skin produces pigment more readily in response to trauma, heat, and inflammation, so a treatment that is unremarkable on lighter skin can leave more dark marks than it cleared. The protocol accounts for that — strength escalated only as the barrier allows, no heat-based modalities on deeper skin, and every peel selected for the tone in front of you.',
  },
  {
    question: 'Can dark marks come back after treatment?',
    answer:
      'They can, and the reason is usually UV. San Diego has year-round sun exposure, and a single day without sunscreen can reverse weeks of treatment progress. The daily SPF routine is not optional maintenance around the treatment — it is the part that decides whether the pigment stays faded. Clearing the existing marks and stopping the daily trigger are two separate jobs, and both are needed.',
  },
  {
    question: 'Should I treat acne or hyperpigmentation first?',
    answer:
      'If acne and inflammation are still creating new marks, that comes first — new inflammation is generating new pigment, so clearing it is what stops the cycle. A professional assessment at consultation determines the order, because for some the marks are old and acne is not active, and for others the reverse. Treating them in the wrong order is why some people see no change after months.',
  },
  {
    question: 'What does a hyperpigmentation treatment plan include?',
    answer:
      'Four steps. The pigmentation concern is identified first, because post-inflammatory marks, melasma, and sun damage need different approaches. The condition of the skin is evaluated next, since a compromised barrier changes what can be done and when. An appropriate corrective treatment is then selected — peels, microchanneling, or enzyme therapy — and consistency is built around it. That last step is what determines whether the pigment fades or returns.',
  },
  {
    question: 'How do I find an esthetician experienced with dark skin in San Diego?',
    answer:
      'By asking direct questions before booking: what percentage of clients have deeper skin tones, which peel protocols are used on Brown and Black skin, and what the response is when post-inflammatory hyperpigmentation appears after a treatment. An esthetician who answers vaguely or defaults to "gentle works for everyone" may not have the relevant experience. KIAMO Skin in Mission Hills was built around corrective treatment for melanin-rich skin — hyperpigmentation, melasma, and post-inflammatory marks in skin tones where incorrect treatment causes more damage than it repairs.',
  },
  {
    question: 'Can I treat hyperpigmentation at home or do I need professional treatments?',
    answer:
      'Both, and the home work is not optional. A routine with gentle exfoliation, targeted serums, and daily SPF creates the foundation — professional treatments provide the deeper correction where it is needed. The combination is what works: treatments to address the existing pigment, home care to maintain progress and prevent new marks forming.',
  },
];

const webpage = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  '@id': `${url}#webpage`,
  url,
  name: title,
  description,
  isPartOf: { '@id': websiteId(site) },
  about: {
    '@type': 'MedicalCondition',
    name: 'Hyperpigmentation',
    alternateName: ['Post-inflammatory hyperpigmentation', 'PIH', 'Dark marks', 'Uneven skin tone'],
  },
  specialty: 'Dermatology',
  inLanguage: 'en-US',
};

const service = {
  '@context': 'https://schema.org',
  '@type': 'MedicalTherapy',
  '@id': `${url}#service`,
  name: 'Hyperpigmentation Treatment',
  alternateName: 'Post-Inflammatory Hyperpigmentation Treatment',
  description:
    'Professional hyperpigmentation treatment using chemical peels, microchanneling, and corrective facials—safe for all skin tones, with specialized expertise in melanin-rich skin.',
  url,
  provider: { '@id': businessId(site) },
  treatsHealthCondition: {
    '@type': 'MedicalCondition',
    name: 'Hyperpigmentation',
  },
  areaServed: business.schemaAreaServed.map((name) => ({ '@type': 'Place', name })),
};
---

<BaseLayout {title} {description}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(webpage)} slot="head" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(service)} slot="head" />
  <FaqSchema slot="head" faqs={faqs} />
  <SpeakableSchema slot="head" url={url} />
  <BreadcrumbSchema
    slot="head"
    trail={[
      { name: 'Treatments', path: '/treatments' },
      { name: 'Hyperpigmentation Treatment', path: '/treatments/hyperpigmentation' },
    ]}
  />

  <article>
    <header class="bg-blush">
      <div class="wrap pt-[calc(60px+40px)] pb-14 md:pt-[calc(60px+64px)] md:pb-20">
        <div class="grid items-center gap-10 md:grid-cols-2 md:gap-14 lg:gap-20">
          <div>
            <p class="t-eyebrow text-ink-soft">Hyperpigmentation Treatment</p>
            <h1 class="t-h2 mt-6 max-w-[24ch] text-[2.25rem] md:text-[3.5rem]">
              Hyperpigmentation Treatment in San Diego — Clear Post-Acne Marks
            </h1>
            {/* The deck line. It leads with the method — the thing that is
                different about this treatment — and closes with the
                credential, so the H1 can carry service, city, and benefit
                without the hero repeating itself. */}
            <p class="t-body mt-6 max-w-[56ch] text-[1.125rem]">
              A series of gentle LIRA peels or Procell microchanneling, paired with daily SPF.
              Performed by Kiki, a California licensed esthetician with {business.experience} in
              corrective skin.
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
              <Button href={business.bookingUrl} external>{CTA_LABEL}</Button>
              <a
                href={business.phone.href}
                class="t-body border-b border-ink pb-1 hover:border-rose hover:text-rose"
              >
                {business.phone.display}
              </a>
            </div>
          </div>

          <div>
            <Image
              src={pihHero}
              alt="Licensed esthetician applying a brightening serum to treat hyperpigmentation on melanin-rich skin at KIAMO Skin in Mission Hills, San Diego"
              widths={[640, 1280]}
              sizes="(min-width: 768px) 50vw, 100vw"
              loading="eager"
              class="aspect-4/3 w-full rounded-lg object-cover"
            />
          </div>
        </div>
      </div>
    </header>

    {/* The trust band. It sits directly below the hero as its own strip
        rather than inside it - the hero is the offer, and the claims are
        the reason to believe it. Keeping them apart is also what lets the
        hero fit the fold. */}
    <section class="bg-porcelain py-12 md:py-14">
      <div class="wrap">
        <TrustBar items={trust.claims} heading="Why this studio" />
        {/* A client's words, directly under the studio's own claims. The
            claims are the studio asserting things about itself; this is
            somebody else saying it, and it belongs high on the page. */}
        <div class="mt-10 border-t border-line pt-9 md:mt-12 md:pt-10">
          <ProofQuote testimonial={studioProof} />
        </div>
      </div>
    </section>

    <section class="bg-porcelain py-20 md:py-28">
      <div class="wrap grid items-center gap-12 md:grid-cols-[1fr_0.85fr] md:gap-20">
        <div>
          <Reveal>
            <p class="t-eyebrow text-ink-soft">What brings people in</p>
            <h2 class="t-h2 mt-4">The Marks This Treatment Addresses</h2>
            <p class="t-body mt-6 leading-relaxed">
              Any of these can be treated. The relevant question is not which concern it is, but
              whether the inflammation that caused it has stopped — because new inflammation keeps
              producing new marks.
            </p>
            <ul class="t-body mt-6 space-y-2.5">
              {
                concerns.map((concern) => (
                  <li class="flex gap-3 leading-relaxed">
                    <span class="mt-1 text-rose" aria-hidden="true">
                      •
                    </span>
                    <span>{concern}</span>
                  </li>
                ))
              }
            </ul>
            <p class="t-body mt-6 leading-relaxed">
              The purpose is not simply to make pigmentation disappear as quickly as possible. A
              corrective plan considers how the skin is behaving now and what approach suits its
              current condition.
            </p>
          </Reveal>
        </div>
        <Reveal>
          <Image
            src={pihResult}
            alt="Close portrait of even, clear skin on melanin-rich skin after a course of corrective hyperpigmentation treatment in San Diego"
            widths={[400, 800, 1200]}
            sizes="(min-width: 840px) 40vw, 90vw"
            loading="eager"
            class="aspect-[0.92] w-full rounded-lg object-cover"
          />
        </Reveal>
      </div>
    </section>

    <section class="bg-ivory py-20 md:py-28">
      <div class="wrap">
        <div class="mx-auto max-w-[68ch]">
          <Reveal>
            <p class="t-eyebrow text-ink-soft">How the plan runs</p>
            <h2 class="t-h2 mt-4">Three Steps Before Any Treatment Starts</h2>
          </Reveal>
          <div class="mt-10 space-y-8">
            {
              steps.map((step, i) => (
                <Reveal>
                  <div class="flex gap-5">
                    <span
                      class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-rose font-medium text-porcelain"
                      aria-hidden="true"
                    >
                      {i + 1}
                    </span>
                    <div>
                      <h3 class="t-service text-[1.0625rem]">{step.title}</h3>
                      <p class="t-body mt-3 text-[0.9375rem] leading-relaxed text-ink-soft">
                        {step.body}
                      </p>
                    </div>
                  </div>
                </Reveal>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="bg-porcelain py-20 md:py-28">
      <div class="wrap">
        <Reveal>
          <p class="t-eyebrow text-ink-soft">Treatment options</p>
          <h2 class="t-h2 mt-4">The Treatments a Pigmentation Plan Uses</h2>
          <p class="t-body mt-6 max-w-[62ch] leading-relaxed">
            A plan usually draws on two or three of these. Which ones, and in what order, depends on
            the type of pigmentation and the condition of the skin — the assessment sets that.
          </p>
        </Reveal>

        <ul class="m-0 mt-14 grid list-none gap-7 p-0 md:grid-cols-2 lg:grid-cols-3 md:gap-6 lg:gap-8">
          {
            treatmentOptions.map((treatment) => (
              <Reveal as="li">
                <div class="flex h-full flex-col rounded-lg bg-ivory p-8 lg:p-9">
                  <h3 class="t-service text-[1.125rem]">{treatment.name}</h3>
                  <p class="t-body mt-4 flex-1 leading-relaxed text-[0.9375rem] text-ink-soft">
                    {treatment.description}
                  </p>
                  <a
                    href={treatment.href}
                    class="t-button mt-5 inline-block border-b border-ink pb-1 hover:border-rose hover:text-rose"
                  >
                    Learn more
                  </a>
                </div>
              </Reveal>
            ))
          }
        </ul>

        <p class="t-body mt-12 max-w-[62ch] text-[0.9375rem]">
          Pigmentation overlaps with several other concerns, and the plan accounts for that — someone
          with post-acne marks and a compromised barrier is not treated the same way as someone
          whose only concern is tone. Browse{' '}
          <a
            href="/treatments/melasma/"
            class="border-b border-ink/40 hover:border-rose hover:text-rose"
          >
            melasma treatment
          </a>{' '}
          or the{' '}
          <a
            href="/treatments/acne/"
            class="border-b border-ink/40 hover:border-rose hover:text-rose"
          >
            full corrective treatment menu
          </a>
          , or see hyperpigmentation treatment across San Diego neighbourhoods.
        </p>
      </div>
    </section>

    {/* The proof. Quick answer for AI extraction, the published case, a client
        quote, and the risk reversal — together, so a reader has met the
        studio before the questions and the booking form. */}
    <section class="bg-ivory py-20 md:py-28">
      <div class="wrap">
        <div class="mx-auto max-w-[68ch]">
          <TreatmentProof slug="hyperpigmentation" />
        </div>
      </div>
    </section>

    <section class="bg-porcelain py-20 md:py-28">
      <div class="wrap">
        <div class="mx-auto max-w-[68ch]">
          <Reveal>
            <p class="t-eyebrow text-ink-soft">Common questions</p>
            <h2 class="t-h2 mt-4">Hyperpigmentation Treatment Questions</h2>
          </Reveal>
          {/* Visible text, not accordions. These are SEO pages, and the
              studio's own booking FAQ block made this call for the same
              reason. The first four lead at full size because they are the
              ones that block a booking outright. */}
          <div class="mt-12">
            {
              faqs.slice(0, 4).map((faq) => (
                <div class="border-b border-line py-7 first:pt-0">
                  <h3 class="t-service text-[1.0625rem] md:text-[1.1875rem]">{faq.question}</h3>
                  <p class="t-body mt-3 text-[0.9375rem]">{faq.answer}</p>
                </div>
              ))
            }
          </div>
          <div class="mt-12">
            <p class="t-eyebrow text-ink-soft">Also asked</p>
            <dl class="mt-6">
              {
                faqs.slice(4).map((faq) => (
                  <div class="border-b border-line py-5 last:border-b-0">
                    <dt class="t-service text-[0.9375rem]">{faq.question}</dt>
                    <dd class="t-body mt-2 text-[0.9375rem] text-ink-soft">{faq.answer}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-ivory py-20 md:py-28">
      <div class="wrap">
        <div class="mx-auto max-w-[68ch] text-center">
          <Reveal>
            <h2 class="t-h2">Take the Next Step With KIAMO Skin</h2>
            <p class="t-body mx-auto mt-6 max-w-[58ch]">
              If dark marks, uneven tone, or persistent pigmentation are making you feel frustrated
              with your skin, you do not have to keep guessing which treatment to try next.
            </p>
            <p class="t-body mx-auto mt-5 max-w-[58ch]">
              The corrective approach starts with understanding the concern and the condition of
              your skin, then selecting an appropriate treatment strategy. Contact KIAMO Skin to
              discuss your skin concerns and next steps.
            </p>
            <div class="mt-9 flex flex-wrap items-center justify-center gap-x-8 gap-y-4">
              <Button href={business.bookingUrl} external>{CTA_LABEL}</Button>
              <a
                href={business.phone.href}
                class="t-body border-b border-ink pb-1 hover:border-rose hover:text-rose"
              >
                {business.phone.display}
              </a>
            </div>

            {/* Trust repeats. The band under the hero carries one quote;
                this is the second one, next to the booking form, so a reader
                who scrolls straight to the CTA still meets a client before
                they meet the button. */}
            <div class="mx-auto mt-10 max-w-[46ch] border-t border-line pt-9">
              <ProofQuote testimonial={studioProof} />
            </div>
          </Reveal>
        </div>
      </div>
    </section>

    <ServiceMenu />

    <section class="bg-porcelain py-16 md:py-20">
      <div class="wrap">
        <NapBlock />
      </div>
    </section>
  </article>
</BaseLayout>
