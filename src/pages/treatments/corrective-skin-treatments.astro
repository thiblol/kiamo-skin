---
/**
 * Corrective skin treatments landing page.
 *
 * Targets: "corrective skin treatments san diego" cluster
 * SEO Strategy: Scenario page — service + qualifier + location, built to
 * rank and convert. The offer leads; the definition does not.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import NapBlock from '../../components/NapBlock.astro';
import Reveal from '../../components/Reveal.astro';
import ServiceMenu from '../../components/sections/ServiceMenu.astro';
import FaqSchema from '../../components/schema/FaqSchema.astro';
import BreadcrumbSchema from '../../components/schema/BreadcrumbSchema.astro';
import SpeakableSchema from '../../components/schema/SpeakableSchema.astro';
import TreatmentProof from '../../components/TreatmentProof.astro';
import TrustBar from '../../components/TrustBar.astro';
import ProofQuote from '../../components/ProofQuote.astro';
import { business } from '../../config/business';
import { absolute, businessId, websiteId } from '../../config/urls';
import { CTA_LABEL } from '../../config/nav';
import { treatmentTrust, studioProof } from '../../data/treatment-trust';
import correctiveHero from '../../assets/corrective-skin-treatment-melanin-rich-approach-san-diego.jpg';
import consultation from '../../assets/corrective-skin-treatment-consultation-mission-hills-san-diego.jpg';

const site = Astro.site;
const url = absolute('/treatments/corrective-skin-treatments', site);

const title = 'Corrective Skin Treatments in San Diego | KIAMO Skin';
const description =
  'Corrective skin treatments in San Diego — a plan built around your skin, not a trend. Peels, microchanneling, enzyme therapy. All skin tones.';

const trust = treatmentTrust['corrective-skin-treatments'];

/**
 * The concerns this page answers to.
 */
const concerns = [
  'Hyperpigmentation and uneven skin tone',
  'Melasma and persistent pigmentation',
  'Acne and congestion',
  'Post-inflammatory marks',
  'Uneven skin texture',
  'Dull or rough-looking skin',
  'Dehydration and a compromised skin barrier',
  'Scalp buildup and scalp-health concerns',
];

/**
 * The treatment menu, and what each one is for.
 */
const correctiveTreatments = [
  {
    name: 'HydraFacial',
    description:
      'Cleansing, exfoliation, extraction, and hydration for congested, dull, or dehydrated skin. The foundation most corrective plans are built on.',
    href: '/treatments/hydrafacial/',
  },
  {
    name: 'DMK Enzyme Therapy',
    description:
      'Works on skin barrier function and overall skin health. Considered when the goal is supporting healthier skin rather than a surface refresh.',
    href: '/treatments/dmk-enzyme-therapy/',
  },
  {
    name: 'Procell Microchanneling',
    description:
      'Targeted treatment for texture and the appearance of acne scarring. Suitability is determined by individual skin condition and goals.',
    href: '/treatments/procell-microchanneling/',
  },
  {
    name: 'LIRA Chemical Peels',
    description:
      'Professional exfoliation for uneven tone, texture, and dullness. Peel selection depends on the skin and the treatment objective.',
    href: '/treatments/lira-peels/',
  },
  {
    name: 'Dermaplaning',
    description:
      'Physical exfoliation that removes surface buildup and creates a smoother-feeling surface. Often folded into a broader strategy.',
    href: '/treatments/dermaplaning/',
  },
  {
    name: 'Keravive Scalp Therapy',
    description:
      'Scalp cleansing and care for scalp-related concerns. Corrective care does not stop at the jawline.',
    href: '/treatments/keravive-scalp/',
  },
];

/**
 * The four steps of a corrective plan.
 */
const steps = [
  {
    title: 'Identify the primary concern',
    body: 'What you want to improve — pigmentation, acne, texture, congestion, dehydration, or another concern — comes first, because the order of everything after it follows from it.',
  },
  {
    title: 'Assess the current condition of the skin',
    body: 'A treatment that suits one person may be wrong for another, particularly when the skin is irritated, sensitized, or barrier-compromised. This step is what keeps a plan from becoming a trial and error.',
  },
  {
    title: 'Select the treatment',
    body: 'HydraFacial, DMK enzyme therapy, Procell microchanneling, LIRA peels, or dermaplaning — chosen for the concern and the skin, not because a treatment is trending or because more procedures seem better.',
  },
  {
    title: 'Adjust as the skin changes',
    body: 'Skin changes over time. The plan is adjusted as it responds, and as a different concern becomes the priority.',
  },
];

const faqs = [
  {
    question: 'What are corrective skin treatments?',
    answer:
      'Professional treatments selected to address a specific concern — pigmentation, acne, uneven texture, congestion, dehydration, or barrier health. The difference from a routine facial is not that one is better, but that the objective is different: a facial refreshes, a corrective plan targets. Which one a given skin needs is decided by assessment, not by the menu.',
  },
  {
    question: 'Should I start with a facial, a peel, or microchanneling?',
    answer:
      'Start with the barrier, not the treatment. If the skin is reactive or compromised — over-exfoliated, recently sunburnt, or stripped by treatment done elsewhere — DMK enzyme therapy comes first, because microchanneling on a compromised barrier produces unpredictable results, and a peel on an unstable one can trigger the darkening it was meant to clear. Once the barrier is stable, the choice follows the concern: a facial for maintenance, a peel for pigment and texture, microchanneling for scarring. The order is set at consultation and changes as the skin responds.',
  },
  {
    question: 'Can corrective treatments be combined?',
    answer:
      'Different treatments may be incorporated into a broader strategy when appropriate. But treatments should not be combined simply because more procedures seem better. The sequence and frequency have to make sense for the individual skin and goals, and a corrective plan often means fewer treatments, spaced further apart, than a client expected.',
  },
  {
    question: 'How do I know which corrective treatment I need?',
    answer:
      'Start by identifying your primary concern and the current condition of your skin, and an appropriate treatment follows from that. The consultation is where this happens, and it is worth having before booking a procedure — the most common reason a plan fails is that the first treatment was chosen before the assessment.',
  },
  {
    question: 'Are corrective skin treatments suitable for melanin-rich skin?',
    answer:
      'Yes, and the treatment selection has to take the characteristics and current condition of melanin-rich skin into account. Melanin-rich skin produces pigment more readily in response to trauma, heat, and inflammation, so an unremarkable treatment on lighter skin can cause post-inflammatory hyperpigmentation on deeper skin. Kiki brings training from exactly those cases, and protocols are selected to suit the tone in front of you.',
  },
  {
    question: 'How does a corrective plan compare with a regular facial?',
    answer:
      'A facial can be the right choice when the goal is relaxation, cleansing, hydration, or routine maintenance. A corrective plan is the right choice when the goal is a specific concern — pigmentation, acne, texture, or barrier health. Neither is universally better; the objective decides which one you need, and KIAMO Skin can help work out which that is before anything is booked.',
  },
];

const webpage = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  '@id': `${url}#webpage`,
  url,
  name: title,
  description,
  isPartOf: { '@id': websiteId(site) },
  specialty: 'Dermatology',
  inLanguage: 'en-US',
};

const service = {
  '@context': 'https://schema.org',
  '@type': 'MedicalTherapy',
  '@id': `${url}#service`,
  name: 'Corrective Skin Treatments',
  description:
    'Professional corrective skin treatments for pigmentation, acne, texture, barrier health, and other skin concerns—personalized to individual skin needs.',
  url,
  provider: { '@id': businessId(site) },
  areaServed: business.schemaAreaServed.map((name) => ({ '@type': 'Place', name })),
};
---

<BaseLayout {title} {description}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(webpage)} slot="head" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(service)} slot="head" />
  <FaqSchema slot="head" faqs={faqs} />
  <SpeakableSchema slot="head" url={url} />
  <BreadcrumbSchema
    slot="head"
    trail={[
      { name: 'Treatments', path: '/treatments' },
      { name: 'Corrective Skin Treatments', path: '/treatments/corrective-skin-treatments' },
    ]}
  />

  <article>
    <header class="bg-blush">
      <div class="wrap pt-[calc(60px+40px)] pb-14 md:pt-[calc(60px+64px)] md:pb-20">
        <div class="grid items-center gap-10 md:grid-cols-2 md:gap-14 lg:gap-20">
          <div>
            <p class="t-eyebrow text-ink-soft">Corrective Skincare</p>
            <h1 class="t-h2 mt-6 max-w-[24ch] text-[2.25rem] md:text-[3.5rem]">
              Corrective Skin Treatments in San Diego — Built Around Your Skin
            </h1>
            {/* The deck line. It leads with the method — the thing that is
                different about this treatment — and closes with the
                credential, so the H1 can carry service, city, and benefit
                without the hero repeating itself. */}
            <p class="t-body mt-6 max-w-[56ch] text-[1.125rem]">
              Every treatment is selected for what your skin is doing, and paced to what it can
              tolerate. Performed by Kiki, a California licensed esthetician with{' '}
              {business.experience} in corrective skin.
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
              <Button href={business.bookingUrl} external>{CTA_LABEL}</Button>
              <a
                href={business.phone.href}
                class="t-body border-b border-ink pb-1 hover:border-rose hover:text-rose"
              >
                {business.phone.display}
              </a>
            </div>
          </div>

          <div>
            <Image
              src={correctiveHero}
              alt="Licensed esthetician performing a corrective treatment on melanin-rich skin at KIAMO Skin in Mission Hills, San Diego"
              widths={[640, 1280]}
              sizes="(min-width: 768px) 50vw, 100vw"
              loading="eager"
              class="aspect-4/3 w-full rounded-lg object-cover"
            />
          </div>
        </div>
      </div>
    </header>

    {/* The trust band. It sits directly below the hero as its own strip
        rather than inside it - the hero is the offer, and the claims are
        the reason to believe it. Keeping them apart is also what lets the
        hero fit the fold. */}
    <section class="bg-porcelain py-12 md:py-14">
      <div class="wrap">
        <TrustBar items={trust.claims} heading="Why this studio" />
        {/* A client's words, directly under the studio's own claims. The
            claims are the studio asserting things about itself; this is
            somebody else saying it, and it belongs high on the page. */}
        <div class="mt-10 border-t border-line pt-9 md:mt-12 md:pt-10">
          <ProofQuote testimonial={studioProof} />
        </div>
      </div>
    </section>

    <section class="bg-porcelain py-20 md:py-28">
      <div class="wrap grid items-center gap-12 md:grid-cols-[1fr_0.85fr] md:gap-20">
        <div>
          <Reveal>
            <p class="t-eyebrow text-ink-soft">What it addresses</p>
            <h2 class="t-h2 mt-4">The Concerns a Corrective Plan Works On</h2>
            <p class="t-body mt-6 leading-relaxed">
              Corrective skincare starts with the understanding that different concerns can require
              different approaches. Pigmentation is not addressed the same way as acne, dehydration,
              texture, or barrier damage.
            </p>
            <ul class="t-body mt-6 space-y-2.5">
              {
                concerns.map((concern) => (
                  <li class="flex gap-3 leading-relaxed">
                    <span class="mt-1 text-rose" aria-hidden="true">
                      •
                    </span>
                    <span>{concern}</span>
                  </li>
                ))
              }
            </ul>
            <p class="t-body mt-6 leading-relaxed">
              The objective is a treatment plan based on the condition of the skin, rather than
              automatically recommending the same facial or procedure to everyone.
            </p>
          </Reveal>
        </div>
        <Reveal>
          <Image
            src={consultation}
            alt="Corrective skin consultation at KIAMO Skin in Mission Hills, San Diego — licensed esthetician assessing client skin before treatment"
            widths={[400, 800, 1200]}
            sizes="(min-width: 840px) 40vw, 90vw"
            loading="eager"
            class="aspect-[0.92] w-full rounded-lg object-cover"
          />
        </Reveal>
      </div>
    </section>

    <section class="bg-ivory py-20 md:py-28">
      <div class="wrap">
        <div class="mx-auto max-w-[68ch]">
          <Reveal>
            <p class="t-eyebrow text-ink-soft">How a plan is built</p>
            <h2 class="t-h2 mt-4">Four Steps, and the First One Is Not a Treatment</h2>
          </Reveal>
          <div class="mt-10 space-y-8">
            {
              steps.map((step, i) => (
                <Reveal>
                  <div class="flex gap-5">
                    <span
                      class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-rose font-medium text-porcelain"
                      aria-hidden="true"
                    >
                      {i + 1}
                    </span>
                    <div>
                      <h3 class="t-service text-[1.0625rem]">{step.title}</h3>
                      <p class="t-body mt-3 text-[0.9375rem] leading-relaxed text-ink-soft">
                        {step.body}
                      </p>
                    </div>
                  </div>
                </Reveal>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="bg-porcelain py-20 md:py-28">
      <div class="wrap">
        <Reveal>
          <p class="t-eyebrow text-ink-soft">The menu</p>
          <h2 class="t-h2 mt-4">Which Corrective Treatment Is Right for You</h2>
          <p class="t-body mt-6 max-w-[62ch] leading-relaxed">
            There is no single corrective treatment that is right for every skin concern. These are
            the modalities the studio works with, and each has a job it is suited to.
          </p>
        </Reveal>

        <ul class="m-0 mt-14 grid list-none gap-7 p-0 md:grid-cols-2 lg:grid-cols-3 md:gap-6 lg:gap-8">
          {
            correctiveTreatments.map((treatment) => (
              <Reveal as="li">
                <div class="flex h-full flex-col rounded-lg bg-ivory p-8 lg:p-9">
                  <h3 class="t-service text-[1.125rem]">{treatment.name}</h3>
                  <p class="t-body mt-4 flex-1 leading-relaxed text-[0.9375rem] text-ink-soft">
                    {treatment.description}
                  </p>
                  <a
                    href={treatment.href}
                    class="t-button mt-5 inline-block border-b border-ink pb-1 hover:border-rose hover:text-rose"
                  >
                    Learn more
                  </a>
                </div>
              </Reveal>
            ))
          }
        </ul>

        <p class="t-body mt-12 max-w-[62ch] text-[0.9375rem]">
          Pigmentation overlaps with several other concerns, and the plan accounts for that —
          someone dealing with post-acne marks and a compromised barrier is not treated the same way
          as someone whose only concern is dehydration. For the two concerns most often searched
          for on their own, see{' '}
          <a
            href="/treatments/hyperpigmentation/"
            class="border-b border-ink/40 hover:border-rose hover:text-rose"
          >
            hyperpigmentation treatment
          </a>{' '}
          and{' '}
          <a href="/treatments/melasma/" class="border-b border-ink/40 hover:border-rose hover:text-rose">
            melasma treatment
          </a>
          .
        </p>
      </div>
    </section>

    {/* The proof. Quick answer for AI extraction, the published case, a client
        quote, and the risk reversal — together, so a reader has met the
        studio before the questions and the booking form. */}
    <section class="bg-ivory py-20 md:py-28">
      <div class="wrap">
        <div class="mx-auto max-w-[68ch]">
          <TreatmentProof slug="corrective-skin-treatments" />
        </div>
      </div>
    </section>

    <section class="bg-porcelain py-20 md:py-28">
      <div class="wrap">
        <div class="mx-auto max-w-[68ch]">
          <Reveal>
            <p class="t-eyebrow text-ink-soft">Common questions</p>
            <h2 class="t-h2 mt-4">Corrective Skin Treatment Questions</h2>
          </Reveal>
          {/* Visible text, not accordions. These are SEO pages, and the
              studio's own booking FAQ block made this call for the same
              reason. The first four lead at full size because they are the
              ones that block a booking outright. */}
          <div class="mt-12">
            {
              faqs.slice(0, 4).map((faq) => (
                <div class="border-b border-line py-7 first:pt-0">
                  <h3 class="t-service text-[1.0625rem] md:text-[1.1875rem]">{faq.question}</h3>
                  <p class="t-body mt-3 text-[0.9375rem]">{faq.answer}</p>
                </div>
              ))
            }
          </div>
          <div class="mt-12">
            <p class="t-eyebrow text-ink-soft">Also asked</p>
            <dl class="mt-6">
              {
                faqs.slice(4).map((faq) => (
                  <div class="border-b border-line py-5 last:border-b-0">
                    <dt class="t-service text-[0.9375rem]">{faq.question}</dt>
                    <dd class="t-body mt-2 text-[0.9375rem] text-ink-soft">{faq.answer}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-ivory py-20 md:py-28">
      <div class="wrap">
        <div class="mx-auto max-w-[68ch] text-center">
          <Reveal>
            <h2 class="t-h2">Take the Next Step With KIAMO Skin</h2>
            <p class="t-body mx-auto mt-6 max-w-[58ch]">
              If you are ready to move beyond guessing which facial or treatment to book, start with
              your actual skin concern. The corrective approach is designed to connect treatment
              selection with the condition and needs of your skin.
            </p>
            <div class="mt-9 flex flex-wrap items-center justify-center gap-x-8 gap-y-4">
              <Button href={business.bookingUrl} external>{CTA_LABEL}</Button>
              <a
                href={business.phone.href}
                class="t-body border-b border-ink pb-1 hover:border-rose hover:text-rose"
              >
                {business.phone.display}
              </a>
            </div>

            {/* Trust repeats. The band under the hero carries one quote;
                this is the second one, next to the booking form, so a reader
                who scrolls straight to the CTA still meets a client before
                they meet the button. */}
            <div class="mx-auto mt-10 max-w-[46ch] border-t border-line pt-9">
              <ProofQuote testimonial={studioProof} />
            </div>
          </Reveal>
        </div>
      </div>
    </section>

    <ServiceMenu />

    <section class="bg-porcelain py-16 md:py-20">
      <div class="wrap">
        <NapBlock />
      </div>
    </section>
  </article>
</BaseLayout>
