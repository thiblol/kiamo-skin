---
/**
 * Melasma treatment landing page.
 *
 * Targets: "melasma treatment san diego" (60k/mo cluster)
 * SEO Strategy: Scenario page — service + qualifier + location, built to
 * rank and convert. The offer leads; the definition does not.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import NapBlock from '../../components/NapBlock.astro';
import Reveal from '../../components/Reveal.astro';
import ServiceMenu from '../../components/sections/ServiceMenu.astro';
import FaqSchema from '../../components/schema/FaqSchema.astro';
import BreadcrumbSchema from '../../components/schema/BreadcrumbSchema.astro';
import SpeakableSchema from '../../components/schema/SpeakableSchema.astro';
import TreatmentProof from '../../components/TreatmentProof.astro';
import TrustBar from '../../components/TrustBar.astro';
import ProofQuote from '../../components/ProofQuote.astro';
import { business } from '../../config/business';
import { absolute, businessId, websiteId } from '../../config/urls';
import { CTA_LABEL } from '../../config/nav';
import { treatmentTrust, studioProof } from '../../data/treatment-trust';
import melasmaHero from '../../assets/best-facial-san-diego-customized-consultation-mission-hills.jpg';
import melasmaResult from '../../assets/hyperpigmentation-melasma-treatment-san-diego.jpg';

const site = Astro.site;
const url = absolute('/treatments/melasma', site);

const title = 'Melasma Treatment in San Diego | KIAMO Skin';
const description =
  'Melasma treatment in San Diego — a paced series of gentle peels, not one aggressive visit. Licensed esthetician, all skin tones. Mission Hills studio.';

const trust = treatmentTrust.melasma;

/**
 * The treatments that make up a melasma plan, and what each one costs.
 *
 * The order is the order they are typically sequenced in — gentle first,
 * correction second, maintenance between — because a reader deciding on
 * melasma is deciding on a series, not on a single appointment.
 */
const melasmaTreatments = [
  {
    name: 'LIRA Chemical Peels',
    description:
      'The backbone of the plan. Strength escalates across a series rather than in one aggressive visit, and the peel is selected for the skin tone in front of you.',
    price: '$199–$299',
    href: '/treatments/lira-peels/',
  },
  {
    name: 'Procell Microchanneling',
    description:
      'Adds mechanical collagen induction where texture or scarring is part of the picture. No heat and no light, which is why it suits skin that reacts to both.',
    price: '$475',
    href: '/treatments/procell-microchanneling/',
  },
  {
    name: 'HydraFacial with Brightening Booster',
    description:
      'Sits between corrective sessions to hold the result — gentle extraction, hydration, and a targeted booster for the pigment.',
    price: '$259',
    href: '/treatments/hydrafacial/',
  },
];

/**
 * The three steps of a melasma plan.
 *
 * Written as what happens, in order, with the customer's action first. The
 * reader is deciding whether to commit to a series, so the shape of the
 * series is the thing that has to be obvious.
 */
const melasmaSteps = [
  {
    title: 'Identify the type and the depth',
    body: 'Melasma, post-inflammatory marks, and sun damage look alike and respond differently. The assessment establishes which one it is, and how deep it sits.',
  },
  {
    title: 'Pace the correction',
    body: 'Gentle LIRA peels, strength raised only as the barrier allows, spaced four to six weeks apart. Aggressive treatment makes melasma worse, not better.',
  },
  {
    title: 'Hold the result with daily SPF',
    body: 'Broad-spectrum SPF with iron oxides, every morning. Melasma is driven by hormones and sustained by UV — clearing it and stopping the trigger are two separate jobs.',
  },
];

/**
 * The San Diego-specific triggers.
 *
 * These are the reason this page exists in this city. The marine layer, the
 * hard water, the inland heat — none of it is generic skincare advice, and
 * it is what a San Diego reader cannot get from a national chain.
 */
const melasmaTriggers = [
  'Hormonal changes — pregnancy, birth control, menopause',
  'Sun exposure, including the overcast days the marine layer makes look safe',
  'Heat — hot yoga, saunas, and beach walks in direct sun',
  'Certain medications and skincare ingredients',
  'Santa Ana wind events, which destabilise even controlled pigmentation',
  'The May Gray and June Gloom marine layer, which still passes UV through overcast mornings',
  'Hard-water mineral film, which disrupts the barrier and worsens the inflammation melasma lives in',
];

const melasmaFaqs = [
  {
    question: 'Can melasma be permanently cured?',
    answer:
      'No, and any studio that says otherwise is selling something. Melasma is driven by hormones and by UV exposure, both of which keep happening. What it can be is managed — faded significantly, held with daily SPF, and kept from returning as fast. That is a permanent working routine, not a one-time fix, and it is the honest version.',
  },
  {
    question: 'How many treatments does it take to see results?',
    answer:
      'Most clients see visible change after three to four sessions, with the full result across six to eight sessions spaced four to six weeks apart. Melasma is cumulative — the pigment lifts gradually rather than in one dramatic shift, which is exactly why the pacing matters. A treatment plan is set at consultation once the skin has been assessed.',
  },
  {
    question: 'What melasma treatments are safe for melanin-rich skin?',
    answer:
      'Chemical peels selected for deeper skin tones, microchanneling — which works with no heat at all — and customized HydraFacials. The rule is that nothing is escalated until the barrier tolerates the last step. Aggressive treatments can trigger post-inflammatory hyperpigmentation in melanin-rich skin, leaving more dark marks than the ones that brought you in.',
  },
  {
    question: 'How much does melasma treatment cost?',
    answer:
      'LIRA chemical peels run $199 to $299 per session. Procell microchanneling is $475 per session, or $1,199 for a series of three. A HydraFacial with a brightening booster is $259. Because melasma needs a series rather than a single session, many clients use the monthly facial membership at $199 to make staying consistent affordable.',
  },
  {
    question: 'Do you treat melasma on all skin tones?',
    answer:
      'Yes — Fitzpatrick I through VI. Melasma is most common in deeper skin tones, and treating it safely there requires training in exactly the cases where the margin for error is smallest. Kiki built that training treating pigmentation in Black and brown skin, where a wrong move can cause more damage than it repairs, and that training is what makes the treatment safe for every tone.',
  },
  {
    question: 'Why is melasma harder to treat in San Diego?',
    answer:
      'Because the primary trigger never stops. San Diego has year-round sun exposure and high UV even on overcast mornings, when the marine layer is present. That is why strict daily sunscreen compliance — not just in summer — is the part of the plan that decides whether pigment stays faded or comes back.',
  },
  {
    question: 'Should I see an esthetician or a dermatologist for melasma?',
    answer:
      'For most people, both, at different stages. A dermatologist prescribes the topical medications that work at the cellular level. A licensed esthetician performs the in-office correction — peels, microchanneling, enzyme therapy — and builds the home routine and maintenance plan that decides whether melasma fades or returns. For stubborn melasma, the two together produce better results than either alone.',
  },
  {
    question: 'What home routine do I need after a treatment to hold the results?',
    answer:
      'Three parts. Broad-spectrum SPF with iron oxides every morning, because visible light is a trigger and iron oxides are the only filters that block it. A gentle cleanser and a barrier-supporting moisturiser, nothing that strips. And no retinoids or acids while the skin is recovering. Once the correction has landed, a prescription retinoid a few nights a week and a vitamin C or niacinamide serum each morning keep the turnover moving.',
  },
  {
    question: 'Can pregnancy melasma be treated in San Diego?',
    answer:
      'It can, but timing matters. Chemical peels and microchanneling are usually deferred until after pregnancy and breastfeeding, because hormones are still fluctuating and melasma is more reactive then. A gentle routine with daily mineral SPF can start immediately to prevent it worsening. Consultations are available throughout, to assess the skin and build the plan for when treatment begins.',
  },
  {
    question: 'Where can I get melasma treatment in San Diego?',
    answer:
      'KIAMO Skin is at 3067 Reynard Way in Mission Hills, minutes from Hillcrest, Bankers Hill, and Little Italy, with free on-site parking. Clients travel from across the county — Chula Vista, La Jolla, Encinitas, Carlsbad, North Park, and La Mesa — because melasma on melanin-rich skin requires specialized training most estheticians do not have.',
  },
];

const webpage = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  '@id': `${url}#webpage`,
  url,
  name: title,
  description,
  isPartOf: { '@id': websiteId(site) },
  about: {
    '@type': 'MedicalCondition',
    name: 'Melasma',
    alternateName: ['Chloasma', 'Pregnancy mask', 'Hormonal pigmentation'],
  },
  specialty: 'Dermatology',
  inLanguage: 'en-US',
};

const service = {
  '@context': 'https://schema.org',
  '@type': 'MedicalTherapy',
  '@id': `${url}#service`,
  name: 'Melasma Treatment',
  alternateName: 'Hormonal Pigmentation Treatment',
  description:
    'Professional melasma treatment using chemical peels, microchanneling, and corrective facials—safe for all skin tones, including melanin-rich skin.',
  url,
  provider: { '@id': businessId(site) },
  availableService: melasmaTreatments.map((t) => ({
    '@type': 'MedicalProcedure',
    name: t.name,
    description: t.description,
    procedureType: 'Therapeutic',
  })),
  treatsHealthCondition: {
    '@type': 'MedicalCondition',
    name: 'Melasma',
  },
  areaServed: business.schemaAreaServed.map((name) => ({ '@type': 'Place', name })),
};
---

<BaseLayout {title} {description}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(webpage)} slot="head" />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(service)} slot="head" />
  <FaqSchema slot="head" faqs={melasmaFaqs} />
  <SpeakableSchema slot="head" url={url} />
  <BreadcrumbSchema
    slot="head"
    trail={[
      { name: 'Treatments', path: '/treatments' },
      { name: 'Melasma Treatment', path: '/treatments/melasma' },
    ]}
  />

  <article>
    <header class="bg-blush">
      <div class="wrap pt-[calc(60px+40px)] pb-14 md:pt-[calc(60px+64px)] md:pb-20">
        <div class="grid items-center gap-10 md:grid-cols-2 md:gap-14 lg:gap-20">
          <div>
            <p class="t-eyebrow text-ink-soft">Melasma Treatment</p>
            <h1 class="t-h2 mt-6 max-w-[24ch] text-[2.25rem] md:text-[3.5rem]">
              Melasma Treatment in San Diego — Visible Results Without Triggering More
            </h1>
            {/* The deck line. It leads with the method — the thing that is
                different about this treatment — and closes with the
                credential, so the H1 can carry service, city, and benefit
                without the hero repeating itself. */}
            <p class="t-body mt-6 max-w-[56ch] text-[1.125rem]">
              Gentle LIRA peels spaced four to six weeks apart, and daily SPF with iron oxides to
              hold the result. Performed by Kiki, a California licensed esthetician with{' '}
              {business.experience} in corrective skin.
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
              <Button href={business.bookingUrl} external>{CTA_LABEL}</Button>
              <a
                href={business.phone.href}
                class="t-body border-b border-ink pb-1 hover:border-rose hover:text-rose"
              >
                {business.phone.display}
              </a>
            </div>
          </div>

          {/* The image runs to the edge of the content area, so the hero
              reads as a photograph of the work rather than a card floating
              beside the copy. */}
          <div>
            <Image
              src={melasmaHero}
              alt="Licensed esthetician performing a corrective facial treatment on melanin-rich skin at KIAMO Skin in Mission Hills, San Diego"
              widths={[640, 1280]}
              sizes="(min-width: 768px) 50vw, 100vw"
              loading="eager"
              class="aspect-4/3 w-full rounded-lg object-cover"
            />
          </div>
        </div>
      </div>
    </header>

    {/* The trust band. It sits directly below the hero as its own strip
        rather than inside it - the hero is the offer, and the claims are
        the reason to believe it. Keeping them apart is also what lets the
        hero fit the fold. */}
    <section class="bg-porcelain py-12 md:py-14">
      <div class="wrap">
        <TrustBar items={trust.claims} heading="Why this studio" />
        {/* A client's words, directly under the studio's own claims. The
            claims are the studio asserting things about itself; this is
            somebody else saying it, and it belongs high on the page. */}
        <div class="mt-10 border-t border-line pt-9 md:mt-12 md:pt-10">
          <ProofQuote testimonial={studioProof} />
        </div>
      </div>
    </section>

    <section class="bg-porcelain py-20 md:py-28">
      <div class="wrap grid items-center gap-12 md:grid-cols-[1fr_0.85fr] md:gap-20">
        <div>
          <Reveal>
            <p class="t-eyebrow text-ink-soft">The plan</p>
            <h2 class="t-h2 mt-4">We Treat Melasma in San Diego — Most Clients See Change After 3–4 Sessions</h2>
            <p class="t-body mt-6 leading-relaxed">
              Melasma appears as brown or grey-brown patches across the cheeks, forehead, nose
              bridge, and upper lip. Hormonal change triggers it, then UV and heat sustain it —
              which is why one strong session can make it worse.
            </p>
            <p class="t-body mt-5 leading-relaxed">
              So the work is in the pacing. Gentle first, correction layered on as the skin
              tolerates it, and the daily SPF that decides whether pigment stays faded.
            </p>
          </Reveal>
        </div>
        <Reveal>
          <Image
            src={melasmaResult}
            alt="Before and after melasma treatment at KIAMO Skin, showing pigment across the cheeks, forehead, and upper lip softened across four sessions"
            widths={[400, 800, 1200]}
            sizes="(min-width: 840px) 40vw, 90vw"
            loading="eager"
            class="aspect-[0.92] w-full rounded-lg object-cover"
          />
          <p class="t-meta mt-4">
            A published case, photographed with written consent. Results vary from person to person.
          </p>
        </Reveal>
      </div>
    </section>

    <section class="bg-ivory py-20 md:py-28">
      <div class="wrap">
        <div class="mx-auto max-w-[68ch]">
          <Reveal>
            <p class="t-eyebrow text-ink-soft">How the plan runs</p>
            <h2 class="t-h2 mt-4">Three Steps, in This Order</h2>
          </Reveal>
          <div class="mt-10 space-y-8">
            {
              melasmaSteps.map((step, i) => (
                <Reveal>
                  <div class="flex gap-5">
                    <span
                      class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-rose font-medium text-porcelain"
                      aria-hidden="true"
                    >
                      {i + 1}
                    </span>
                    <div>
                      <h3 class="t-service text-[1.0625rem]">{step.title}</h3>
                      <p class="t-body mt-3 text-[0.9375rem] leading-relaxed text-ink-soft">
                        {step.body}
                      </p>
                    </div>
                  </div>
                </Reveal>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="bg-porcelain py-20 md:py-28">
      <div class="wrap">
        <Reveal>
          <p class="t-eyebrow text-ink-soft">What it costs</p>
          <h2 class="t-h2 mt-4">The Treatments in a Melasma Plan</h2>
          <p class="t-body mt-6 max-w-[62ch] leading-relaxed">
            Melasma needs a series rather than a single session, so the plan is usually built
            across two or three of these. The sequence is set at consultation.
          </p>
        </Reveal>

        <ul class="m-0 mt-14 grid list-none gap-7 p-0 md:grid-cols-3 md:gap-6 lg:gap-8">
          {
            melasmaTreatments.map((treatment) => (
              <Reveal as="li">
                <div class="flex h-full flex-col rounded-lg bg-ivory p-8 lg:p-9">
                  <h3 class="t-service text-[1.125rem]">{treatment.name}</h3>
                  <p class="t-body mt-4 flex-1 leading-relaxed text-[0.9375rem] text-ink-soft">
                    {treatment.description}
                  </p>
                  <p class="t-price mt-6 text-rose">{treatment.price}</p>
                  <a
                    href={treatment.href}
                    class="t-button mt-5 inline-block border-b border-ink pb-1 hover:border-rose hover:text-rose"
                  >
                    Learn more
                  </a>
                </div>
              </Reveal>
            ))
          }
        </ul>

        <p class="t-body mt-12 max-w-[62ch] text-[0.9375rem]">
          Because the series is the point, many clients use the{' '}
          <a href="/membership/" class="border-b border-ink pb-0.5 hover:border-rose hover:text-rose">
            monthly facial membership
          </a>{' '}
          at $199 to keep the plan consistent and affordable. Membership treatments can be applied
          toward peels, microchanneling, or HydraFacials.
        </p>
      </div>
    </section>

    <section class="bg-ivory py-20 md:py-28">
      <div class="wrap">
        <div class="mx-auto max-w-[68ch]">
          <Reveal>
            <p class="t-eyebrow text-ink-soft">The San Diego problem</p>
            <h2 class="t-h2 mt-4">What Triggers Melasma in San Diego</h2>
            <p class="t-body mt-6 leading-relaxed">
              Melasma returns if the triggers are not managed, and San Diego has more of them than
              most cities. Here is what to watch for:
            </p>
            <ul class="t-body mt-6 space-y-2.5">
              {
                melasmaTriggers.map((trigger) => (
                  <li class="flex gap-3 leading-relaxed">
                    <span class="mt-1 text-rose" aria-hidden="true">
                      •
                    </span>
                    <span>{trigger}</span>
                  </li>
                ))
              }
            </ul>
            <p class="t-body mt-6 leading-relaxed">
              Daily broad-spectrum SPF 30 or higher is non-negotiable. Mineral sunscreens with
              iron oxides block both UV and visible light — and visible light is a trigger most
              people do not know about.
            </p>
          </Reveal>
        </div>
      </div>
    </section>

    {/* The proof. Quick answer for AI extraction, the published case, a client
        quote, and the risk reversal — all together, so a reader has met the
        studio before the questions and the booking form. */}
    <section class="bg-porcelain py-20 md:py-28">
      <div class="wrap">
        <div class="mx-auto max-w-[68ch]">
          <TreatmentProof slug="melasma" />
        </div>
      </div>
    </section>

    <section class="bg-ivory py-20 md:py-28">
      <div class="wrap">
        <div class="mx-auto max-w-[68ch]">
          <Reveal>
            <p class="t-eyebrow text-ink-soft">Common questions</p>
            <h2 class="t-h2 mt-4">Melasma Treatment Questions</h2>
          </Reveal>
          {/* Visible text, not accordions. These are SEO pages, and the
              studio's own booking FAQ block made this call for the same
              reason. The first four lead at full size because they are the
              ones that block a booking outright. */}
          <div class="mt-12">
            {
              melasmaFaqs.slice(0, 4).map((faq) => (
                <div class="border-b border-line py-7 first:pt-0">
                  <h3 class="t-service text-[1.0625rem] md:text-[1.1875rem]">{faq.question}</h3>
                  <p class="t-body mt-3 text-[0.9375rem]">{faq.answer}</p>
                </div>
              ))
            }
          </div>
          <div class="mt-12">
            <p class="t-eyebrow text-ink-soft">Also asked</p>
            <dl class="mt-6">
              {
                melasmaFaqs.slice(4).map((faq) => (
                  <div class="border-b border-line py-5 last:border-b-0">
                    <dt class="t-service text-[0.9375rem]">{faq.question}</dt>
                    <dd class="t-body mt-2 text-[0.9375rem] text-ink-soft">{faq.answer}</dd>
                  </div>
                ))
              }
            </dl>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-porcelain py-20 md:py-28">
      <div class="wrap">
        <div class="mx-auto max-w-[68ch] text-center">
          <Reveal>
            <h2 class="t-h2">Ready to Start Treating Your Melasma?</h2>
            <p class="t-body mx-auto mt-6 max-w-[58ch]">
              Every melasma plan starts with a consultation — your skin, your pigmentation depth,
              and your treatment history — then a plan paced for your skin tone and goals.
            </p>
            <div class="mt-9 flex flex-wrap items-center justify-center gap-x-8 gap-y-4">
              <Button href={business.bookingUrl} external>{CTA_LABEL}</Button>
              <a
                href={business.phone.href}
                class="t-body border-b border-ink pb-1 hover:border-rose hover:text-rose"
              >
                {business.phone.display}
              </a>
            </div>

            {/* Trust repeats. The band under the hero carries one quote;
                this is the second one, next to the booking form, so a reader
                who scrolls straight to the CTA still meets a client before
                they meet the button. */}
            <div class="mx-auto mt-10 max-w-[46ch] border-t border-line pt-9">
              <ProofQuote testimonial={studioProof} />
            </div>
          </Reveal>
        </div>
      </div>
    </section>

    <ServiceMenu />

    <section class="bg-porcelain py-16 md:py-20">
      <div class="wrap">
        <NapBlock />
      </div>
    </section>
  </article>
</BaseLayout>
